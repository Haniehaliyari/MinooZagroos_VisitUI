@page "/"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>مینو زاگرس</PageTitle>

<div class="root-redirect" dir="rtl">
    در حال انتقال به سامانه...
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var destination = authenticationState.User.Identity?.IsAuthenticated == true
            ? "/dashboard"
            : "/login";

        Navigation.NavigateTo(destination, replace: true);
    }
}