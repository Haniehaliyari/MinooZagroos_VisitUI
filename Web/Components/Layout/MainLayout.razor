@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="app-shell theme-@(selectedTheme) @(sidebarCollapsed ? "sidebar-collapsed" : "")" dir="@(english ? "ltr" : "rtl")">
    @if (sidebarOpen)
    {
        <button class="sidebar-backdrop" @onclick="CloseSidebar" aria-label="Close navigation"></button>
    }
    <aside class="app-sidebar @(sidebarOpen ? "sidebar-open" : "") @(sidebarCollapsed ? "sidebar-collapsed" : "")">
        <NavMenu English="english" SidebarCollapsed="sidebarCollapsed" OnNavigate="CloseSidebar" OnToggleSidebar="ToggleSidebar" OnLogout="Logout" />
    </aside>

    <main class="app-main">
        <header class="app-topbar">
            <div class="topbar-leading">
                <div class="topbar-title">
                </div>
            </div>
            <div class="topbar-actions">
                <div class="settings-wrap">
                    <button class="settings-button" @onclick="ToggleSettings" aria-label="@(english ? "General settings" : "تنظیمات عمومی")" aria-expanded="@settingsOpen">
                        <svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" /></svg>
                    </button>
                    @if (settingsOpen)
                    {
                        <section class="settings-popover">
                            <div class="settings-heading">
                                <div><strong>@(english ? "General settings" : "تنظیمات عمومی")</strong><small>@(english ? "Personalize your workspace" : "شخصی‌سازی فضای کاری")</small></div>
                                <button @onclick="ToggleSettings" aria-label="Close settings"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
                            </div>
                            <span class="settings-label">@(english ? "COLOR THEMES" : "انتخاب تم رنگی")</span>
                            <div class="theme-list">
                                <button class="theme-option @(selectedTheme == "ocean" ? "selected" : "")" @onclick='() => SetTheme("ocean")'>
                                    <span class="palette-preview ocean"><i></i><i></i><i></i><i></i></span>
                                    <span><b>@(english ? "Ocean blue" : "آبی اقیانوسی")</b><small>#1B365D · #005A9C</small></span>
                                    @if (selectedTheme == "ocean") { <svg class="theme-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg> }
                                </button>
                                <button class="theme-option @(selectedTheme == "sage" ? "selected" : "")" @onclick='() => SetTheme("sage")'>
                                    <span class="palette-preview sage"><i></i><i></i><i></i><i></i></span>
                                    <span><b>@(english ? "Sage & graphite" : "سبز مریم‌گلی و خاکستری")</b><small>#202734 · #36415A</small></span>
                                    @if (selectedTheme == "sage") { <svg class="theme-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg> }
                                </button>
                            </div>
                            <div class="settings-divider"></div>
                            <button class="settings-language" @onclick="ToggleLanguage"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18" /></svg>@(english ? "Switch to Persian" : "تغییر زبان به انگلیسی")</button>
                            <button class="settings-logout" @onclick="Logout"><svg viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M16 16l5-4-5-4M21 12H9" /></svg>@(english ? "Sign out" : "خروج از حساب کاربری")</button>
                        </section>
                    }
                </div>
                <div class="user-pill">
                    <button class="mobile-nav-trigger" @onclick="ToggleSidebar" aria-label="@(english ? "Open navigation" : "باز کردن منو")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h16" /></svg></button>
                </div>
            </div>
        </header>
        <CascadingValue Value="english">
            <CascadingValue Value="selectedTheme">
                <section class="page-content">@Body</section>
            </CascadingValue>
        </CascadingValue>
    </main>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private string username = "کاربر";
    private string selectedTheme = "ocean";
    private bool english;
    private bool sidebarOpen;
    private bool sidebarCollapsed;
    private bool settingsOpen;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            username = state.User.Identity?.Name ?? "کاربر";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            english = await JS.InvokeAsync<bool>("minooUi.getLanguage");
            selectedTheme = await JS.InvokeAsync<string>("minooUi.getColorTheme");
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private async Task ToggleLanguage()
    {
        english = !english;
        await JS.InvokeVoidAsync("minooUi.setLanguage", english ? "en" : "fa");
        settingsOpen = false;
    }

    private async Task SetTheme(string theme)
    {
        selectedTheme = theme;
        await JS.InvokeVoidAsync("minooUi.setColorTheme", theme);
    }

    private void ToggleSettings() => settingsOpen = !settingsOpen;
    private void ToggleSidebar()
    {
        if (sidebarOpen)
        {
            sidebarOpen = false;
            sidebarCollapsed = false;
            return;
        }

        sidebarCollapsed = !sidebarCollapsed;
        sidebarOpen = true;
    }
    private void CloseSidebar()
    {
        sidebarOpen = false;
        sidebarCollapsed = false;
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("authCookie.logout");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}