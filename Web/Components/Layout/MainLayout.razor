@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="app-shell @(darkMode ? "dark-mode" : "light-mode")" dir="@(english ? "ltr" : "rtl")">
    @if (sidebarOpen)
    {
        <button class="sidebar-backdrop" @onclick="CloseSidebar" aria-label="Close navigation"></button>
    }
    <aside class="app-sidebar @(sidebarOpen ? "sidebar-open" : "")">
        <div class="sidebar-mobile-head">
            <span>@(english ? "MAIN MENU" : "منوی اصلی")</span>
            <button class="sidebar-close" @onclick="CloseSidebar" aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
        </div>
        <NavMenu English="english" OnNavigate="CloseSidebar" />
        <div class="sidebar-foot"><span class="status-dot"></span>@(english ? "Systems operational" : "سامانه در دسترس است")</div>
    </aside>

    <main class="app-main">
        <header class="app-topbar">
            <div class="topbar-leading">
                <button class="mobile-menu-button" @onclick="ToggleSidebar" aria-label="Open navigation">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <div class="topbar-title">
                    <span class="topbar-kicker">MINOO ZAGROS / @(english ? "WORKSPACE" : "پنل سازمانی")</span>
                    <strong>@(english ? "Sales & Visit Management" : "مدیریت فروش و ویزیت")</strong>
                </div>
            </div>
            <div class="topbar-actions">
                <div class="settings-wrap">
                    <button class="settings-button" @onclick="ToggleSettings" aria-label="@(english ? "Settings" : "تنظیمات")" aria-expanded="@settingsOpen">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" /></svg>
                    </button>
                    @if (settingsOpen)
                    {
                        <section class="settings-popover">
                            <div class="settings-heading"><div><strong>@(english ? "Appearance & settings" : "تنظیمات و ظاهر")</strong><small>@(english ? "Personalize your workspace" : "شخصی‌سازی فضای کاری")</small></div><button @onclick="ToggleSettings" aria-label="Close settings"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg></button></div>
                            <span class="settings-label">@(english ? "COLOR MODE" : "حالت نمایش")</span>
                            <div class="theme-options">
                                <button class="theme-option @(darkMode ? "selected" : "")" @onclick="() => SetTheme(false)"><span class="theme-swatch light-swatch"></span><span>@(english ? "Light" : "روشن")</span></button>
                                <button class="theme-option @(!darkMode ? "selected" : "")" @onclick="() => SetTheme(true)"><span class="theme-swatch dark-swatch"></span><span>@(english ? "Dark" : "تیره")</span></button>
                            </div>
                            <div class="settings-note">@(english ? "Additional color palettes will be added here." : "پالت‌های رنگی اختصاصی در مرحله بعد به این بخش اضافه می‌شوند.")</div>
                            <div class="settings-divider"></div>
                            <button class="settings-language" @onclick="ToggleLanguage"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>@(english ? "Switch to Persian" : "تغییر زبان به انگلیسی")</button>
                        </section>
                    }
                </div>
                <div class="user-pill">
                    <span class="avatar"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M4.8 20c.7-3.6 3.2-5.5 7.2-5.5s6.5 1.9 7.2 5.5" /></svg></span>
                    <span class="user-details"><small>@(english ? "SIGNED IN AS" : "کاربر واردشده")</small><strong>@username</strong></span>
                </div>
                <button class="logout-button" @onclick="Logout">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M16 16l5-4-5-4M21 12H9" /></svg>
                    <span>@(english ? "Sign out" : "خروج")</span>
                </button>
            </div>
        </header>
        <CascadingValue Value="english">
            <CascadingValue Value="darkMode">
                <section class="page-content">@Body</section>
            </CascadingValue>
        </CascadingValue>
    </main>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private string username = "کاربر";
    private bool english;
    private bool darkMode = true;
    private bool sidebarOpen;
    private bool settingsOpen;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            username = state.User.Identity?.Name ?? "کاربر";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            english = await JS.InvokeAsync<bool>("minooUi.getLanguage");
            darkMode = await JS.InvokeAsync<bool>("minooUi.getTheme");
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private async Task ToggleLanguage()
    {
        english = !english;
        await JS.InvokeVoidAsync("minooUi.setLanguage", english ? "en" : "fa");
        settingsOpen = false;
    }

    private async Task SetTheme(bool useDark)
    {
        darkMode = useDark;
        await JS.InvokeVoidAsync("minooUi.setTheme", darkMode ? "dark" : "light");
    }

    private void ToggleSettings() => settingsOpen = !settingsOpen;
    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    private void CloseSidebar() => sidebarOpen = false;

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("authCookie.logout");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}