@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="app-shell @(darkMode ? "dark-mode" : "light-mode")" dir="@(english ? "ltr" : "rtl")">
    <aside class="app-sidebar">
        <NavMenu English="english" />
        <div class="sidebar-foot"><span class="status-dot"></span>@(english ? "Systems operational" : "سامانه در دسترس است")</div>
    </aside>
    <main class="app-main">
        <header class="app-topbar">
            <div class="topbar-title"><span class="topbar-kicker">MINOO ZAGROS / @(english ? "WORKSPACE" : "پنل سازمانی")</span><strong>@(english ? "Sales & Visit Management" : "مدیریت فروش و ویزیت")</strong></div>
            <div class="topbar-actions">
                <button class="utility-button" @onclick="ToggleLanguage" aria-label="Change language">@(english ? "فا" : "EN") <span>@(english ? "فارسی" : "English")</span></button>
                <button class="utility-button icon-button" @onclick="ToggleTheme" aria-label="Toggle theme">@(darkMode ? "☀" : "☾")</button>
                <div class="user-pill"><span class="avatar">@(username.Length > 0 ? username[..1] : "م")</span><span>@username</span></div>
                <button class="logout-button" @onclick="Logout">↪ <span>@(english ? "Sign out" : "خروج")</span></button>
            </div>
        </header>
        <CascadingValue Value="english">
            <CascadingValue Value="darkMode">
                <section class="page-content">@Body</section>
            </CascadingValue>
        </CascadingValue>
    </main>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private string username = "کاربر";
    private bool english;
    private bool darkMode = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            username = state.User.Identity?.Name ?? "کاربر";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            english = await JS.InvokeAsync<bool>("minooUi.getLanguage");
            darkMode = await JS.InvokeAsync<bool>("minooUi.getTheme");
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private async Task ToggleLanguage()
    {
        english = !english;
        await JS.InvokeVoidAsync("minooUi.setLanguage", english ? "en" : "fa");
    }

    private async Task ToggleTheme()
    {
        darkMode = !darkMode;
        await JS.InvokeVoidAsync("minooUi.setTheme", darkMode ? "dark" : "light");
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("authCookie.logout");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}