@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="app-shell theme-@(selectedTheme) @(isDark ? "theme-dark" : "theme-light") @(sidebarCollapsed ? "sidebar-collapsed" : "")" style="@ThemeVariables" dir="rtl">
    @if (sidebarOpen)
    {
        <button class="sidebar-backdrop" @onclick="CloseSidebar" aria-label="بستن منو"></button>
    }
    <aside class="app-sidebar @(sidebarOpen ? "sidebar-open" : "") @(sidebarCollapsed ? "sidebar-collapsed" : "")">
        <NavMenu SidebarCollapsed="sidebarCollapsed" OnNavigate="CloseSidebar" OnToggleSidebar="ToggleSidebar" OnLogout="Logout" />
    </aside>
    <main class="app-main">
        <header class="app-topbar">
            @if (settingsOpen)
            {
                <button class="settings-backdrop" @onclick="CloseSettings" aria-label="بستن تنظیمات"></button>
            }
            <div class="topbar-leading">
                <button class="page-back-button" @onclick="GoBack" title="بازگشت به صفحه قبل" aria-label="بازگشت به صفحه قبل">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6M9 12h12" /></svg>
                </button>
                <div class="settings-wrap">
                    <button class="settings-button" @onclick="ToggleSettings" aria-label="تنظیمات عمومی" aria-expanded="@settingsOpen">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4" /><path d="M5.5 20c.5-3.5 3-5.5 6.5-5.5s6 2 6.5 5.5" /></svg>
                    </button>
                    @if (settingsOpen)
                    {
                        <section class="settings-popover">
                            <div class="settings-heading">
                                <div><strong>تنظیمات عمومی</strong><small>شخصی‌سازی فضای کاری</small></div>
                                <button @onclick="ToggleSettings" aria-label="بستن تنظیمات"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
                            </div>
                            <span class="settings-label">انتخاب تم رنگی</span>
                            <div class="theme-list">
                                <button class="theme-option @(selectedTheme == "ocean" ? "selected" : "")" @onclick='() => SetTheme("ocean")'>
                                    <span class="palette-preview ocean"><i></i><i></i><i></i><i></i></span>
                                    <span><b>آبی </b></span>
                                    @if (selectedTheme == "ocean") { <svg class="theme-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg> }
                                </button>
                                <button class="theme-option @(selectedTheme == "sage" ? "selected" : "")" @onclick='() => SetTheme("sage")'>
                                    <span class="palette-preview sage"><i></i><i></i><i></i><i></i></span>
                                    <span><b>سبز</b></span>
                                    @if (selectedTheme == "sage") { <svg class="theme-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg> }
                                </button>
                            </div>
                            <div class="settings-divider"></div>
                            <button class="settings-appearance" @onclick="ToggleAppearance" aria-label="@(isDark ? "فعال‌کردن حالت روشن" : "فعال‌کردن حالت تاریک")" title="@(isDark ? "حالت روشن" : "حالت تاریک")">
                                @if (isDark)
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4m0-12.8L17 7M7 17l-1.4 1.4"/><circle cx="12" cy="12" r="4"/></svg>
                                }
                            </button>
                            <button class="settings-logout" @onclick="Logout"><svg viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M16 16l5-4-5-4M21 12H9" /></svg>خروج از حساب کاربری</button>
                        </section>
                    }
                </div>
            </div>
            <div class="topbar-actions">
                <div class="user-pill">
                    <button class="mobile-nav-trigger" @onclick="ToggleSidebar" aria-label="باز کردن منو"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h16" /></svg></button>
                </div>
            </div>
        </header>
        <CascadingValue Value="false">
            <CascadingValue Value="selectedTheme">
                <section class="page-content">@Body</section>
            </CascadingValue>
        </CascadingValue>
    </main>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private string username = "کاربر";
    private string selectedTheme = "ocean";
    private bool isDark;
    private bool sidebarOpen;
    private bool sidebarCollapsed;
    private bool settingsOpen;

    private string ThemeVariables => isDark
        ? (selectedTheme == "sage"
            ? "--palette-1:#202734;--palette-2:#36415A;--palette-3:#B7D894;--palette-4:#E0F8C7;--surface:#1b2532;--surface-soft:#121b26;--text:#edf3e8;--muted:#aab5a2;--line:rgba(224,248,199,.16);--accent:#b7d894;--accent-soft:#536b43;--sidebar-a:#111923;--sidebar-b:#293a32;"
            : "--palette-1:#1B365D;--palette-2:#005A9C;--palette-3:#60C1E5;--palette-4:#A0E0EF;--surface:#172536;--surface-soft:#101b29;--text:#eaf2fa;--muted:#a6b8ca;--line:rgba(160,224,239,.16);--accent:#75c9ee;--accent-soft:#27658a;--sidebar-a:#101b2a;--sidebar-b:#164a70;")
        : (selectedTheme == "sage"
            ? "--palette-1:#202734;--palette-2:#36415A;--palette-3:#B7D894;--palette-4:#E0F8C7;--surface:#ffffff;--surface-soft:#f4f9ed;--text:#202734;--muted:#687487;--line:rgba(32,39,52,.16);--accent:#36415A;--accent-soft:#B7D894;--sidebar-a:#202734;--sidebar-b:#36415A;"
            : "--palette-1:#1B365D;--palette-2:#005A9C;--palette-3:#60C1E5;--palette-4:#A0E0EF;--surface:#ffffff;--surface-soft:#f2f9fc;--text:#1B365D;--muted:#64788d;--line:rgba(27,54,93,.16);--accent:#005A9C;--accent-soft:#60C1E5;--sidebar-a:#1B365D;--sidebar-b:#005A9C;");

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            username = state.User.Identity?.Name ?? "کاربر";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            isDark = await JS.InvokeAsync<bool>("authCookie.getTheme");
            selectedTheme = await JS.InvokeAsync<string>("minooUi.getColorTheme");
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private async Task ToggleAppearance()
    {
        isDark = !isDark;
        await JS.InvokeVoidAsync("authCookie.setTheme", isDark ? "dark" : "light");
        settingsOpen = false;
    }

    private async Task SetTheme(string theme)
    {
        selectedTheme = theme;
        await JS.InvokeVoidAsync("minooUi.setColorTheme", theme);
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");
    private void ToggleSettings() => settingsOpen = !settingsOpen;
    private void CloseSettings() => settingsOpen = false;

    private void ToggleSidebar()
    {
        if (sidebarOpen) { sidebarOpen = false; sidebarCollapsed = false; return; }
        sidebarCollapsed = !sidebarCollapsed;
        sidebarOpen = true;
    }

    private void CloseSidebar() { sidebarOpen = false; sidebarCollapsed = false; }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("authCookie.logout");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}