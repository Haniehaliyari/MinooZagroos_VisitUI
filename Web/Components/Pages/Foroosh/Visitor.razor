@page "/foroosh/visitor"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient

<PageTitle>مدیریت ویزیتورها | مینو زاگرس</PageTitle>
<div class="visitor-page" dir="rtl">
    <header class="visitor-heading">
        <div><div class="visitor-eyebrow">مدیریت ارتباط با مشتریان</div><h1>مدیریت ویزیتورها</h1></div>
        <div class="hero-3d-art" aria-hidden="true"><span class="hero-orbit hero-orbit-one"></span><span class="hero-orbit hero-orbit-two"></span><span class="hero-core"><i></i><b></b></span><span class="hero-spark hero-spark-one"></span><span class="hero-spark hero-spark-two"></span></div>
    </header>
    <section class="visitor-panel">
        <div class="visitor-toolbar">
            <div class="visitor-search-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input class="visitor-search" placeholder="جستجو نام، نام خانوادگی، کد ملی، موبایل..." @bind="searchText" @bind:event="oninput" /></div>
            <div class="visitor-toolbar-actions"><span class="visitor-count">@FilteredItems.Count ویزیتور</span><button type="button" class="visitor-button visitor-button-light" @onclick="LoadAllAsync" disabled="@loading"><svg class="visitor-inline-icon" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M5.6 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.4-3"/></svg></button><button type="button" class="visitor-button visitor-button-primary" @onclick="OpenCreate"><svg class="visitor-inline-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(loadError)) { <div class="visitor-inline-error">@loadError</div> }
        @if (loading) { <div class="visitor-empty"><span class="visitor-spinner"></span><strong>در حال دریافت فهرست ویزیتورها...</strong></div> }
        else if (items.Count == 0) { <div class="visitor-empty"><strong>هنوز ویزیتوری ثبت نشده است</strong><span>برای شروع، اولین ویزیتور را اضافه کنید.</span><button class="visitor-button visitor-button-primary" @onclick="OpenCreate"></button></div> }
        else if (FilteredItems.Count == 0) { <div class="visitor-empty"><strong>نتیجه‌ای پیدا نشد</strong><span>عبارت جستجو را تغییر دهید.</span></div> }
        else {
        <div class="visitor-table-wrap"><table class="visitor-table">
            <thead><tr><th>ردیف</th><th>نام و نام خانوادگی</th><th>نام پدر</th><th>وضعیت</th><th>تاریخ عضویت</th><th>موبایل</th><th>کد ملی</th><th>مسیر ویزیت</th><th>ویزیت دیجیتال</th><th>نام کارمند</th><th>دفتر فروش</th><th>نوع ویزیتور</th><th>واحد تجاری</th><th>عملیات</th></tr></thead>
            <tbody>@foreach (var item in FilteredItems) {
                <tr @key="item.VisitorSN"><td class="visitor-row-number">@((FilteredItems.IndexOf(item)+1).ToString("00"))</td>
                <td><strong class="visitor-person-name">@Display(item.Name) @Display(item.Family)</strong><small class="visitor-subline">کد : @Display(item.VisitorNo)</small></td><td>@Display(item.Father)</td>
                <td><span class="visitor-status @(item.Status == 1 ? "active" : "inactive")"><i></i>@(item.Status == 1 ? "فعال" : "غیرفعال")</span></td>
                <td>@DisplayJalaliDate(item.OzviyatDate)</td><td>@Display(item.MblPhone)</td><td>@Display(item.MeliNo)</td>
                <td><span class="visitor-status @(item.IsMasirVisit ? "active" : "inactive")"><i></i>@(item.IsMasirVisit ? "فعال" : "غیرفعال")</span></td>
                <td><span class="visitor-status @(item.IsVisitDigita ? "active" : "inactive")"><i></i>@(item.IsVisitDigita ? "فعال" : "غیرفعال")</span></td>
                <td>@Display(item.KarmandDs)</td><td>@DaftarDisplay(item)</td><td>@VisitorTypeDisplay(item)</td><td>@Display(item.VahedeTejariDs)</td>
                <td><div class="visitor-row-actions"><button type="button" class="visitor-row-action edit" title="ویرایش" aria-label="ویرایش" @onclick="() => OpenEdit(item)"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="m16.5 3.5 4 4L8 20l-4 1 1-4Z"/></svg></button><button type="button" class="visitor-row-action delete" title="حذف" aria-label="حذف" @onclick="() => AskDelete(item)"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m5 5v5m4-5v5"/></svg></button></div></td></tr>
            }</tbody>
        </table></div><div class="visitor-table-footer">نمایش @FilteredItems.Count از @items.Count ویزیتور</div>
        }
    </section>
</div>

@if (showEditor) {
<div class="visitor-modal-backdrop" @onclick="CloseEditor"><section class="visitor-modal" role="dialog" aria-modal="true" aria-labelledby="visitor-modal-title" @onclick:stopPropagation="true" dir="rtl">
<header class="visitor-modal-header"><div class="visitor-modal-title-icon"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8m9-1v6m-3-3h6"/></svg></div><div><span class="visitor-modal-eyebrow">اطلاعات فردی و سازمانی</span><h2 id="visitor-modal-title">@(isEdit ? "ویرایش ویزیتور" : "ثبت ویزیتور جدید")</h2><p>فیلدهای موردنیاز را تکمیل کنید؛ تاریخ عضویت به‌صورت خودکار امروز تنظیم شده است.</p></div></header>
@if (!string.IsNullOrWhiteSpace(editorError)) { <div class="visitor-inline-error visitor-modal-error">@editorError</div> }
<div class="visitor-form-grid">
<label class="visitor-field"><span>نام <b>*</b></span><input @bind="form.Name" maxlength="100" placeholder="نام" /></label>
<label class="visitor-field"><span>نام خانوادگی <b>*</b></span><input @bind="form.Family" maxlength="150" placeholder="نام خانوادگی" /></label>
<label class="visitor-field"><span>نام پدر <b>*</b></span><input @bind="form.Father" maxlength="100" placeholder="نام پدر" /></label>
<div class="visitor-field"><span>وضعیت <b>*</b></span><button type="button" class="visitor-switch-row" role="switch" aria-checked="@(form.Status == 1)" @onclick="ToggleStatus"><span class="visitor-switch @(form.Status == 1 ? "on" : "")"><i></i></span><strong>@(form.Status == 1 ? "فعال" : "غیرفعال")</strong></button></div>
<label class="visitor-field"><span>تاریخ عضویت <b>*</b></span><input type="text" inputmode="numeric" dir="ltr" placeholder="۱۴۰۵/۰۱/۰۱" @bind="form.OzviyatDateText" /></label>
<label class="visitor-field"><span>موبایل</span><input @bind="form.MblPhone" maxlength="20" inputmode="tel" placeholder="شماره موبایل" /></label>
<label class="visitor-field"><span>کد ملی</span><input @bind="form.MeliNo" maxlength="20" inputmode="numeric" placeholder="کد ملی" /></label>
<div class="visitor-field"><span>مسیر ویزیت</span><button type="button" class="visitor-switch-row" role="switch" aria-checked="@form.IsMasirVisit" @onclick="() => form.IsMasirVisit = !form.IsMasirVisit"><span class="visitor-switch @(form.IsMasirVisit ? "on" : "")"><i></i></span><strong>@(form.IsMasirVisit ? "فعال" : "غیرفعال")</strong></button></div>
<div class="visitor-field"><span>ویزیت دیجیتال</span><button type="button" class="visitor-switch-row" role="switch" aria-checked="@form.IsVisitDigita" @onclick="() => form.IsVisitDigita = !form.IsVisitDigita"><span class="visitor-switch @(form.IsVisitDigita ? "on" : "")"><i></i></span><strong>@(form.IsVisitDigita ? "فعال" : "غیرفعال")</strong></button></div>
<div class="visitor-field lookup-field"><span>نام کارمند</span><input value="@karmandSearch" @oninput="e => OnLookupInput(e, 0)" @onfocus="() => showKarmandOptions = true" @onblur="() => CloseLookupAsync(0)" autocomplete="off" placeholder="جستجو و انتخاب کارمند" />
@if (showKarmandOptions) { <div class="visitor-options">@foreach (var o in FilterLookup(karmands,karmandSearch)) { <button type="button" @onmousedown:preventDefault @onclick="() => SelectLookup(o,0)">@o.Title</button> } @if (FilterLookup(karmands,karmandSearch).Count==0) { <div class="visitor-option-empty">موردی یافت نشد</div> }</div> }</div>
<div class="visitor-field lookup-field"><span>دفتر فروش</span><input value="@daftarSearch" @oninput="e => OnLookupInput(e, 1)" @onfocus="() => showDaftarOptions = true" @onblur="() => CloseLookupAsync(1)" autocomplete="off" placeholder="جستجو و انتخاب دفتر فروش" />
@if (showDaftarOptions) { <div class="visitor-options">@foreach (var o in FilterLookup(daftars,daftarSearch)) { <button type="button" @onmousedown:preventDefault @onclick="() => SelectLookup(o,1)">@o.Title</button> } @if (FilterLookup(daftars,daftarSearch).Count==0) { <div class="visitor-option-empty">موردی یافت نشد</div> }</div> }</div>
<div class="visitor-field lookup-field"><span>نوع ویزیتور <b>*</b></span><input value="@noeVisitorSearch" @oninput="e => OnLookupInput(e, 2)" @onfocus="() => showNoeVisitorOptions = true" @onblur="() => CloseLookupAsync(2)" autocomplete="off" placeholder="جستجو و انتخاب نوع ویزیتور" />
@if (showNoeVisitorOptions) { <div class="visitor-options">@foreach (var o in FilterLookup(noeVisitors,noeVisitorSearch)) { <button type="button" @onmousedown:preventDefault @onclick="() => SelectLookup(o,2)">@o.Title</button> } @if (FilterLookup(noeVisitors,noeVisitorSearch).Count==0) { <div class="visitor-option-empty">موردی یافت نشد</div> }</div> }</div>
</div>
<footer class="visitor-modal-footer"><button type="button" class="visitor-button visitor-button-light" @onclick="CloseEditor" disabled="@saving">انصراف</button><button type="button" class="visitor-button visitor-button-primary" @onclick="SaveAsync" disabled="@saving">@(saving ? "در حال ذخیره..." : isEdit ? "ذخیره تغییرات" : "ثبت ویزیتور")</button></footer>
</section></div>
}
@if (pendingDelete is not null) { <div class="visitor-modal-backdrop" @onclick="CancelDelete"><section class="visitor-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl"><div class="visitor-confirm-icon">!</div><h2>حذف ویزیتور</h2><p>آیا از حذف «<strong>@pendingDelete.Name @pendingDelete.Family</strong>» مطمئن هستید؟</p>@if (!string.IsNullOrWhiteSpace(deleteError)) { <div class="visitor-inline-error">@deleteError</div> }<footer class="visitor-modal-footer"><button class="visitor-button visitor-button-light" @onclick="CancelDelete" disabled="@deleting">انصراف</button><button class="visitor-button visitor-button-danger" @onclick="DeleteAsync" disabled="@deleting">@(deleting ? "در حال حذف..." : "بله، حذف شود")</button></footer></section></div> }
@if (showSuccessModal) { <div class="visitor-modal-backdrop visitor-success-backdrop"><section class="visitor-confirm-modal visitor-success-modal" role="dialog" aria-modal="true" aria-labelledby="visitor-success-title" dir="rtl"><div class="visitor-success-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg></div><h2 id="visitor-success-title">عملیات با موفقیت انجام شد</h2><p>@successMessage</p><footer class="visitor-modal-footer"><button type="button" class="visitor-button visitor-button-primary" @onclick="ConfirmSuccessAndReload">تأیید</button></footer></section></div> }

\n<style>\n    .visitor-success-backdrop{z-index:1200;align-items:center;justify-content:center;}\n    .visitor-success-modal{text-align:center;}\n    .visitor-success-modal h2{margin:12px 0 8px;}\n    .visitor-success-modal p{line-height:1.9;margin:0 0 18px;}\n    .visitor-success-modal .visitor-modal-footer{justify-content:center;}\n    .visitor-success-icon{display:grid;place-items:center;width:58px;height:58px;margin:0 auto;border-radius:50%;background:#e7f7ed;color:#16834a;}\n    .visitor-success-icon svg{display:block;width:31px;height:31px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}\n</style>\n\n@code {
    private const string AllEndpoint = "api/v1/Visitor/GetAllVisitor";
    private const string CreateEndpoint = "api/v1/Visitor/CreateVisitor";
    private const string UpdateEndpoint = "api/v1/Visitor/UpdateVisitor";
    private const string DeleteEndpoint = "api/v1/Visitor/DeleteVisitor";
    private const string KarmandEndpoint = "api/v1/Karmand/GetKarmandByCombo";
    private const string DaftarEndpoint = "api/v1/Daftarforoosh/GetDaftarforooshByCombo";
    private const string NoeVisitorEndpoint = "api/v1/NoeVisitor/GetNoeVisitorByCombo";
    private readonly List<VisitorItem> items = [];
    private readonly List<LookupItem> karmands = [], daftars = [], noeVisitors = [];
    private VisitorForm form = new();
    private VisitorItem? pendingDelete;
    private string searchText = "", karmandSearch = "", daftarSearch = "", noeVisitorSearch = "";
    private string? loadError, editorError, deleteError;
    private bool loading, showEditor, isEdit, saving, deleting, showKarmandOptions, showDaftarOptions, showNoeVisitorOptions, showSuccessModal;
    private string successMessage = "";
    private decimal editingSN;
    private string editingVisitorNo = "";
    private List<VisitorItem> FilteredItems => items.Where(x => string.IsNullOrWhiteSpace(searchText) || new[] {x.Name,x.Family,x.VisitorNo,x.Father,x.MeliNo,x.MblPhone,x.KarmandDs,x.DaftarForooshDs,x.NoeVisitorDs,x.VahedeTejariDs}.Any(v => Contains(v,searchText))).OrderBy(x => x.Name).ThenBy(x => x.Family).ToList();

    protected override async Task OnInitializedAsync() => await Task.WhenAll(LoadAllAsync(), LoadCombosAsync());

    private async Task LoadAllAsync() {
        loading = true; loadError = null;
        try { using var c = await ApiClient.CreateAuthorizedClientAsync(); using var r = await c.GetAsync(AllEndpoint); var j = await r.Content.ReadAsStringAsync(); EnsureSuccess(r,j); items.Clear(); items.AddRange(ReadArray(ExtractPayload(j)).Select(ReadVisitor).Where(x => x.VisitorSN != 0)); }
        catch(Exception ex) { loadError = ex.Message; } finally { loading = false; }
    }
    private async Task LoadCombosAsync() {
        using var c = await ApiClient.CreateAuthorizedClientAsync();
        var tasks = new[] { ReadLookupAsync(c,KarmandEndpoint,"کارمند"), ReadLookupAsync(c,DaftarEndpoint,"دفتر فروش"), ReadLookupAsync(c,NoeVisitorEndpoint,"نوع ویزیتور") };
        var results = await Task.WhenAll(tasks); karmands.Clear(); karmands.AddRange(results[0]); daftars.Clear(); daftars.AddRange(results[1]); noeVisitors.Clear(); noeVisitors.AddRange(results[2]);
    }
    private static async Task<List<LookupItem>> ReadLookupAsync(HttpClient c,string endpoint,string name) {
        try { using var r=await c.GetAsync(endpoint); var j=await r.Content.ReadAsStringAsync(); EnsureSuccess(r,j); return ReadArray(ExtractPayload(j)).Select(x=>new LookupItem { Id=ReadDecimal(x,"Id","SN","KarmandSN","KarmandId","DaftarForooshSN","DaftarSN","NoeVisitorSN","NoeVisitorId"), Title=ReadString(x,"Title","Name","DS","KarmandDs","KarmandDS","KarmandName","KarmandTitle","KarmandFullName","DaftarForooshDs","DaftarForooshDS","DaftarForooshName","DaftarForooshTitle","DaftarForooshFullName","NoeVisitorTitle","NoeVisitorName","NoeVisitorDS","NoeVisitorDs","NoeVisitorType","NoeVisitorDesc") }).Where(x=>x.Id!=0 && !string.IsNullOrWhiteSpace(x.Title)).ToList(); } catch { return []; }
    }
    private void OpenCreate() { isEdit=false; editingSN=0; editingVisitorNo=""; editorError=null; form=new VisitorForm { Status=1, OzviyatDate=DateTime.Today, OzviyatDateText=ToPersianDate(DateTime.Today) }; ResetLookupText(); showEditor=true; }
    private void OpenEdit(VisitorItem x) {
        isEdit=true; editingSN=x.VisitorSN; editingVisitorNo=x.VisitorNo; editorError=null;
        var memberDate=ToDateValue(x.OzviyatDate);
        form=new VisitorForm { Name=x.Name, Family=x.Family, Father=x.Father, Status=x.Status, OzviyatDate=memberDate, OzviyatDateText=ToPersianDate(memberDate??DateTime.Today), MblPhone=x.MblPhone, MeliNo=x.MeliNo, IsMasirVisit=x.IsMasirVisit, IsVisitDigita=x.IsVisitDigita, KarmandSN=x.KarmandSN, DaftarForooshSN=x.DaftarForooshSN, NoeVisitorSN=x.NoeVisitorSN };
        karmandSearch=FindTitle(karmands,form.KarmandSN)??x.KarmandDs; daftarSearch=FindTitle(daftars,form.DaftarForooshSN)??x.DaftarForooshDs; noeVisitorSearch=FindTitle(noeVisitors,form.NoeVisitorSN)??x.NoeVisitorDs;
        showKarmandOptions=showDaftarOptions=showNoeVisitorOptions=false; showEditor=true;
    }
    private void ResetLookupText(){karmandSearch=daftarSearch=noeVisitorSearch="";showKarmandOptions=showDaftarOptions=showNoeVisitorOptions=false;}
    private async Task SaveAsync() {
        editorError=null; form.Name=form.Name.Trim(); form.Family=form.Family.Trim();
        if(form.Name=="" || form.Family=="" || string.IsNullOrWhiteSpace(form.Father)){editorError="نام، نام خانوادگی و نام پدر الزامی هستند.";return;}
        if(!form.NoeVisitorSN.HasValue){editorError="نوع ویزیتور را انتخاب کنید.";return;}
        if(!TryParsePersianDate(form.OzviyatDateText,out var date)){editorError="تاریخ عضویت را به‌صورت شمسی و با قالب ۱۴۰۵/۰۱/۰۱ وارد کنید.";return;}
        form.OzviyatDate=date;
        saving=true; await InvokeAsync(StateHasChanged);
        try {
            var membershipDate=ToPersianDate(date).Replace("/", "");
            object payload = new {
                VisitorSN = editingSN,
                VisitorNo = isEdit ? editingVisitorNo : "0",
                Name = form.Name,
                Family = form.Family,
                Father = form.Father.Trim(),
                IDNo = "0",
                Status = form.Status,
                OzviyatDate = membershipDate,
                MblPhone = NullIfEmpty(form.MblPhone),
                MeliNo = NullIfEmpty(form.MeliNo),
                IsMasirVisit = form.IsMasirVisit,
                IsVisitDigital = form.IsVisitDigita,
                KarmandSN = form.KarmandSN,
                DaftarForooshSN = form.DaftarForooshSN,
                NoeVisitorSN = form.NoeVisitorSN
            };
            using var c=await ApiClient.CreateAuthorizedClientAsync(); using var r=await c.PostAsJsonAsync(isEdit?UpdateEndpoint:CreateEndpoint,payload); var j=await r.Content.ReadAsStringAsync(); EnsureSuccess(r,j);
            var savedVisitorName=$"{form.Name} {form.Family}".Trim(); showEditor=false; successMessage=isEdit?$"ویزیتور «{savedVisitorName}» با موفقیت ویرایش شد.":$"ویزیتور «{savedVisitorName}» با موفقیت ایجاد شد."; showSuccessModal=true;
        } catch(Exception ex){editorError=ex.Message;} finally{saving=false;}
    }
    private async Task DeleteAsync() {
        if(pendingDelete is null)return; deleting=true; deleteError=null;
        try { var deletedVisitorName=$"{pendingDelete.Name} {pendingDelete.Family}".Trim(); using var c=await ApiClient.CreateAuthorizedClientAsync(); var url=$"{DeleteEndpoint}?VisitorSN={Uri.EscapeDataString(pendingDelete.VisitorSN.ToString(CultureInfo.InvariantCulture))}"; using var r=await c.PostAsync(url,null); var j=await r.Content.ReadAsStringAsync(); EnsureSuccess(r,j); successMessage=$"ویزیتور «{deletedVisitorName}» با موفقیت حذف شد."; pendingDelete=null; showSuccessModal=true; }
        catch(Exception ex){deleteError=ex.Message;} finally{deleting=false;}
    }
    private async Task ConfirmSuccessAndReload(){showSuccessModal=false;successMessage="";searchText="";await LoadAllAsync();}
    private void AskDelete(VisitorItem x){pendingDelete=x;deleteError=null;} private void CancelDelete(){if(!deleting)pendingDelete=null;} private void CloseEditor(){if(!saving)showEditor=false;}
    private void ToggleStatus()=>form.Status=form.Status==1?(byte)0:(byte)1;
    private void OnLookupInput(ChangeEventArgs e,int kind){var v=e.Value?.ToString()??"";if(kind==0){karmandSearch=v;form.KarmandSN=null;showKarmandOptions=true;}else if(kind==1){daftarSearch=v;form.DaftarForooshSN=null;showDaftarOptions=true;}else{noeVisitorSearch=v;form.NoeVisitorSN=null;showNoeVisitorOptions=true;}}
    private void SelectLookup(LookupItem x,int kind){if(kind==0){form.KarmandSN=x.Id;karmandSearch=x.Title;showKarmandOptions=false;}else if(kind==1){form.DaftarForooshSN=x.Id;daftarSearch=x.Title;showDaftarOptions=false;}else{form.NoeVisitorSN=x.Id;noeVisitorSearch=x.Title;showNoeVisitorOptions=false;}}
    private async Task CloseLookupAsync(int kind){await Task.Delay(180);if(kind==0)showKarmandOptions=false;else if(kind==1)showDaftarOptions=false;else showNoeVisitorOptions=false;await InvokeAsync(StateHasChanged);}
    private static List<LookupItem> FilterLookup(List<LookupItem> xs,string q)=>xs.Where(x=>string.IsNullOrWhiteSpace(q)||Contains(x.Title,q)).ToList();
    private static string? FindTitle(List<LookupItem> xs,decimal? id)=>id.HasValue?xs.FirstOrDefault(x=>x.Id==id)?.Title:null;
    private string VisitorTypeDisplay(VisitorItem item){if(!string.IsNullOrWhiteSpace(item.NoeVisitorDs))return item.NoeVisitorDs;return FindTitle(noeVisitors,item.NoeVisitorSN)??"—";}
    private string DaftarDisplay(VisitorItem item){if(!string.IsNullOrWhiteSpace(item.DaftarForooshDs))return item.DaftarForooshDs;return FindTitle(daftars,item.DaftarForooshSN)??"—";}
    private static string? NullIfEmpty(string? x)=>string.IsNullOrWhiteSpace(x)?null:x.Trim();
    private static string Display(string? x)=>string.IsNullOrWhiteSpace(x)?"—":x.Trim();
    private static bool Contains(string? a,string b)=>Normalize(a).Contains(Normalize(b),StringComparison.OrdinalIgnoreCase);
    private static string Normalize(string? s)=>(s??"").Trim().Replace('۰','0').Replace('۱','1').Replace('۲','2').Replace('۳','3').Replace('۴','4').Replace('۵','5').Replace('۶','6').Replace('۷','7').Replace('۸','8').Replace('۹','9').Replace('٠','0').Replace('١','1').Replace('٢','2').Replace('٣','3').Replace('٤','4').Replace('٥','5').Replace('٦','6').Replace('٧','7').Replace('٨','8').Replace('٩','9');
    private static readonly PersianCalendar PersianCalendar = new();
    private static DateTime? ToDateValue(string s){if(DateTime.TryParse(s,CultureInfo.InvariantCulture,DateTimeStyles.AssumeLocal,out var d))return d.Date;if(DateTime.TryParse(s,CultureInfo.CurrentCulture,DateTimeStyles.AssumeLocal,out d))return d.Date;return null;}
    private static string ToPersianDate(DateTime? value){if(!value.HasValue)return "";var d=value.Value;return $"{PersianCalendar.GetYear(d):0000}/{PersianCalendar.GetMonth(d):00}/{PersianCalendar.GetDayOfMonth(d):00}";}
    private static bool TryParsePersianDate(string? value,out DateTime date){
        date=default;
        var normalized=Normalize(value).Trim();
        string[] parts;
        if(normalized.Length==8 && normalized.All(char.IsDigit))
            parts=[normalized[..4],normalized.Substring(4,2),normalized.Substring(6,2)];
        else
            parts=normalized.Split('/', '-', '.');
