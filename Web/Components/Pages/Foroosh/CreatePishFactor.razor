@page "/foroosh/create-pishfactor"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient

<PageTitle>ایجاد پیش‌فاکتور | مینو زاگرس</PageTitle>
<div class="visitor-page" dir="rtl">
    <header class="visitor-heading">
        <div><div class="visitor-eyebrow">فروش و سفارش‌گیری</div><h1>ایجاد پیش‌فاکتور</h1></div>
        <div class="hero-3d-art" aria-hidden="true"><span class="hero-orbit hero-orbit-one"></span><span class="hero-orbit hero-orbit-two"></span><span class="hero-core"><i></i><b></b></span><span class="hero-spark hero-spark-one"></span><span class="hero-spark hero-spark-two"></span></div>
    </header>
    <section class="visitor-panel">
        <div class="visitor-toolbar">
            <div class="visitor-search-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input class="visitor-search" placeholder="جستجو در پیش‌فاکتورها..." @bind="searchText" @bind:event="oninput" /></div>
            <div class="visitor-toolbar-actions"><span class="visitor-count">@(masterSaved ? "۱ پیش‌فاکتور در حال تکمیل" : "۰ پیش‌فاکتور")</span><button type="button" class="visitor-button visitor-button-primary" title="ایجاد پیش‌فاکتور" aria-label="ایجاد پیش‌فاکتور" @onclick="OpenCreate"><svg class="visitor-inline-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button></div>
        </div>
        <div class="visitor-empty"><strong>@(masterSaved ? "سربرگ پیش‌فاکتور ثبت شده است" : "برای شروع، پیش‌فاکتور جدید ایجاد کنید")</strong><span>@(masterSaved ? $"شناسه پیش‌فاکتور: {savedPishFactorSN}" : "ابتدا سربرگ را ثبت کنید؛ سپس کالاهای پیش‌فاکتور را اضافه کنید.")</span><button type="button" class="visitor-button visitor-button-primary" @onclick="OpenCreate">@(masterSaved ? "ادامه تکمیل پیش‌فاکتور" : "ایجاد پیش‌فاکتور")</button></div>
    </section>
</div>

@if (showEditor)
{
    <div class="visitor-modal-backdrop" @onclick="CloseEditor">
        <section class="visitor-modal create-pishfactor-modal" role="dialog" aria-modal="true" aria-labelledby="create-pishfactor-title" @onclick:stopPropagation="true" dir="rtl">
            <header class="visitor-modal-header">
                <div class="visitor-modal-title-icon"><svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H5V3zM15 3v5h5M8 12h8M8 16h8"/></svg></div>
                <div class="visitor-modal-heading-copy"><span class="visitor-modal-eyebrow">اطلاعات اصلی فروش</span><h2 id="create-pishfactor-title">@(masterSaved ? "تکمیل پیش‌فاکتور" : "ایجاد پیش‌فاکتور جدید")</h2><p>@(masterSaved ? $"سربرگ با شناسه {savedPishFactorSN} ثبت شده؛ اکنون کالاها را اضافه کنید." : "ابتدا اطلاعات سربرگ را ثبت کنید تا شناسه پیش‌فاکتور ایجاد شود.")</p></div>
                <button type="button" class="visitor-modal-close" aria-label="بستن" @onclick="CloseEditor">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(pageError)) { <div class="visitor-inline-error create-pishfactor-error">@pageError</div> }
            @if (!string.IsNullOrWhiteSpace(comboError)) { <div class="visitor-inline-error create-pishfactor-error">@comboError <button type="button" class="visitor-button visitor-button-light" @onclick="LoadCombosAsync" disabled="@loadingCombos">تلاش مجدد</button></div> }
            @if (loadingCombos) { <div class="create-pishfactor-loading"><span class="visitor-spinner"></span><span>در حال دریافت فهرست انتخاب‌ها...</span></div> }

            <div class="pish-form-section create-pishfactor-section">
                <div class="visitor-form-section-title">مرحله اول ـ اطلاعات سربرگ پیش‌فاکتور</div>
                <div class="visitor-form-grid create-pishfactor-grid">
                    <label class="visitor-field"><span>نوع پرداخت</span><select @bind="form.NoePardakhtSN" disabled="@masterSaved"><option value="">انتخاب نوع پرداخت</option>@foreach(var x in noePardakhts){<option value="@x.Id">@x.Title</option>}</select></label>
                    <label class="visitor-field"><span>شرح پیش‌فاکتور</span><input @bind="form.PishFactorDs" maxlength="500" placeholder="شرح پیش‌فاکتور را وارد کنید" disabled="@masterSaved" /></label>
                    <label class="visitor-field"><span>نوع تحویل</span><select @bind="form.NoeTahvilSN" disabled="@masterSaved"><option value="">انتخاب نوع تحویل</option>@foreach(var x in noeTahvil){<option value="@x.Id">@x.Title</option>}</select></label>
                    <label class="visitor-field"><span>تاریخ صدور</span><input value="@form.SodoorDateText" readonly aria-readonly="true" /></label>
                    <label class="visitor-field"><span>وضعیت</span><input value="موقت" readonly aria-readonly="true" class="create-pishfactor-readonly create-pishfactor-status" /></label>
                    <label class="visitor-field"><span>کارتن</span><input value="@FormatNumber(form.Karton)" readonly aria-readonly="true" class="create-pishfactor-readonly" /></label>
                    <label class="visitor-field"><span>وزن</span><input value="@FormatNumber(form.Vazn)" readonly aria-readonly="true" class="create-pishfactor-readonly" /></label>
                    <label class="visitor-field"><span>حجم</span><input value="@FormatNumber(form.Hajm)" readonly aria-readonly="true" class="create-pishfactor-readonly" /></label>
                    <label class="visitor-field"><span>تاریخ وصول</span><input @bind="form.VosoolDateText" inputmode="numeric" dir="ltr" placeholder="۱۴۰۵/۰۱/۰۱" disabled="@masterSaved" /></label>
                    <label class="visitor-field"><span>تخفیف کل</span><input type="number" min="0" step="1" @bind="form.TakhfifKol" disabled="@masterSaved" /></label>
                    <label class="visitor-field"><span>مبلغ کل</span><input value="@FormatNumber(form.MablaghKol)" readonly aria-readonly="true" class="create-pishfactor-readonly" /></label>
                    <label class="visitor-field"><span>عوارض</span><input value="@FormatNumber(form.Avarez)" readonly aria-readonly="true" class="create-pishfactor-readonly" /></label>
                    <label class="visitor-field"><span>مالیات</span><input value="@FormatNumber(form.Maliat)" readonly aria-readonly="true" class="create-pishfactor-readonly" /></label>
                    <label class="visitor-field"><span>مشتری</span><select @bind="form.MoshtariInfoSN" disabled="@masterSaved"><option value="">انتخاب مشتری</option>@foreach(var x in moshtaris){<option value="@x.Id">@x.Title</option>}</select></label>
                    <label class="visitor-field"><span>ویزیتور</span><select @bind="form.VisitorSN" disabled="@masterSaved"><option value="">انتخاب ویزیتور</option>@foreach(var x in visitors){<option value="@x.Id">@x.Title</option>}</select></label>
                </div>
                @if (!masterSaved)
                {
                    <div class="visitor-modal-footer create-pishfactor-footer">
                        <button type="button" class="visitor-button visitor-button-light" @onclick="CloseEditor">انصراف</button>
                        <button type="button" class="visitor-button visitor-button-primary" @onclick="SaveMasterAsync" disabled="@savingMaster">@(savingMaster ? "در حال ثبت سربرگ..." : "ثبت سربرگ و ادامه")</button>
                    </div>
                }
                else
                {
                    <div class="visitor-inline-success" style="margin-top:12px">سربرگ پیش‌فاکتور با موفقیت ثبت شد. شناسه: @savedPishFactorSN</div>
                }
            </div>

            @if (masterSaved)
            {
                <div class="pish-form-section create-pishfactor-section">
                    <div class="visitor-form-section-title">مرحله دوم ـ افزودن کالا به پیش‌فاکتور</div>
                    <div class="visitor-form-grid create-pishfactor-grid">
                        <label class="visitor-field"><span>انتخاب کالا</span><select @bind="lineForm.KalaSN" disabled="@savingLine"><option value="">انتخاب کالا</option>@foreach(var x in kalas){<option value="@x.Id">@x.Title</option>}</select></label>
                        <label class="visitor-field"><span>تعداد کالا</span><input type="number" min="0.001" step="0.001" @bind="lineForm.Tedad" disabled="@savingLine" /></label>
                        <label class="visitor-field"><span>جایزه</span><input type="checkbox" class="visitor-prize-checkbox" @bind="lineForm.IsJayeze" disabled="@savingLine" /></label>
                    </div>
                    <div class="visitor-modal-footer create-pishfactor-footer">
                        <button type="button" class="visitor-button visitor-button-primary" @onclick="AddProductAsync" disabled="@savingLine">@(savingLine ? "در حال ثبت و محاسبه..." : "ثبت کالا و محاسبه نرخ، تخفیف و مالیات")</button>
                    </div>
                    @if (savedLines.Count > 0)
                    {
                        <div class="pish-section-title"><div><h3>کالاهای ثبت‌شده</h3><small>مقادیر مالی از سرویس محاسباتی دریافت شده‌اند و قابل ویرایش نیستند.</small></div></div>
                        <div class="visitor-lines-wrap"><table class="visitor-lines"><thead><tr><th>ردیف</th><th>کالا</th><th>تعداد</th><th>نرخ واحد</th><th>درصد تخفیف</th><th>مبلغ تخفیف</th><th>مالیات</th><th>عوارض</th><th>جایزه</th></tr></thead><tbody>
                        @foreach(var row in savedLines){<tr @key="row.PishFactorHaSN"><td>@(savedLines.IndexOf(row)+1)</td><td>@row.KalaTitle</td><td>@row.Tedad.ToString("N2")</td><td>@FormatNumber(row.NerkheVahed)</td><td>@FormatNumber(row.DarsadeTakhfif)</td><td>@FormatNumber(row.MablagheTakhfif)</td><td>@FormatNumber(row.Maliat)</td><td>@FormatNumber(row.Avarez)</td><td>@(row.IsJayeze ? "بله" : "خیر")</td></tr>}
                        </tbody></table></div>
                        <div class="visitor-line-summary"><span>@savedLines.Count قلم کالا ثبت شده</span><span>مجموع تعداد: <b>@savedLines.Sum(x=>x.Tedad).ToString("N2")</b></span></div>
                    }
                </div>
            }
            <footer class="visitor-modal-footer create-pishfactor-footer">
                @if (masterSaved) { <button type="button" class="visitor-button visitor-button-light" @onclick="FinishAsync" disabled="@savingLine">پایان و بستن</button> }
                else { <span class="create-pishfactor-next-note">پس از ثبت سربرگ، بخش انتخاب و ثبت کالا فعال می‌شود.</span> }
            </footer>
        </section>
    </div>
}

@code {
    private const string CreateEndpoint = "api/v1/PishFactor/CreatePishFactor";
    private const string CreateHaEndpoint = "api/v1/PishFactor/CreatePishFactorHa";
    private const string CalculateHaEndpoint = "api/v1/PishFactor/CalculatePishFactorHa";
    private const string AllHaEndpoint = "api/v1/PishFactor/GetAllPishFactorHa";
    private const string AllEndpoint = "api/v1/PishFactor/GetAllPishFactor";
    private const decimal VahedeTejariSN = 230034.935m;

    private readonly List<LookupItem> noePardakhts = [], noeTahvil = [], visitors = [], moshtaris = [], kalas = [];
    private readonly List<SavedLine> savedLines = [];
    private CreateForm form = new();
    private LineForm lineForm = new();
    private bool showEditor, loadingCombos, savingMaster, savingLine, masterSaved;
    private decimal savedPishFactorSN;
    private string searchText = "";
    private string? comboError, pageError;

    protected override Task OnInitializedAsync() => LoadCombosAsync();

    private void OpenCreate()
    {
        if (masterSaved) { showEditor = true; return; }
        form = new CreateForm { SodoorDateText = ToPersianDate(DateTime.Today) };
        lineForm = new LineForm();
        pageError = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        if (!savingMaster && !savingLine) showEditor = false;
    }

    private async Task SaveMasterAsync()
    {
        pageError = null;
        if (!TryDecimal(form.MoshtariInfoSN, out var moshtariSn) || moshtariSn == 0)
        { pageError = "انتخاب مشتری الزامی است."; return; }
        if (!TryDecimal(form.VisitorSN, out var visitorSn) || visitorSn == 0)
        { pageError = "انتخاب ویزیتور الزامی است."; return; }
        if (!TryParsePersianDate(form.SodoorDateText, out var sodoorDate))
        { pageError = "تاریخ صدور معتبر نیست."; return; }

        var sodoor = ToPersianDate(sodoorDate).Replace("/", "");
        savingMaster = true;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var dto = new
            {
                PishFactorSN = 0,
                Identifire = 0,
                PishFactorDs = form.PishFactorDs,
                PishFactorNo = (string?)null,
                NoePardakhtSN = ParseNullableDecimal(form.NoePardakhtSN),
                NoeTahvilSN = ParseNullableDecimal(form.NoeTahvilSN),
                SodoorDate = sodoor,
                Status = (byte)1,
                VahedeTejariSN,
                TakhfifKol = form.TakhfifKol,
                MablaghKol = 0,
                Avarez = 0,
                Maliat = 0,
                RezAvarez = 0,
                MoshtariInfoSN = moshtariSn,
                VisitorSN = visitorSn
            };

            // بعضی نسخه‌های API فقط نتیجه موفقیت برمی‌گردانند و شناسه را در body قرار نمی‌دهند.
            // قبل از ثبت، شناسه‌های موجود را می‌گیریم تا در صورت نبود شناسه در پاسخ، رکورد تازه را پیدا کنیم.
            var existingIds = new HashSet<decimal>();
            try
            {
                var before = await GetJsonAsync(client, AllEndpoint);
                foreach (var item in ReadArray(before))
                {
                    var existingId = ReadDecimal(item, "PishFactorSN", "Identifire", "Identifier", "Id", "SN");
                    if (existingId != 0) existingIds.Add(existingId);
                }
            }
            catch
            {
                // خود عملیات ثبت مرجع اصلی است؛ اگر خواندن فهرست قبل از ثبت در دسترس نبود،
                // ابتدا ثبت را انجام می‌دهیم و بعد شناسه را از پاسخ یا فهرست دریافت می‌کنیم.
            }

            var response = await PostAsync(client, CreateEndpoint, dto);
            savedPishFactorSN = ReadReturnedDecimal(response);
            if (savedPishFactorSN == 0)
            {
                var after = await GetJsonAsync(client, AllEndpoint);
                var createdItems = ReadArray(after)
                    .Where(item => !existingIds.Contains(ReadDecimal(item, "PishFactorSN", "Identifire", "Identifier", "Id", "SN")))
                    .Where(item =>
                        ReadDecimal(item, "MoshtariInfoSN") == moshtariSn &&
                        ReadDecimal(item, "VisitorSN") == visitorSn &&
                        Normalize(ReadText(item, "SodoorDate")).Replace("/", "") == Normalize(sodoor).Replace("/", "") &&
                        (string.IsNullOrWhiteSpace(form.PishFactorDs) ||
                         ReadText(item, "PishFactorDs").Equals(form.PishFactorDs, StringComparison.OrdinalIgnoreCase)))
                    .ToList();

                if (createdItems.Count == 1)
                    savedPishFactorSN = ReadDecimal(createdItems[0], "PishFactorSN", "Identifire", "Identifier", "Id", "SN");
                else if (createdItems.Count > 1)
                    savedPishFactorSN = createdItems
                        .Select(item => ReadDecimal(item, "PishFactorSN", "Identifire", "Identifier", "Id", "SN"))
                        .Where(id => id != 0)
                        .OrderByDescending(id => id)
                        .FirstOrDefault();
            }

            if (savedPishFactorSN == 0)
                throw new InvalidOperationException("سربرگ ثبت شده، اما شناسه آن نه در پاسخ ثبت و نه در فهرست پیش‌فاکتورها پیدا نشد. برای جلوگیری از ثبت تکراری، دوباره ثبت نکنید و فهرست پیش‌فاکتورها را بررسی کنید.");

            form.SodoorDateText = ToPersianDate(sodoorDate);
            masterSaved = true;
            pageError = null;
        }
        catch (Exception ex) { pageError = "ثبت سربرگ انجام نشد: " + ex.Message; }
        finally { savingMaster = false; }
    }

    private async Task AddProductAsync()
    {
        pageError = null;
        if (!masterSaved || savedPishFactorSN == 0)
        { pageError = "ابتدا باید سربرگ پیش‌فاکتور ثبت شود."; return; }
        if (!TryDecimal(lineForm.KalaSN, out var kalaSn) || kalaSn == 0)
        { pageError = "یک کالا انتخاب کنید."; return; }
        if (lineForm.Tedad <= 0)
        { pageError = "تعداد کالا باید بیشتر از صفر باشد."; return; }

        savingLine = true;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var dto = new
            {
                PishFactorHaSN = 0,
                Identifire = 0,
                PishFactorSN = savedPishFactorSN,
                KalaSN = kalaSn,
                Tedad = lineForm.Tedad,
                Status = (byte)1,
                IsJayeze = lineForm.IsJayeze,
                NerkheVahed = (long?)null,
                DarsadeTakhfif = (decimal?)null,
                MablagheTakhfif = (decimal?)null,
                Avarez = (decimal?)null,
                Maliat = (decimal?)null,
                RezAvarez = (decimal?)0
            };

            var created = await PostAsync(client, CreateHaEndpoint, dto);
            var detailSn = ReadReturnedDecimal(created);
            if (detailSn == 0)
                throw new InvalidOperationException("ردیف کالا ثبت شد اما شناسه ردیف از پاسخ سرویس دریافت نشد؛ محاسبات قابل اجرا نیست.");

            var date = ToPersianDate(DateTime.Today);
            if (TryParsePersianDate(form.SodoorDateText, out var parsedDate))
                date = ToPersianDate(parsedDate).Replace("/", "");

            var calculateUrl = $"{CalculateHaEndpoint}?PishFactorHaSN={detailSn.ToString(CultureInfo.InvariantCulture)}"
                + $"&KalaSN={kalaSn.ToString(CultureInfo.InvariantCulture)}"
                + $"&VahedeTejariSN={VahedeTejariSN.ToString(CultureInfo.InvariantCulture)}"
                + $"&SodoorDate={Uri.EscapeDataString(date)}";
            using var calculateResponse = await client.PostAsync(calculateUrl, null);
            var calculateJson = await calculateResponse.Content.ReadAsStringAsync();
            EnsureSuccess(calculateResponse, calculateJson);

            var details = await GetJsonAsync(client, AllHaEndpoint);
            var detail = ReadArray(details).Select(ReadSavedLine).FirstOrDefault(x => x.PishFactorHaSN == detailSn);
            var title = kalas.FirstOrDefault(x => x.Id == kalaSn.ToString(CultureInfo.InvariantCulture))?.Title ?? kalaSn.ToString(CultureInfo.InvariantCulture);
            savedLines.Add(detail is null
                ? new SavedLine { PishFactorHaSN = detailSn, KalaTitle = title, Tedad = lineForm.Tedad, IsJayeze = lineForm.IsJayeze }
                : new SavedLine
                {
                    PishFactorHaSN = detail.PishFactorHaSN,
                    KalaTitle = title,
                    Tedad = detail.Tedad,
                    NerkheVahed = detail.NerkheVahed ?? 0,
                    DarsadeTakhfif = detail.DarsadeTakhfif ?? 0,
                    MablagheTakhfif = detail.MablagheTakhfif ?? 0,
                    Maliat = detail.Maliat ?? 0,
                    Avarez = detail.Avarez ?? 0,
                    IsJayeze = detail.IsJayeze
                });

            await RefreshMasterTotalsAsync(client);
            lineForm = new LineForm();
        }
        catch (Exception ex) { pageError = "ثبت یا محاسبه کالا با خطا مواجه شد: " + ex.Message; }
        finally { savingLine = false; }
    }

    private async Task RefreshMasterTotalsAsync(HttpClient client)
    {
        try
        {
            var data = await GetJsonAsync(client, AllEndpoint);
            var master = ReadArray(data).Select(ReadMasterSummary).FirstOrDefault(x => x.PishFactorSN == savedPishFactorSN);
            if (master is not null)
            {
                form.MablaghKol = master.MablaghKol ?? 0;
                form.Avarez = master.Avarez ?? 0;
                form.Maliat = master.Maliat ?? 0;
                form.Karton = master.Karton ?? 0;
                form.Vazn = master.Vazn ?? 0;
                form.Hajm = master.Hajm ?? 0;
            }
        }
        catch { /* ثبت ردیف و محاسبه مستقل از تازه‌سازی نمای جمع سربرگ است. */ }
    }

    private async Task FinishAsync()
    {
        showEditor = false;
        masterSaved = false;
        savedPishFactorSN = 0;
        savedLines.Clear();
        await Task.CompletedTask;
    }

    private async Task LoadCombosAsync()
    {
        loadingCombos = true;
        comboError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var definitions = new[]
            {
                ("نوع پرداخت", "api/v1/NoePardakht/GetNoePardakhtByCombo", noePardakhts),
                ("نوع تحویل", "api/v1/NoeTahvil/GetNoeTahvilByCombo", noeTahvil),
                ("ویزیتور", "api/v1/Visitor/GetVisitorByCombo", visitors),
                ("مشتری", "api/v1/Moshtari/GetMoshtariInfoByCombo", moshtaris),
                ("کالا", "api/v1/Kala/GetKalaByCombo", kalas)
            };
            var errors = new List<string>();
            foreach (var definition in definitions)
            {
                try
                {
                    var payload = await GetJsonAsync(client, definition.Item2);
                    var parsed = ReadArray(payload).Select(ReadLookup)
                        .Where(x => x.Id != "0" && !string.IsNullOrWhiteSpace(x.Title)).ToList();
                    Set(definition.Item3, parsed);
                    if (parsed.Count == 0) errors.Add($"{definition.Item1}: گزینه‌ای از سرویس دریافت نشد.");
                }
                catch (Exception ex)
                {
                    definition.Item3.Clear();
                    errors.Add($"{definition.Item1}: {ex.Message}");
                }
            }
            if (errors.Count > 0) comboError = string.Join(" | ", errors);
        }
        catch (Exception ex) { comboError = "دریافت فهرست‌ها ناموفق بود: " + ex.Message; }
        finally { loadingCombos = false; }
    }

    private static void Set(List<LookupItem> target, List<LookupItem> source)
    {
        target.Clear();
        target.AddRange(source);
    }

    private static async Task<JsonElement> GetJsonAsync(HttpClient client, string endpoint)
    {
        using var response = await client.GetAsync(endpoint);
        var json = await response.Content.ReadAsStringAsync();
        EnsureSuccess(response, json);
        return Extract(json);
    }

    private static async Task<JsonElement> PostAsync(HttpClient client, string endpoint, object body)
    {
        using var response = await client.PostAsJsonAsync(endpoint, body);
        var json = await response.Content.ReadAsStringAsync();
        EnsureSuccess(response, json);
        return Extract(json);
    }

    private static LookupItem ReadLookup(JsonElement element)
    {
        var id = ReadDecimal(element, "Id", "ID", "SN", "Value", "Key", "KalaSN",
            "VisitorSN", "MoshtariInfoSN", "MoshtariSN", "NoePardakhtSN", "NoeTahvilSN");
        var title = ReadText(element, "Title", "Text", "Label", "Name", "DS", "Ds",
            "DisplayName", "FullName", "KalaDs", "KalaDS", "KalaName", "KalaTitle", "KalaNo",
            "VisitorDs", "VisitorDS", "VisitorName", "VisitorTitle", "VisitorFullName",
            "MoshtariDs", "MoshtariDS", "MoshtariInfoDs", "MoshtariInfoDS",
            "MoshtariInfoTitle", "MoshtariName", "MoshtariTitle", "MoshtariFullName", "MoshtariNo",
            "NoePardakhtDs", "NoePardakhtDS", "NoePardakhtName", "NoePardakhtTitle",
            "NoeTahvilDs", "NoeTahvilDS", "NoeTahvilName", "NoeTahvilTitle");
        if ((id == 0m || string.IsNullOrWhiteSpace(title)) && element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (property.Value.ValueKind != JsonValueKind.Object) continue;
                var nested = ReadLookup(property.Value);
                if (id == 0m && decimal.TryParse(Normalize(nested.Id), NumberStyles.Any, CultureInfo.InvariantCulture, out var nestedId)) id = nestedId;
                if (string.IsNullOrWhiteSpace(title)) title = nested.Title;
                if (id != 0m && !string.IsNullOrWhiteSpace(title)) break;
            }
        }
        return new LookupItem { Id = id.ToString(CultureInfo.InvariantCulture), Title = title };
    }

