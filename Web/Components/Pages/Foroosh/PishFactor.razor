@page "/foroosh/pish-factor"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient

<PageTitle>مدیریت پیش‌فاکتورها | مینو زاگرس</PageTitle>
<div class="visitor-page" dir="rtl">
    <header class="visitor-heading">
        <div><div class="visitor-eyebrow">فروش و سفارش‌گیری</div><h1>مدیریت پیش‌فاکتورها</h1></div>
        <div class="hero-3d-art" aria-hidden="true"><span class="hero-orbit hero-orbit-one"></span><span class="hero-orbit hero-orbit-two"></span><span class="hero-core"><i></i><b></b></span><span class="hero-spark hero-spark-one"></span><span class="hero-spark hero-spark-two"></span></div>
    </header>
    <section class="visitor-panel">
        <div class="visitor-toolbar">
            <div class="visitor-search-wrap"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input class="visitor-search" placeholder="جستجو بر اساس شماره، شرح، مشتری یا ویزیتور..." @bind="searchText" @bind:event="oninput" /></div>
            <div class="visitor-toolbar-actions"><span class="visitor-count">@Filtered.Count پیش‌فاکتور</span><button type="button" class="visitor-button visitor-button-light" title="بارگذاری مجدد" aria-label="بارگذاری مجدد" @onclick="LoadAllAsync" disabled="@loading"><svg class="visitor-inline-icon" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M5.6 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.4-3"/></svg></button><button type="button" class="visitor-button visitor-button-primary" title="ثبت پیش‌فاکتور" aria-label="ثبت پیش‌فاکتور" @onclick="OpenCreate"><svg class="visitor-inline-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button></div>
        </div>
        @if(!string.IsNullOrWhiteSpace(loadError)){<div class="visitor-inline-error">@loadError</div>}
        @if(loading){<div class="visitor-empty"><span class="visitor-spinner"></span><strong>در حال دریافت اطلاعات...</strong></div>}
        else if(Filtered.Count==0){<div class="visitor-empty"><strong>@(items.Count==0?"هنوز پیش‌فاکتوری ثبت نشده است":"موردی مطابق جستجو پیدا نشد")</strong><span>برای مشاهده نتایج، عبارت جستجو را تغییر دهید یا پیش‌فاکتور جدید ثبت کنید.</span>@if(items.Count==0){<button type="button" class="visitor-button visitor-button-primary" @onclick="OpenCreate">ثبت پیش‌فاکتور</button>}</div>}
        else{
        <div class="visitor-table-wrap"><table class="visitor-table"><thead><tr><th>ردیف</th><th>شماره</th><th>شرح پیش‌فاکتور</th><th>تاریخ صدور</th><th>مشتری</th><th>ویزیتور</th><th>نوع پرداخت</th><th>نوع تحویل</th><th>مبلغ کل</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
        @foreach(var x in Filtered){<tr @key="x.PishFactorSN"><td>@(Filtered.IndexOf(x)+1)</td><td>@Show(x.PishFactorNo)</td><td>@Show(x.PishFactorDs)</td><td>@DisplayPersianDate(x.SodoorDate)</td><td>@Show(x.MoshtariNo)</td><td>@Show(x.VisitorDs)</td><td>@Show(x.NoePardakhtDs)</td><td>@Show(x.NoeTahvilDs)</td><td>@x.MablaghKol?.ToString("N0")</td><td><span class="visitor-status @(x.Status==1?"active":"inactive")"><i></i>@(x.Status==1?"فعال":"غیرفعال")</span></td><td><div class="visitor-row-actions"><button type="button" class="visitor-row-action edit" title="ویرایش" aria-label="ویرایش" @onclick="()=>OpenEditAsync(x)"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="m16.5 3.5 4 4L8 20l-4 1 1-4Z"/></svg></button><button type="button" class="visitor-row-action delete" title="حذف" aria-label="حذف" @onclick="()=>pendingDelete=x"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m5 5v5m4-5v5"/></svg></button></div></td></tr>}
        </tbody></table></div>
        <div class="visitor-table-footer">نمایش @Filtered.Count از @items.Count پیش‌فاکتور</div>}
    </section>
</div>

@if(showEditor){
<div class="visitor-modal-backdrop" @onclick="CloseEditor"><section class="visitor-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl">
<header class="visitor-modal-header"><div class="visitor-modal-title-icon"><svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H5V3zM15 3v5h5M8 12h8M8 16h8"/></svg></div><div class="visitor-modal-heading-copy"><span class="visitor-modal-eyebrow">اطلاعات فروش</span><h2>@(isEdit?"ویرایش پیش‌فاکتور":"ثبت پیش‌فاکتور جدید")</h2><p>ابتدا اطلاعات کلی و سپس یک یا چند قلم کالا را ثبت کنید.</p></div><button type="button" class="visitor-modal-close" @onclick="CloseEditor">×</button></header>
@if(!string.IsNullOrWhiteSpace(editorError)){<div class="visitor-inline-error">@editorError</div>}
@if(!string.IsNullOrWhiteSpace(comboError)){<div class="visitor-inline-error">خطا در دریافت کمبوها: @comboError <button type="button" class="visitor-button visitor-button-light" @onclick="LoadCombosAsync">تلاش مجدد</button></div>}
<div class="pish-form-section"><div class="visitor-form-section-title">اطلاعات اصلی پیش‌فاکتور</div><div class="visitor-form-grid">
<label>شرح پیش‌فاکتور<input @bind="form.PishFactorDs" placeholder="شرح یا توضیحات پیش‌فاکتور"/></label>
<label>تاریخ صدور <b>*</b><input @bind="form.SodoorDateText" placeholder="۱۴۰۵/۰۱/۰۱" inputmode="numeric" dir="ltr"/></label>
<label>مشتری <b>*</b><select @bind="form.MoshtariInfoSN"><option value="0">انتخاب مشتری</option>@foreach(var o in moshtaris){<option value="@o.Id">@o.Title</option>}</select></label>
<label>ویزیتور <b>*</b><select @bind="form.VisitorSN"><option value="0">انتخاب ویزیتور</option>@foreach(var o in visitors){<option value="@o.Id">@o.Title</option>}</select></label>
<label>نوع پرداخت<select @bind="form.NoePardakhtSN"><option value="">انتخاب نوع پرداخت</option>@foreach(var o in noePardakhts){<option value="@o.Id">@o.Title</option>}</select></label>
<label>نوع تحویل<select @bind="form.NoeTahvilSN"><option value="">انتخاب نوع تحویل</option>@foreach(var o in noeTavhils){<option value="@o.Id">@o.Title</option>}</select></label>
<label>کانال فروش<select @bind="form.KanaleForooshSN"><option value="">انتخاب کانال فروش</option>@foreach(var o in kanalha){<option value="@o.Id">@o.Title</option>}</select></label>
<label>وضعیت<select @bind="form.Status"><option value="1">فعال</option><option value="0">غیرفعال</option></select></label>
<label>تخفیف کل<input type="number" min="0" @bind="form.TakhfifKol"/></label>
<label>مبلغ کل<input type="number" min="0" @bind="form.MablaghKol"/></label>
</div></div>
<div class="pish-form-section">
<div class="pish-section-title"><div><h3>اقلام پیش‌فاکتور</h3><small>برای هر کالا یک ردیف اضافه کنید؛ تعداد ردیف‌ها محدودیتی ندارد.</small></div><button class="visitor-button visitor-button-primary" @onclick="AddRow">＋ افزودن کالا</button></div>
<div class="visitor-lines-wrap"><table class="visitor-lines"><thead><tr><th>ردیف</th><th>کالا <b>*</b></th><th>تعداد <b>*</b></th><th>نرخ واحد</th><th>درصد تخفیف</th><th>مبلغ تخفیف</th><th>مالیات</th><th>عوارض</th><th></th></tr></thead><tbody>
@for(var i=0;i<form.Lines.Count;i++){var row=form.Lines[i];<tr @key="row.Key"><td>@(i+1)</td><td><select @bind="row.KalaSN"><option value="0">انتخاب کالا</option>@foreach(var k in kalas){<option value="@k.Id">@k.Title</option>}</select></td><td><input type="number" min="0.001" step="0.001" @bind="row.Tedad"/></td><td><input type="number" min="0" @bind="row.NerkheVahed"/></td><td><input type="number" min="0" max="100" step="0.01" @bind="row.DarsadeTakhfif"/></td><td><input type="number" min="0" @bind="row.MablagheTakhfif"/></td><td><input type="number" min="0" @bind="row.Maliat"/></td><td><input type="number" min="0" @bind="row.Avarez"/></td><td><button class="visitor-remove" title="حذف ردیف" @onclick="()=>RemoveRow(row)">×</button></td></tr>}
</tbody></table></div>
<div class="visitor-line-summary"><span>@form.Lines.Count قلم کالا</span><span>مجموع تعداد: <b>@form.Lines.Sum(x=>x.Tedad).ToString("N2")</b></span></div>
</div>
<footer class="visitor-modal-footer"><button class="visitor-button visitor-button-light" @onclick="CloseEditor" disabled="@saving">انصراف</button><button type="button" class="visitor-button visitor-button-primary" @onclick="SaveAsync" disabled="@saving">@(saving?"در حال ذخیره...":isEdit?"ذخیره تغییرات":"ثبت پیش‌فاکتور")</button></footer>
</section></div>
}
@if(pendingDelete is not null){<div class="visitor-modal-backdrop" @onclick="()=>pendingDelete=null"><section class="visitor-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl"><div class="visitor-confirm-icon">!</div><h2>حذف پیش‌فاکتور</h2><p>آیا از حذف پیش‌فاکتور شماره «@pendingDelete.PishFactorNo» مطمئن هستید؟</p>@if(!string.IsNullOrWhiteSpace(deleteError)){<div class="visitor-inline-error">@deleteError</div>}<footer class="visitor-modal-footer"><button class="visitor-button visitor-button-light" @onclick="()=>pendingDelete=null">انصراف</button><button class="visitor-button visitor-button-danger" @onclick="DeleteAsync" disabled="@deleting">@(deleting?"در حال حذف...":"حذف پیش‌فاکتور")</button></footer></section></div>}
@if(showSuccess){<div class="visitor-modal-backdrop"><section class="visitor-confirm-modal visitor-success-modal" role="dialog" aria-modal="true" dir="rtl"><div class="visitor-success-icon"><svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg></div><h2>عملیات موفق</h2><p>@successMessage</p><footer class="visitor-modal-footer"><button class="visitor-button visitor-button-primary" @onclick="ConfirmSuccess">تأیید</button></footer></section></div>}

@code {
    private const string AllEndpoint="api/v1/PishFactor/GetAllPishFactor", AllHaEndpoint="api/v1/PishFactor/GetAllPishFactorHa";
    private const string CreateEndpoint="api/v1/PishFactor/CreatePishFactor", UpdateEndpoint="api/v1/PishFactor/UpdatePishFactor", DeleteEndpoint="api/v1/PishFactor/DeletePishFactor";
    private const string CreateHaEndpoint="api/v1/PishFactor/CreatePishFactorHa", UpdateHaEndpoint="api/v1/PishFactor/UpdatePishFactorHa", DeleteHaEndpoint="api/v1/PishFactor/DeletePishFactorHa";
    private readonly List<Factor> items=[]; private readonly List<FactorLineData> allLines=[];
    private readonly List<Lookup> noePardakhts=[],noeTavhils=[],kalas=[],visitors=[],moshtaris=[],kanalha=[];
    private FactorForm form=new(); private Factor? pendingDelete; private string searchText=""; private string? loadError,editorError,deleteError; private string successMessage="";
    private bool loading,showEditor,isEdit,saving,deleting,showSuccess; private decimal editingSN; private string? comboError;
    private List<Factor> Filtered=>items.Where(x=>string.IsNullOrWhiteSpace(searchText)||new[]{x.PishFactorNo,x.PishFactorDs,x.MoshtariNo,x.VisitorDs,x.NoePardakhtDs,x.NoeTahvilDs}.Any(v=>Contains(v,searchText))).OrderByDescending(x=>x.PishFactorSN).ToList();

    protected override async Task OnInitializedAsync(){await Task.WhenAll(LoadAllAsync(),LoadCombosAsync());}
    private async Task LoadAllAsync(){loading=true;loadError=null;try{using var c=await ApiClient.CreateAuthorizedClientAsync();var a=await GetJson(c,AllEndpoint);var b=await GetJson(c,AllHaEndpoint);items.Clear();items.AddRange(ReadArray(a).Select(ReadFactor).Where(x=>x.PishFactorSN!=0));allLines.Clear();allLines.AddRange(ReadArray(b).Select(ReadLine).Where(x=>x.PishFactorHaSN!=0));}catch(Exception ex){loadError=ex.Message;}finally{loading=false;}}
    private async Task LoadCombosAsync(){comboError=null;using var c=await ApiClient.CreateAuthorizedClientAsync();var defs=new[]{("نوع پرداخت","api/v1/NoePardakht/GetNoePardakhtByCombo",noePardakhts),("نوع تحویل","api/v1/NoeTahvil/GetNoeTahvilByCombo",noeTavhils),("کالا","api/v1/Kala/GetKalaByCombo",kalas),("ویزیتور","api/v1/Visitor/GetVisitorByCombo",visitors),("مشتری","api/v1/Moshtari/GetMoshtariInfoByCombo",moshtaris),("کانال فروش","api/v1/KanaleForoosh/GetKanaleForooshByCombo",kanalha)};var errors=new List<string>();foreach(var d in defs){try{var arr=await GetJson(c,d.Item2);d.Item3.Clear();d.Item3.AddRange(ReadArray(arr).Select(ReadLookup).Where(x=>x.Id!=0&&!string.IsNullOrWhiteSpace(x.Title)));if(d.Item3.Count==0)errors.Add($"{d.Item1}: پاسخ سرویس خالی یا ساختار آن ناشناخته است.");}catch(Exception ex){d.Item3.Clear();errors.Add($"{d.Item1}: {ex.Message}");}}if(errors.Count>0)comboError=string.Join(" | ",errors);}
    private async Task<JsonElement> GetJson(HttpClient c,string endpoint){using var r=await c.GetAsync(endpoint);var j=await r.Content.ReadAsStringAsync();EnsureSuccess(r,j);return Extract(j);}
    private void OpenCreate(){isEdit=false;editingSN=0;editorError=null;form=new FactorForm{Status=1,SodoorDateText=ToPersianDate(DateTime.Today),Lines=[new FactorLine()]};showEditor=true;}
    private async Task OpenEditAsync(Factor x){isEdit=true;editingSN=x.PishFactorSN;editorError=null;form=new FactorForm{PishFactorDs=x.PishFactorDs,PishFactorNo=x.PishFactorNo,SodoorDateText=ToPersianDateText(x.SodoorDate),Status=x.Status,NoePardakhtSN=x.NoePardakhtSN,NoeTahvilSN=x.NoeTahvilSN,KanaleForooshSN=x.KanaleForooshSN,MoshtariInfoSN=x.MoshtariInfoSN,VisitorSN=x.VisitorSN,TakhfifKol=x.TakhfifKol??0,MablaghKol=x.MablaghKol??0,Lines=allLines.Where(z=>z.PishFactorSN==x.PishFactorSN).Select(z=>new FactorLine{PishFactorHaSN=z.PishFactorHaSN,KalaSN=z.KalaSN,Tedad=z.Tedad,NerkheVahed=z.NerkheVahed??0,DarsadeTakhfif=z.DarsadeTakhfif??0,MablagheTakhfif=z.MablagheTakhfif??0,Maliat=z.Maliat??0,Avarez=z.Avarez??0}).ToList()};if(form.Lines.Count==0)form.Lines.Add(new FactorLine());showEditor=true;await Task.CompletedTask;}
    private void AddRow()=>form.Lines.Add(new FactorLine()); private void RemoveRow(FactorLine row){if(form.Lines.Count>1)form.Lines.Remove(row);}
    private async Task SaveAsync(){editorError=null;if(form.MoshtariInfoSN==0||form.VisitorSN==0){editorError="انتخاب مشتری و ویزیتور الزامی است.";return;}if(!TryParsePersianDate(form.SodoorDateText,out var sodoorDate)){editorError="تاریخ صدور را به‌صورت شمسی و با قالب ۱۴۰۵/۰۱/۰۱ وارد کنید.";return;}if(form.Lines.Count==0||form.Lines.Any(x=>x.KalaSN==0||x.Tedad<=0)){editorError="برای تمام ردیف‌ها کالا و تعداد معتبر انتخاب کنید.";return;}form.SodoorDate=ToPersianDate(sodoorDate).Replace("/","");saving=true;
        try{using var c=await ApiClient.CreateAuthorizedClientAsync();decimal masterSn=editingSN;
            var master=new{PishFactorSN=editingSN,Identifire=editingSN,PishFactorDs=form.PishFactorDs,PishFactorNo=form.PishFactorNo,NoePardakhtSN=form.NoePardakhtSN,NoeTahvilSN=form.NoeTahvilSN,SodoorDate=form.SodoorDate,Status=form.Status,VahedeTejariSN=230034.935m,KanaleForooshSN=form.KanaleForooshSN,TakhfifKol=form.TakhfifKol,MablaghKol=form.MablaghKol,Avarez=0,Maliat=0,RezAvarez=0,MoshtariInfoSN=form.MoshtariInfoSN,VisitorSN=form.VisitorSN};
            var response=await Post(c,isEdit?UpdateEndpoint:CreateEndpoint,master);if(!isEdit){masterSn=ReadReturnedDecimal(response);if(masterSn==0)throw new InvalidOperationException("پیش‌فاکتور ثبت شد اما شماره شناسه آن از پاسخ سرویس قابل دریافت نبود.");}
            var old=allLines.Where(x=>x.PishFactorSN==masterSn).ToList();var keep=new HashSet<decimal>();
            foreach(var row in form.Lines){var dto=new{PishFactorHaSN=row.PishFactorHaSN,Identifire=row.PishFactorHaSN,PishFactorSN=masterSn,KalaSN=row.KalaSN,Tedad=row.Tedad,Status=(byte)1,NerkheVahed=(long?)row.NerkheVahed,DarsadeTakhfif=row.DarsadeTakhfif,MablagheTakhfif=row.MablagheTakhfif,Avarez=row.Avarez,Maliat=row.Maliat,RezAvarez=0};if(isEdit&&row.PishFactorHaSN!=0){await Post(c,UpdateHaEndpoint,dto);keep.Add(row.PishFactorHaSN);}else await Post(c,CreateHaEndpoint,dto);}
            foreach(var oldRow in old.Where(x=>!keep.Contains(x.PishFactorHaSN)&&form.Lines.All(z=>z.PishFactorHaSN!=x.PishFactorHaSN)))await Post(c,$"{DeleteHaEndpoint}?PishFactorHaSN={oldRow.PishFactorHaSN.ToString(CultureInfo.InvariantCulture)}",null);
            successMessage=isEdit?"پیش‌فاکتور ویرایش شد.":"پیش‌فاکتور با موفقیت ثبت شد.";showEditor=false;showSuccess=true;
        }catch(Exception ex){editorError=ex.Message;}finally{saving=false;}}
    private async Task<JsonElement> Post(HttpClient c,string endpoint,object? body){using var r=await c.PostAsJsonAsync(endpoint,body);var j=await r.Content.ReadAsStringAsync();EnsureSuccess(r,j);return Extract(j);}
    private async Task DeleteAsync(){if(pendingDelete is null)return;deleting=true;deleteError=null;try{using var c=await ApiClient.CreateAuthorizedClientAsync();await Post(c,$"{DeleteEndpoint}?PishFactorSN={pendingDelete.PishFactorSN.ToString(CultureInfo.InvariantCulture)}",null);pendingDelete=null;showSuccess=true;successMessage="پیش‌فاکتور حذف شد.";}catch(Exception ex){deleteError=ex.Message;}finally{deleting=false;}}
    private async Task ConfirmSuccess(){showSuccess=false;await LoadAllAsync();}
    private void CloseEditor(){if(!saving)showEditor=false;}
    private static Lookup ReadLookup(JsonElement x){var id=Dec(x,"Id","ID","SN","Value","Key","KalaSN","VisitorSN","MoshtariInfoSN","MoshtariSN","NoePardakhtSN","NoeTahvilSN","KanaleForooshSN");var title=Str(x,"Title","Text","Label","Name","DS","DisplayName","FullName","KalaDs","KalaDS","KalaName","KalaTitle","KalaNo","VisitorDs","VisitorDS","VisitorName","VisitorTitle","VisitorFullName","MoshtariDs","MoshtariDS","MoshtariInfoDs","MoshtariInfoDS","MoshtariInfoTitle","MoshtariName","MoshtariTitle","MoshtariFullName","NoePardakhtDs","NoePardakhtDS","NoePardakhtName","NoePardakhtTitle","NoeTahvilDs","NoeTahvilDS","NoeTahvilName","NoeTahvilTitle","KanaleForooshDs","KanaleForooshDS","KanaleForooshName","KanaleForooshTitle");if((id==0||string.IsNullOrWhiteSpace(title))&&x.ValueKind==JsonValueKind.Object){foreach(var p in x.EnumerateObject()){if(p.Value.ValueKind!=JsonValueKind.Object)continue;var nested=ReadLookup(p.Value);if(id==0)id=nested.Id;if(string.IsNullOrWhiteSpace(title))title=nested.Title;if(id!=0&&!string.IsNullOrWhiteSpace(title))break;}}return new(){Id=id,Title=title};}
    private static Factor ReadFactor(JsonElement x)=>new(){PishFactorSN=Dec(x,"PishFactorSN"),PishFactorNo=Str(x,"PishFactorNo"),PishFactorDs=Str(x,"PishFactorDs"),SodoorDate=Str(x,"SodoorDate"),Status=(byte)Dec(x,"Status"),NoePardakhtSN=NDec(x,"NoePardakhtSN"),NoeTahvilSN=NDec(x,"NoeTahvilSN"),KanaleForooshSN=NDec(x,"KanaleForooshSN"),MoshtariInfoSN=Dec(x,"MoshtariInfoSN"),VisitorSN=Dec(x,"VisitorSN"),TakhfifKol=NDec(x,"TakhfifKol"),MablaghKol=(long?)NDec(x,"MablaghKol"),MoshtariNo=Str(x,"MoshtariNo"),VisitorDs=Str(x,"VisitorDs"),NoePardakhtDs=Str(x,"NoePardakhtDs"),NoeTahvilDs=Str(x,"NoeTahvilDs")};
    private static FactorLineData ReadLine(JsonElement x)=>new(){PishFactorHaSN=Dec(x,"PishFactorHaSN"),PishFactorSN=Dec(x,"PishFactorSN"),KalaSN=Dec(x,"KalaSN"),Tedad=Dec(x,"Tedad"),NerkheVahed=NLong(x,"NerkheVahed"),DarsadeTakhfif=NDec(x,"DarsadeTakhfif"),MablagheTakhfif=NDec(x,"MablagheTakhfif"),Avarez=NDec(x,"Avarez"),Maliat=NDec(x,"Maliat")};
    private static string Show(string? s)=>string.IsNullOrWhiteSpace(s)?"—":s;
    private static string ToPersianDate(DateTime value){var pc=new PersianCalendar();return $"{pc.GetYear(value):0000}/{pc.GetMonth(value):00}/{pc.GetDayOfMonth(value):00}";}
    private static string ToPersianDateText(string? value){if(string.IsNullOrWhiteSpace(value))return ToPersianDate(DateTime.Today);var n=Norm(value).Trim();if(n.Length==8&&n.All(char.IsDigit))n=$"{n[..4]}/{n.Substring(4,2)}/{n.Substring(6,2)}";if(n.Contains('T')||n.Contains(':')){if(DateTime.TryParse(value,CultureInfo.InvariantCulture,DateTimeStyles.AssumeLocal,out var gregorian))return ToPersianDate(gregorian);}var parts=n.Split('/','-','.');if(parts.Length==3&&int.TryParse(parts[0],out var y)&&int.TryParse(parts[1],out var m)&&int.TryParse(parts[2],out var d)){try{return ToPersianDate(new PersianCalendar().ToDateTime(y,m,d,0,0,0,0));}catch{}}if(DateTime.TryParse(value,CultureInfo.InvariantCulture,DateTimeStyles.AssumeLocal,out var parsed))return ToPersianDate(parsed);return value;}
