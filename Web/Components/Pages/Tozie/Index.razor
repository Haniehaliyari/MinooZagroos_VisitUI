@page "/tozie"
@attribute [Authorize]
@layout MainLayout
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout

<PageTitle>مینو زاگرس | سیستم توزیع</PageTitle>

<div class="distribution-home" dir="rtl">
    <header class="distribution-heading">
        <span class="distribution-heading-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 7h11v11H3zM14 11h4l3 4v3h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
        </span>
        <h1>سیستم توزیع</h1>
    </header>

    <section class="distribution-grid" aria-label="امکانات سیستم توزیع">
        <section class="distribution-card dispatch-card" aria-label="مدیریت حواله‌ها">
            <div class="dispatch-card-heading">
                <span class="distribution-icon"><svg viewBox="0 0 48 48"><path d="M11 8h20l7 7v26H11zM30 8v8h8M17 23h15M17 29h15M17 35h9"/></svg></span>
                <h2>حواله</h2>
                <a class="dispatch-create-button" href="/tozie/havale/create" title="ایجاد حواله" aria-label="ایجاد حواله">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                </a>
            </div>
            <div class="dispatch-card-divider"></div>
            <a class="dispatch-all-link" href="/tozie/havale">
                <span class="dispatch-all-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h13v16H7zM4 7v14h13M10 9h7M10 13h7M10 17h5"/></svg></span>
                <span>همه حواله‌ها</span>
                <svg class="dispatch-link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        </section>

        <section class="distribution-card dispatch-card driver-dispatch-card" aria-label="مدیریت رانندگان">
            <div class="dispatch-card-heading">
                <span class="distribution-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M5 14h25v21H5zM30 21h8l6 8v6H30z"/><circle cx="14" cy="37" r="4"/><circle cx="37" cy="37" r="4"/><path d="M11 20h13M11 26h9"/></svg></span>
                <h2>راننده</h2>
            </div>
            <div class="dispatch-card-divider"></div>
            <a class="dispatch-all-link" href="/tozie/ranandeh">
                <span class="dispatch-all-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h13v16H7zM4 7v14h13M10 9h7M10 13h7M10 17h5"/></svg></span>
                <span>مشاهده رانندگان</span>
                <svg class="dispatch-link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        </section>

        <section class="distribution-card dispatch-card mamoor-dispatch-card" aria-label="مدیریت مأموران پخش">
            <div class="dispatch-card-heading">
                <span class="distribution-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="18" cy="15" r="8"/><path d="M3 42c1-10 6-15 15-15s14 5 15 15M34 13h11M39.5 7.5v11M34 31h11M34 38h11"/></svg></span>
                <h2>مأمور پخش</h2>
            </div>
            <div class="dispatch-card-divider"></div>
            <a class="dispatch-all-link" href="/tozie/mamoor-pakhsh">
                <span class="dispatch-all-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h13v16H7zM4 7v14h13M10 9h7M10 13h7M10 17h5"/></svg></span>
                <span>مشاهده مأموران پخش</span>
                <svg class="dispatch-link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        </section>
    </section>

</div>
