@page "/tozie/khodroo"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient

<PageTitle>مدیریت خودروها | مینو زاگرس</PageTitle>

<div class="mamoor-page" dir="rtl">
    <header class="mamoor-heading">
        <div><div class="mamoor-eyebrow">توزیع و پخش</div><h1>مدیریت خودروها</h1></div>
        <div class="hero-3d-art" aria-hidden="true"><span class="hero-orbit hero-orbit-one"></span><span class="hero-orbit hero-orbit-two"></span><span class="hero-core"><i></i><b></b></span><span class="hero-spark hero-spark-one"></span><span class="hero-spark hero-spark-two"></span></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(loadError)) { <div class="mamoor-inline-error">@loadError</div> }
    <section class="mamoor-panel">
        <div class="mamoor-toolbar">
            <div class="mamoor-search-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input class="mamoor-search" placeholder="جستجو بر اساس نام خودرو، پلاک، مدل یا رنگ..." @bind="searchText" @bind:event="oninput" /></div>
            <div class="mamoor-toolbar-actions">
                <span class="mamoor-count">@FilteredItems.Count خودرو</span>
                <button type="button" class="mamoor-button mamoor-button-light" title="بارگذاری مجدد" aria-label="بارگذاری مجدد" @onclick="LoadAllAsync" disabled="@loading"><svg class="mamoor-inline-icon" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M5.6 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.4-3"/></svg></button>
                <button type="button" class="mamoor-button mamoor-button-primary" title="ثبت خودرو" aria-label="ثبت خودرو" @onclick="OpenCreate"><svg class="mamoor-inline-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button>
            </div>
        </div>
        @if (loading) { <div class="mamoor-empty"><span class="mamoor-spinner"></span><strong>در حال دریافت فهرست خودروها...</strong></div> }
        else if (items.Count == 0) { <div class="mamoor-empty"><strong>هنوز خودرویی ثبت نشده است</strong><span>برای شروع، اولین خودرو را اضافه کنید.</span><button type="button" class="mamoor-button mamoor-button-primary" @onclick="OpenCreate">ثبت خودرو</button></div> }
        else if (FilteredItems.Count == 0) { <div class="mamoor-empty"><strong>نتیجه‌ای پیدا نشد</strong><span>عبارت جستجو را تغییر دهید.</span></div> }
        else
        {
            <div class="mamoor-table-wrap"><table class="mamoor-table">
                <thead><tr><th>ردیف</th><th>نام خودرو</th><th>پلاک</th><th>نوع خودرو</th><th>راننده</th><th>مدل</th><th>رنگ</th><th>نوع مالکیت</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                <tbody>
                @foreach (var item in FilteredItems)
                {
                    <tr @key="item.KhodrooSN">
                        <td class="mamoor-row-number">@((FilteredItems.IndexOf(item) + 1).ToString("00"))</td>
                        <td><strong class="mamoor-person-name">@Display(item.KhodrooDS)</strong></td>
                        <td class="mamoor-ltr">@Display(item.PelakNO)</td>
                        <td>@Display(FindTitle(noeKhodroos, item.NoeKhodrooSN))</td>
                        <td>@Display(FindTitle(drivers, item.RanandehSN))</td>
                        <td>@Display(item.Model)</td><td>@Display(item.Rang)</td>
                        <td>@Display(FindTitle(noeMalekiat, item.NoeMalekiatSN))</td>
                        <td><span class="mamoor-status @(item.KhodrooStatus == 1 ? "active" : "inactive")"><i></i>@(item.KhodrooStatus == 1 ? "فعال" : "غیرفعال")</span></td>
                        <td>
                            <div class="mamoor-row-actions">
                                <button type="button" class="mamoor-row-action edit" title="ویرایش خودرو" aria-label="ویرایش خودرو" @onclick="() => OpenEdit(item)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
                                </button>
                                <button type="button" class="mamoor-row-action delete" title="حذف خودرو" aria-label="حذف خودرو" @onclick="() => AskDelete(item)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="m19 6-1 14H6L5 6"/><path d="M10 11v5m4-5v5"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
            <div class="mamoor-table-footer"><span>نمایش @FilteredItems.Count از @items.Count خودرو</span><span>اطلاعات از سامانه دریافت می‌شود</span></div>
        }
    </section>
</div>

@if (showEditor)
{
    <div class="mamoor-modal-backdrop" @onclick="CloseEditor">
        <section class="mamoor-modal" role="dialog" aria-modal="true" aria-labelledby="vehicle-modal-title" @onclick:stopPropagation="true" dir="rtl">
            <header class="mamoor-modal-header">
                <div class="mamoor-modal-title-icon"><svg viewBox="0 0 24 24" aria-hidden="true">@if (isEdit) { <path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z"/> } else { <path d="M3 7h11v11H3zM14 11h4l3 4v3h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/> }</svg></div>
                <div class="mamoor-modal-heading-copy"><span class="mamoor-modal-eyebrow">اطلاعات ناوگان توزیع</span><h2 id="vehicle-modal-title">@(isEdit ? "ویرایش خودرو" : "ثبت خودروی جدید")</h2><p>مشخصات خودرو و اطلاعات مرتبط با راننده و مالکیت را وارد کنید.</p></div>
            </header>
            @if (!string.IsNullOrWhiteSpace(editorError)) { <div class="mamoor-inline-error mamoor-modal-error">@editorError</div> }
            <div class="mamoor-form-grid">
                <label class="mamoor-field">نام خودرو <b>*</b><input @bind="form.KhodrooDS" @bind:event="oninput" maxlength="150" placeholder="نام خودرو را وارد کنید"/></label>
                <label class="mamoor-field">پلاک <b>*</b><input @bind="form.PelakNO" @bind:event="oninput" maxlength="30" placeholder="شماره پلاک خودرو"/></label>

                <label class="mamoor-field lookup-field">نوع خودرو <b>*</b>
                    <input value="@noeKhodrooSearch" @oninput="e => OnLookupInput(e, 1)" @onfocus="() => showNoeKhodrooOptions = true" @onblur="() => CloseLookupAsync(1)" autocomplete="off" placeholder="جستجو و انتخاب نوع خودرو"/>
                    @if (showNoeKhodrooOptions) { <div class="mamoor-options">@if (FilteredNoeKhodroos.Count == 0) { <div class="mamoor-option-empty">نوع خودرویی یافت نشد</div> } @foreach (var option in FilteredNoeKhodroos) { <button type="button" @key="option.Id" @onmousedown:preventDefault @onclick="() => SelectLookup(option, 1)">@option.Title</button> }</div> }
                </label>

                <label class="mamoor-field lookup-field">راننده <b>*</b>
                    <input value="@driverSearch" @oninput="e => OnLookupInput(e, 2)" @onfocus="() => showDriverOptions = true" @onblur="() => CloseLookupAsync(2)" autocomplete="off" placeholder="جستجو و انتخاب راننده"/>
                    @if (showDriverOptions) { <div class="mamoor-options">@if (FilteredDrivers.Count == 0) { <div class="mamoor-option-empty">راننده‌ای یافت نشد</div> } @foreach (var option in FilteredDrivers) { <button type="button" @key="option.Id" @onmousedown:preventDefault @onclick="() => SelectLookup(option, 2)">@option.Title</button> }</div> }
                </label>

                <label class="mamoor-field">مدل<input @bind="form.Model" @bind:event="oninput" maxlength="80" placeholder="مدل خودرو"/></label>
                <label class="mamoor-field">رنگ<input @bind="form.Rang" @bind:event="oninput" maxlength="60" placeholder="رنگ خودرو"/></label>

                <label class="mamoor-field lookup-field">نوع مالکیت <b>*</b>
                    <input value="@noeMalekiatSearch" @oninput="e => OnLookupInput(e, 3)" @onfocus="() => showNoeMalekiatOptions = true" @onblur="() => CloseLookupAsync(3)" autocomplete="off" placeholder="جستجو و انتخاب نوع مالکیت"/>
                    @if (showNoeMalekiatOptions) { <div class="mamoor-options">@if (FilteredNoeMalekiats.Count == 0) { <div class="mamoor-option-empty">نوع مالکیتی یافت نشد</div> } @foreach (var option in FilteredNoeMalekiats) { <button type="button" @key="option.Id" @onmousedown:preventDefault @onclick="() => SelectLookup(option, 3)">@option.Title</button> }</div> }
                </label>

                <div class="mamoor-field mamoor-status-field"><span>وضعیت خودرو</span>
                    <button type="button" class="mamoor-switch-row" role="switch" aria-checked="@(form.KhodrooStatus == 1)" @onclick="ToggleStatus">
                        <span class="mamoor-switch @(form.KhodrooStatus == 1 ? "on" : "")"><i></i></span>
                        <span><strong>@(form.KhodrooStatus == 1 ? "فعال" : "غیرفعال")</strong><small>@(form.KhodrooStatus == 1 ? "این خودرو در فهرست انتخاب‌ها قابل استفاده است." : "این خودرو غیرفعال خواهد بود.")</small></span>
                    </button>
                </div>
            </div>
            <footer class="mamoor-modal-footer">
                <button type="button" class="mamoor-button mamoor-button-light" @onclick="CloseEditor" disabled="@saving">انصراف</button>
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="SaveAsync" disabled="@saving">@(saving ? "در حال ذخیره..." : isEdit ? "ذخیره تغییرات" : "ثبت خودرو")</button>
            </footer>
        </section>
    </div>
}

@if (pendingDelete is not null)
{
    <div class="mamoor-modal-backdrop" @onclick="CancelDelete">
        <section class="mamoor-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl">
            <div class="mamoor-confirm-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 22 20H2L12 3Z"/><path d="M12 9v5m0 3h.01"/></svg></div>
            <h2>حذف خودرو</h2><p>آیا از حذف خودروی «<strong>@pendingDelete.KhodrooDS</strong>» مطمئن هستید؟ این عملیات قابل بازگشت نیست.</p>
            @if (!string.IsNullOrWhiteSpace(deleteError)) { <div class="mamoor-inline-error">@deleteError</div> }
            <div class="mamoor-modal-footer"><button type="button" class="mamoor-button mamoor-button-light" @onclick="CancelDelete" disabled="@deleting">انصراف</button><button type="button" class="mamoor-button mamoor-button-danger" @onclick="DeleteAsync" disabled="@deleting">@(deleting ? "در حال حذف..." : "بله، حذف شود")</button></div>
        </section>
    </div>
}

@if (showSuccessModal)
{
    <div class="mamoor-modal-backdrop success-backdrop"><section class="mamoor-confirm-modal success-modal" role="dialog" aria-modal="true" dir="rtl">
        <div class="mamoor-success-icon"><svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg></div>
        <h2>عملیات با موفقیت انجام شد</h2><p>@successMessage</p>
        <div class="mamoor-modal-footer"><button type="button" class="mamoor-button mamoor-button-primary" @onclick="ConfirmSuccessAndReload">تأیید</button></div>
    </section></div>
}

<style>
.success-backdrop{z-index:1200}.success-modal{text-align:center}.success-modal h2{margin:12px 0 8px}.success-modal p{line-height:1.9}.success-modal .mamoor-modal-footer{justify-content:center}.mamoor-success-icon{display:grid;place-items:center;width:58px;height:58px;margin:0 auto;border-radius:50%;background:#e7f7ed;color:#16834a}
.success-modal .mamoor-success-icon svg{width:31px;height:31px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
</style>

@code {
    private const string AllEndpoint = "api/v1/Khodroo/GetAllKhodroo";
    private const string CreateEndpoint = "api/v1/Khodroo/CreateKhodroo";
    private const string UpdateEndpoint = "api/v1/Khodroo/UpdateKhodroo";
    private const string DeleteEndpoint = "api/v1/Khodroo/DeleteKhodroo";
    private const string NoeKhodrooEndpoint = "api/v1/NoeKhodroo/GetNoeKhodrooByCombo";
    private const string NoeMalekiatEndpoint = "api/v1/NoeMalekiat/GetNoeMalekiatByCombo";
    private const string DriverEndpoint = "api/v1/Ranandeh/GetAllRanandeh";

    private readonly List<VehicleItem> items = [];
    private readonly List<LookupItem> noeKhodroos = [];
    private readonly List<LookupItem> noeMalekiat = [];
    private readonly List<LookupItem> drivers = [];
    private VehicleForm form = new();
    private VehicleItem? pendingDelete;
    private string searchText = "", noeKhodrooSearch = "", noeMalekiatSearch = "", driverSearch = "";
    private string? loadError, editorError, deleteError;
    private string successMessage = "";
    private bool loading, showEditor, isEdit, saving, deleting, showSuccessModal;
    private bool showNoeKhodrooOptions, showNoeMalekiatOptions, showDriverOptions;
    private decimal editingSN;

    private List<VehicleItem> FilteredItems => items.Where(x =>
        string.IsNullOrWhiteSpace(searchText) || Contains(x.KhodrooDS, searchText) || Contains(x.PelakNO, searchText) ||
        Contains(x.Model, searchText) || Contains(x.Rang, searchText) ||
        Contains(FindTitle(noeKhodroos, x.NoeKhodrooSN), searchText) ||
        Contains(FindTitle(drivers, x.RanandehSN), searchText) ||
        Contains(FindTitle(noeMalekiat, x.NoeMalekiatSN), searchText))
        .OrderBy(x => x.KhodrooDS).ToList();

    private List<LookupItem> FilteredNoeKhodroos => FilterLookup(noeKhodroos, noeKhodrooSearch);
    private List<LookupItem> FilteredNoeMalekiats => FilterLookup(noeMalekiat, noeMalekiatSearch);
    private List<LookupItem> FilteredDrivers => FilterLookup(drivers, driverSearch);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAllAsync(), LoadCombosAsync());
    }

    private async Task LoadAllAsync()
    {
        loading = true; loadError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            using var response = await client.GetAsync(AllEndpoint);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, "دریافت فهرست خودروها");
            items.Clear();
            items.AddRange(ReadArray(ExtractPayload(json)).Select(ReadVehicle).Where(x => x.KhodrooSN != 0));
        }
        catch (Exception ex) { loadError = DescribeError("دریافت فهرست خودروها", ex); }
        finally { loading = false; }
    }

    private async Task LoadCombosAsync()
    {
        // هر کمبو مستقل بارگذاری می‌شود؛ خطای یک endpoint نباید مانع نمایش دو کمبوی دیگر شود.
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            await LoadOneLookupAsync(client, NoeKhodrooEndpoint, "نوع خودرو",
                noeKhodroos, new[] { "NoeKhodrooSN", "NoeKhodrooId" },
                new[] { "NoeKhodrooDS", "NoeKhodrooName", "NoeKhodrooTitle" });
            await LoadOneLookupAsync(client, DriverEndpoint, "راننده",
                drivers, new[] { "RanandehSN", "RanandehId" },
                new[] { "RanandehDS", "RanandehName", "RanandehTitle" });
            await LoadOneLookupAsync(client, NoeMalekiatEndpoint, "نوع مالکیت",
                noeMalekiat, new[] { "NoeMalekiatSN", "NoeMalekiatId" },
                new[] { "NoeMalekiatDS", "NoeMalekiatName", "NoeMalekiatTitle" });
        }
        catch (Exception ex)
        {
            loadError = DescribeError("دریافت اطلاعات کمبوها", ex);
        }
    }

    private async Task LoadOneLookupAsync(HttpClient client, string endpoint, string name,
        List<LookupItem> destination, string[] idKeys, string[] titleKeys)
    {
        try
        {
            using var response = await client.GetAsync(endpoint);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, $"دریافت {name}");
            var rows = ReadArray(ExtractPayload(json));
            var parsed = rows.Select(x => new LookupItem
            {
                Id = ReadDecimal(x, new[] { "Id", "SN" }.Concat(idKeys).ToArray()),
                Title = ReadString(x, new[] { "Title", "Name", "DS" }.Concat(titleKeys).ToArray())
            }).Where(x => x.Id != 0 && !string.IsNullOrWhiteSpace(x.Title)).ToList();

            destination.Clear();
            destination.AddRange(parsed);
            if (parsed.Count == 0)
                loadError = (loadError is null ? "" : loadError + " ") +
                    $"پاسخ سرویس «{name}» دریافت شد، اما فیلد شناسه یا عنوان قابل تشخیص نبود.";
        }
        catch (Exception ex)
        {
            loadError = (loadError is null ? "" : loadError + " ") +
                $"کمبوی «{name}»: {DescribeError("دریافت " + name, ex)}";
        }
    }

    private void OpenCreate()
    {
        isEdit = false; editingSN = 0; editorError = null;
        form = new VehicleForm { KhodrooStatus = 1 };
        noeKhodrooSearch = ""; noeMalekiatSearch = ""; driverSearch = "";
        showNoeKhodrooOptions = showNoeMalekiatOptions = showDriverOptions = false;
        showEditor = true;
    }

    private void OpenEdit(VehicleItem item)
    {
        isEdit = true; editingSN = item.KhodrooSN; editorError = null;
        form = new VehicleForm
        {
            KhodrooDS = item.KhodrooDS, PelakNO = item.PelakNO, NoeKhodrooSN = item.NoeKhodrooSN,
            KhodrooStatus = item.KhodrooStatus, RanandehSN = item.RanandehSN, Model = item.Model,
            Rang = item.Rang, NoeMalekiatSN = item.NoeMalekiatSN
        };
        noeKhodrooSearch = FindTitle(noeKhodroos, form.NoeKhodrooSN) ?? "";
        driverSearch = FindTitle(drivers, form.RanandehSN) ?? "";
        noeMalekiatSearch = FindTitle(noeMalekiat, form.NoeMalekiatSN) ?? "";
        showNoeKhodrooOptions = showNoeMalekiatOptions = showDriverOptions = false;
        showEditor = true;
    }

    private void OnLookupInput(ChangeEventArgs e, int kind)
    {
        var value = e.Value?.ToString() ?? "";
        if (kind == 1) { noeKhodrooSearch = value; form.NoeKhodrooSN = 0; showNoeKhodrooOptions = true; }
        else if (kind == 2) { driverSearch = value; form.RanandehSN = 0; showDriverOptions = true; }
        else { noeMalekiatSearch = value; form.NoeMalekiatSN = 0; showNoeMalekiatOptions = true; }
    }

    private void SelectLookup(LookupItem item, int kind)
    {
        if (kind == 1) { form.NoeKhodrooSN = item.Id; noeKhodrooSearch = item.Title; showNoeKhodrooOptions = false; }
        else if (kind == 2) { form.RanandehSN = item.Id; driverSearch = item.Title; showDriverOptions = false; }
        else { form.NoeMalekiatSN = item.Id; noeMalekiatSearch = item.Title; showNoeMalekiatOptions = false; }
    }

    private async Task CloseLookupAsync(int kind)
    {
        await Task.Delay(180);
        if (kind == 1) showNoeKhodrooOptions = false;
        else if (kind == 2) showDriverOptions = false;
        else showNoeMalekiatOptions = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleStatus() => form.KhodrooStatus = form.KhodrooStatus == 1 ? (byte)0 : (byte)1;

    private async Task SaveAsync()
    {
        editorError = null;
        form.KhodrooDS = (form.KhodrooDS ?? "").Trim();
        form.PelakNO = (form.PelakNO ?? "").Trim();
        form.Model = (form.Model ?? "").Trim();
        form.Rang = (form.Rang ?? "").Trim();
        if (string.IsNullOrWhiteSpace(form.KhodrooDS)) { editorError = "نام خودرو را وارد کنید."; return; }
        if (string.IsNullOrWhiteSpace(form.PelakNO)) { editorError = "پلاک خودرو را وارد کنید."; return; }
        if (form.NoeKhodrooSN == 0) { editorError = "نوع خودرو را انتخاب کنید."; return; }
        if (form.RanandehSN == 0) { editorError = "راننده را انتخاب کنید."; return; }
        if (form.NoeMalekiatSN == 0) { editorError = "نوع مالکیت را انتخاب کنید."; return; }

        saving = true; await InvokeAsync(StateHasChanged); await Task.Yield();
        try
        {
            object payload = isEdit
                ? new
                {
                    KhodrooSN = editingSN,
                    KhodrooDS = form.KhodrooDS,
                    PelakNO = form.PelakNO,
                    NoeKhodrooSN = form.NoeKhodrooSN,
                    KhodrooStatus = form.KhodrooStatus,
                    RanandehSN = form.RanandehSN,
                    Model = NullIfEmpty(form.Model),
                    Rang = NullIfEmpty(form.Rang),
                    NoeMalekiatSN = form.NoeMalekiatSN
                }
                : new
                {
                    KhodrooDS = form.KhodrooDS,
                    PelakNO = form.PelakNO,
                    NoeKhodrooSN = form.NoeKhodrooSN,
                    KhodrooStatus = form.KhodrooStatus,
                    RanandehSN = form.RanandehSN,
                    Model = NullIfEmpty(form.Model),
                    Rang = NullIfEmpty(form.Rang),
                    NoeMalekiatSN = form.NoeMalekiatSN
                };
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            using var response = await client.PostAsJsonAsync(isEdit ? UpdateEndpoint : CreateEndpoint, payload);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, isEdit ? "ویرایش خودرو" : "ثبت خودرو");
            successMessage = isEdit ? $"خودروی «{form.KhodrooDS}» با موفقیت ویرایش شد." : $"خودروی «{form.KhodrooDS}» با موفقیت ثبت شد.";
            showEditor = false; showSuccessModal = true;
        }
        catch (Exception ex) { editorError = DescribeError(isEdit ? "ویرایش خودرو" : "ثبت خودرو", ex); }
        finally { saving = false; }
    }

    private void AskDelete(VehicleItem item) { pendingDelete = item; deleteError = null; }
    private void CancelDelete() { if (!deleting) pendingDelete = null; }

    private async Task DeleteAsync()
    {
        if (pendingDelete is null) return;
        deleting = true; deleteError = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var id = Uri.EscapeDataString(pendingDelete.KhodrooSN.ToString(CultureInfo.InvariantCulture));
            var url = $"{DeleteEndpoint}?KhodrooSN={id}";
            using var response = await client.PostAsync(url, content: null);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, "حذف خودرو");
            var name = pendingDelete.KhodrooDS; pendingDelete = null;
            successMessage = $"خودروی «{name}» با موفقیت حذف شد."; showSuccessModal = true;
        }
        catch (Exception ex) { deleteError = DescribeError("حذف خودرو", ex); }
        finally { deleting = false; }
    }

