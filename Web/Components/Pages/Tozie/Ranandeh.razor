@page "/tozie/ranandeh"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient

<PageTitle>مدیریت رانندگان | مینو زاگرس</PageTitle>
<div class="mamoor-page" dir="rtl">
<header class="mamoor-heading"><div><div class="mamoor-eyebrow">توزیع و حمل‌ونقل</div><h1>مدیریت رانندگان</h1><p>اطلاعات رانندگان را مشاهده، جستجو و مدیریت کنید.</p></div><div class="mamoor-heading-icon"><svg viewBox="0 0 24 24"><path d="M3 13h2l2-5h10l2 5h2v6h-2m-14 0H3v-6m4 6h10M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></div></header>
@if(!string.IsNullOrWhiteSpace(loadError)){<div class="mamoor-inline-error">@loadError</div>}
<section class="mamoor-panel">
<div class="mamoor-toolbar"><div class="mamoor-search-wrap"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input class="mamoor-search" placeholder="جستجو بر اساس نام یا کد راننده..." @bind="searchText" @bind:event="oninput"/></div><div class="mamoor-toolbar-actions"><span class="mamoor-count">@Filtered.Count راننده</span><button class="mamoor-button mamoor-button-light" title="بارگذاری مجدد" aria-label="بارگذاری مجدد" @onclick="LoadAllAsync" disabled="@loading"><svg class="mamoor-inline-icon" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M5.6 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.4-3"/></svg></button><button class="mamoor-button mamoor-button-primary" title="ثبت راننده" aria-label="ثبت راننده" @onclick="OpenCreate"><svg class="mamoor-inline-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button></div></div>
@if(loading){<div class="mamoor-empty"><span class="mamoor-spinner"></span><strong>در حال دریافت فهرست رانندگان...</strong></div>}
else if(items.Count==0){<div class="mamoor-empty"><strong>هنوز راننده‌ای ثبت نشده است</strong><span>برای شروع، اولین راننده را اضافه کنید.</span><button class="mamoor-button mamoor-button-primary" @onclick="OpenCreate">ثبت راننده</button></div>}
else if(Filtered.Count==0){<div class="mamoor-empty"><strong>نتیجه‌ای پیدا نشد</strong><span>عبارت جستجو را تغییر دهید.</span></div>}
else{<div class="mamoor-table-wrap"><table class="mamoor-table"><thead><tr><th>ردیف</th><th><button class="mamoor-sort-button" @onclick="()=>Sort(nameof(Driver.RanandehDS))">نام راننده <span>@Mark(nameof(Driver.RanandehDS))</span></button></th><th><button class="mamoor-sort-button" @onclick="()=>Sort(nameof(Driver.RanandehStatus))">وضعیت <span>@Mark(nameof(Driver.RanandehStatus))</span></button></th><th>عملیات</th></tr></thead><tbody>@foreach(var x in Filtered){<tr @key="x.RanandehSN"><td class="mamoor-row-number">@((Filtered.IndexOf(x)+1).ToString("00"))</td><td><strong class="mamoor-person-name">@Show(x.RanandehDS)</strong><small class="mamoor-subline">@(string.IsNullOrWhiteSpace(x.RanandehNO) ? "بدون کد ثبت‌شده" : $"کد: {x.RanandehNO}")</small></td><td><span class="mamoor-status @(x.RanandehStatus==1?"active":"inactive")"><i></i>@(x.RanandehStatus==1?"فعال":"غیرفعال")</span></td><td><div class="mamoor-row-actions"><button class="mamoor-icon-button edit" title="ویرایش" @onclick="()=>Edit(x)"><svg viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z"/></svg></button><button class="mamoor-icon-button delete" title="حذف" @onclick="()=>pendingDelete=x"><svg viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 14h10l1-14M9 7V4h6v3"/></svg></button></div></td></tr>}</tbody></table></div><div class="mamoor-table-footer"><span>نمایش @Filtered.Count از @items.Count راننده</span><span>اطلاعات از سامانه دریافت می‌شود</span></div>}
</section></div>
@if(editor){<div class="mamoor-modal-backdrop" @onclick="Close"><section class="mamoor-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl"><header class="mamoor-modal-header"><div class="mamoor-modal-title-icon">✎</div><div class="mamoor-modal-heading-copy"><span class="mamoor-modal-eyebrow">اطلاعات راننده</span><h2>@(editing?"ویرایش راننده":"ثبت راننده جدید")</h2><p>مشخصات راننده را تکمیل کنید.</p></div></header>@if(!string.IsNullOrWhiteSpace(error)){<div class="mamoor-inline-error">@error</div>}<div class="mamoor-form-grid"><label class="mamoor-field full">نام راننده <b>*</b><input @bind="form.RanandehDS" maxlength="150" placeholder="نام و نام خانوادگی راننده"/></label><label class="mamoor-field">کد راننده<input @bind="form.RanandehNO" maxlength="50" placeholder="کد راننده (اختیاری)"/></label><div class="mamoor-field mamoor-status-field"><span>وضعیت راننده</span><button type="button" class="mamoor-switch-row" role="switch" aria-checked="@(form.RanandehStatus==1)" @onclick="()=>form.RanandehStatus=form.RanandehStatus==1?(byte)0:(byte)1"><span class="mamoor-switch @(form.RanandehStatus==1?"on":"")"><i></i></span><span><strong>@(form.RanandehStatus==1?"فعال":"غیرفعال")</strong><small>وضعیت فعالیت راننده</small></span></button></div></div><footer class="mamoor-modal-footer"><button class="mamoor-button mamoor-button-light" @onclick="Close" disabled="@saving">انصراف</button><button class="mamoor-button mamoor-button-primary" @onclick="Save" disabled="@saving">@(saving?"در حال ذخیره...":editing?"ذخیره تغییرات":"ثبت راننده")</button></footer></section></div>}
@if(pendingDelete is not null){<div class="mamoor-modal-backdrop" @onclick="()=>pendingDelete=null"><section class="mamoor-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl"><div class="mamoor-confirm-icon">!</div><h2>حذف راننده</h2><p>آیا از حذف راننده «<strong>@pendingDelete.RanandehDS</strong>» مطمئن هستید؟</p>@if(!string.IsNullOrWhiteSpace(error)){<div class="mamoor-inline-error">@error</div>}<div class="mamoor-modal-footer"><button class="mamoor-button mamoor-button-light" @onclick="()=>pendingDelete=null" disabled="@saving">انصراف</button><button class="mamoor-button mamoor-button-danger" @onclick="Delete" disabled="@saving">@(saving?"در حال حذف...":"بله، حذف شود")</button></div></section></div>}
@if(success){<div class="mamoor-modal-backdrop success-backdrop"><section class="mamoor-confirm-modal success-modal" role="dialog" aria-modal="true" dir="rtl"><div class="mamoor-success-icon">✓</div><h2>عملیات با موفقیت انجام شد</h2><p>@successText</p><div class="mamoor-modal-footer"><button class="mamoor-button mamoor-button-primary" @onclick="Reload">تأیید</button></div></section></div>}
<style>.success-backdrop{z-index:1200}.success-modal{text-align:center}.success-modal h2{margin:12px 0 8px}.success-modal p{line-height:1.9}.success-modal .mamoor-modal-footer{justify-content:center}.mamoor-success-icon{display:grid;place-items:center;width:58px;height:58px;margin:0 auto;border-radius:50%;background:#e7f7ed;color:#16834a;font-size:30px;font-weight:700}</style>
@code {
 private const string All="api/v1/Ranandeh/GetAllRanandeh",CreateUrl="api/v1/Ranandeh/CreateRanandeh",UpdateUrl="api/v1/Ranandeh/UpdateRanandeh",DeleteUrl="api/v1/Ranandeh/DeleteRanandeh";
 private readonly List<Driver> items=[]; private DriverForm form=new(); private Driver? pendingDelete; private string searchText="",sortColumn=nameof(Driver.RanandehDS),successText=""; private bool ascending=true,loading,editor,editing,saving,success; private string? loadError,error; private decimal editId;
 private List<Driver> Filtered { get {var q=items.Where(x=>string.IsNullOrWhiteSpace(searchText)||Contains(x.RanandehDS,searchText)||Contains(x.RanandehNO,searchText));return sortColumn switch{nameof(Driver.RanandehNO)=>(ascending?q.OrderBy(x=>x.RanandehNO):q.OrderByDescending(x=>x.RanandehNO)).ToList(),nameof(Driver.RanandehStatus)=>(ascending?q.OrderBy(x=>x.RanandehStatus):q.OrderByDescending(x=>x.RanandehStatus)).ToList(),_=>(ascending?q.OrderBy(x=>x.RanandehDS):q.OrderByDescending(x=>x.RanandehDS)).ToList()};}}
 protected override Task OnInitializedAsync()=>LoadAllAsync();
 private async Task LoadAllAsync(){loading=true;loadError=null;try{using var c=await ApiClient.CreateAuthorizedClientAsync();using var r=await c.GetAsync(All);var j=await r.Content.ReadAsStringAsync();Check(r,j,"دریافت فهرست رانندگان");items.Clear();items.AddRange(ReadArray(ExtractPayload(j)).Select(Read).Where(x=>x.RanandehSN!=0));}catch(Exception e){loadError=DescribeError("دریافت فهرست رانندگان",e);}finally{loading=false;}}
 private void Sort(string c){if(sortColumn==c)ascending=!ascending;else{sortColumn=c;ascending=true;}} private string Mark(string c)=>sortColumn!=c?"↕":ascending?"↑":"↓";
 private void OpenCreate(){editing=false;editId=0;form=new(){RanandehStatus=1};error=null;editor=true;} private void Edit(Driver x){editing=true;editId=x.RanandehSN;form=new(){RanandehDS=x.RanandehDS,RanandehNO=x.RanandehNO,RanandehStatus=x.RanandehStatus};error=null;editor=true;} private void Close(){if(!saving)editor=false;}
 private async Task Save(){error=null;form.RanandehDS=(form.RanandehDS??"").Trim();form.RanandehNO=string.IsNullOrWhiteSpace(form.RanandehNO)?null:form.RanandehNO.Trim();if(string.IsNullOrWhiteSpace(form.RanandehDS)){error="نام راننده را وارد کنید.";return;}saving=true;try{object dto=editing?new{RanandehSN=editId,RanandehDS=form.RanandehDS,RanandehNO=form.RanandehNO,RanandehStatus=form.RanandehStatus}:new{RanandehDS=form.RanandehDS,RanandehNO=form.RanandehNO,RanandehStatus=form.RanandehStatus};using var c=await ApiClient.CreateAuthorizedClientAsync();using var r=await c.PostAsJsonAsync(editing?UpdateUrl:CreateUrl,dto);var j=await r.Content.ReadAsStringAsync();Check(r,j,editing?"ویرایش راننده":"ثبت راننده");editor=false;successText=editing?$"راننده «{form.RanandehDS}» ویرایش شد.":"راننده جدید با موفقیت ثبت شد.";success=true;}catch(Exception e){error=e.Message;}finally{saving=false;}}
 private async Task Delete(){if(pendingDelete is null)return;saving=true;error=null;try{using var c=await ApiClient.CreateAuthorizedClientAsync();var id=Uri.EscapeDataString(pendingDelete.RanandehSN.ToString(CultureInfo.InvariantCulture));using var r=await c.PostAsync($"{DeleteUrl}/{id}",null);var j=await r.Content.ReadAsStringAsync();Check(r,j,"حذف راننده");successText=$"راننده «{pendingDelete.RanandehDS}» با موفقیت حذف شد.";pendingDelete=null;success=true;}catch(Exception e){error=e.Message;}finally{saving=false;}}
 private async Task Reload(){success=false;searchText="";await LoadAllAsync();}
 private static Driver Read(JsonElement x)=>new(){RanandehSN=ReadDecimal(x,"RanandehSN","Id","SN"),RanandehDS=ReadString(x,"RanandehDS","Name","DS"),RanandehNO=ReadString(x,"RanandehNO","Code","NO"),RanandehStatus=(byte)Math.Clamp(ReadDecimal(x,"RanandehStatus","Status"),0,255)};
 private static JsonElement ExtractPayload(string json){using var doc=JsonDocument.Parse(json);return FindCollection(doc.RootElement.Clone(),0);}
 private static JsonElement FindCollection(JsonElement value,int depth){
  if(value.ValueKind==JsonValueKind.Array)return value;
  if(depth>7||value.ValueKind!=JsonValueKind.Object)return value;
  foreach(var key in new[]{"data","result","items","list","records","results","ranandehList"})
   if(Get(value,key,out var nested)){var found=FindCollection(nested,depth+1);if(found.ValueKind==JsonValueKind.Array||found.ValueKind==JsonValueKind.Object)return found;}
  foreach(var property in value.EnumerateObject()){var found=FindCollection(property.Value,depth+1);if(found.ValueKind==JsonValueKind.Array)return found;}
  return value;
 }
 private static List<JsonElement> ReadArray(JsonElement value)=>value.ValueKind==JsonValueKind.Array?value.EnumerateArray().Select(x=>x.Clone()).ToList():value.ValueKind==JsonValueKind.Object?new(){value.Clone()}:new();
 private static decimal ReadDecimal(JsonElement x,params string[] keys){
  foreach(var key in keys)if(Get(x,key,out var v)){
   if(v.ValueKind==JsonValueKind.Number&&v.TryGetDecimal(out var n))return n;
   if(v.ValueKind==JsonValueKind.String&&decimal.TryParse(Normalize(v.GetString()),NumberStyles.Any,CultureInfo.InvariantCulture,out n))return n;
  }return 0;
 }
 private static string ReadString(JsonElement x,params string[] keys){
  foreach(var key in keys)if(Get(x,key,out var v)){if(v.ValueKind==JsonValueKind.String)return v.GetString()??"";if(v.ValueKind==JsonValueKind.Number)return v.ToString();}
  return "";
 }
 private static string? Normalize(string? value)=>value?.Replace('۰','0').Replace('۱','1').Replace('۲','2').Replace('۳','3').Replace('۴','4').Replace('۵','5').Replace('۶','6').Replace('۷','7').Replace('۸','8').Replace('۹','9').Replace('٠','0').Replace('١','1').Replace('٢','2').Replace('٣','3').Replace('٤','4').Replace('٥','5').Replace('٦','6').Replace('٧','7').Replace('٨','8').Replace('٩','9');
 private static bool Get(JsonElement x,string k,out JsonElement v){if(x.ValueKind==JsonValueKind.Object)foreach(var p in x.EnumerateObject())if(p.Name.Equals(k,StringComparison.OrdinalIgnoreCase)){v=p.Value;return true;}v=default;return false;}
 private static bool Contains(string? a,string b)=>(a??"").Contains(b,StringComparison.OrdinalIgnoreCase);
 private static string Show(string? x)=>string.IsNullOrWhiteSpace(x)?"—":x;
 private static void Check(HttpResponseMessage r,string j,string operation){
  if(!r.IsSuccessStatusCode)throw new InvalidOperationException(ReadError(j,r));
  if(string.IsNullOrWhiteSpace(j))return;
  using var d=JsonDocument.Parse(j);var root=d.RootElement;
  if(Get(root,"statusCode",out var status)&&status.ValueKind==JsonValueKind.Number&&status.GetInt32()>=400)throw new InvalidOperationException(ReadError(j,r));
  if(Get(root,"success",out var success)&&success.ValueKind==JsonValueKind.False)throw new InvalidOperationException(ReadError(j,r));
  if(Get(root,"isSuccess",out var isSuccess)&&isSuccess.ValueKind==JsonValueKind.False)throw new InvalidOperationException(ReadError(j,r));
  if(Get(root,"errMsg",out var err)&&err.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(err.GetString()))throw new InvalidOperationException(err.GetString()!);
 }
 private static string ReadError(string j,HttpResponseMessage r){
  try{using var d=JsonDocument.Parse(j);var root=d.RootElement;
   if(Get(root,"errors",out var errors)&&errors.ValueKind==JsonValueKind.Object){
    var details=new List<string>();foreach(var p in errors.EnumerateObject()){
     var messages=p.Value.ValueKind==JsonValueKind.Array?p.Value.EnumerateArray().Where(x=>x.ValueKind==JsonValueKind.String).Select(x=>x.GetString()).Where(x=>!string.IsNullOrWhiteSpace(x)).ToList():p.Value.ValueKind==JsonValueKind.String?new List<string>{p.Value.GetString()!}:new List<string>();
     foreach(var message in messages)details.Add($"{p.Name}: {message}");
    }if(details.Count>0)return "اطلاعات ارسالی معتبر نیست:\n"+string.Join("\n",details);
   }
   foreach(var key in new[]{"message","errMsg","errorMessage","detail","title","error"})if(Get(root,key,out var v)&&v.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(v.GetString()))return v.GetString()!;
  }catch{}
  return string.IsNullOrWhiteSpace(j)?$"خطای HTTP {(int)r.StatusCode} ({r.ReasonPhrase})":j;
 }
 private static string DescribeError(string operation,Exception ex)=>ex is InvalidOperationException&&!string.IsNullOrWhiteSpace(ex.Message)?ex.Message:ex is UnauthorizedAccessException?"نشست کاربری معتبر نیست؛ دوباره وارد سامانه شوید.":ex is HttpRequestException?$"ارتباط با سرور هنگام {operation} برقرار نشد.":ex is OperationCanceledException?$"زمان انتظار برای {operation} به پایان رسید.":string.IsNullOrWhiteSpace(ex.Message)?$"در {operation} خطایی رخ داد.":ex.Message;
 private sealed class Driver{public decimal RanandehSN{get;set;}public string RanandehDS{get;set;}="";public string RanandehNO{get;set;}="";public byte RanandehStatus{get;set;}}
 private sealed class DriverForm{public string RanandehDS{get;set;}="";public string? RanandehNO{get;set;}public byte RanandehStatus{get;set;}=1;}
}