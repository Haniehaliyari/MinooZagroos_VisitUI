@page "/tozie/mamoor-pakhsh"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient

<PageTitle>مدیریت مأموران پخش | مینو زاگرس</PageTitle>

<div class="mamoor-page" dir="rtl">
    <header class="mamoor-heading">
        <div>
            <div class="mamoor-eyebrow">توزیع و پخش</div>
            <h1>مدیریت مأموران پخش</h1>
            <p>اطلاعات مأموران پخش را مشاهده، جستجو و مدیریت کنید.</p>
        </div>
        <div class="mamoor-heading-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM20 8v6m-3-3h6"/></svg>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(pageMessage))
    {
        <div class="mamoor-alert @(messageIsError ? "error" : "success")" role="status">
            <span>@pageMessage</span>
            <button type="button" @onclick="() => pageMessage = null" aria-label="بستن پیام">×</button>
        </div>
    }

    <section class="mamoor-panel">
        <div class="mamoor-toolbar">
            <div class="mamoor-search-wrap">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
                <input class="mamoor-search" placeholder="جستجو بر اساس نام، موبایل یا سرپرست..." @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="mamoor-toolbar-actions">
                <span class="mamoor-count">@FilteredItems.Count مأمور</span>
                <button type="button" class="mamoor-button mamoor-button-light" @onclick="LoadAllAsync" disabled="@loading">
                    <span>↻</span> @(loading ? "در حال دریافت..." : "به‌روزرسانی")
                </button>
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="OpenCreate">
                    <span>＋</span> مأمور جدید
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="mamoor-inline-error">@loadError</div>
        }

        @if (loading)
        {
            <div class="mamoor-empty"><span class="mamoor-spinner"></span><strong>در حال دریافت فهرست مأموران پخش...</strong></div>
        }
        else if (items.Count == 0)
        {
            <div class="mamoor-empty">
                <div class="mamoor-empty-icon">♙</div>
                <strong>هنوز مأمور پخشی ثبت نشده است</strong>
                <span>برای شروع، اولین مأمور پخش را اضافه کنید.</span>
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="OpenCreate">＋ ثبت مأمور پخش</button>
            </div>
        }
        else if (FilteredItems.Count == 0)
        {
            <div class="mamoor-empty"><strong>نتیجه‌ای پیدا نشد</strong><span>عبارت جستجو را تغییر دهید.</span></div>
        }
        else
        {
            <div class="mamoor-table-wrap">
                <table class="mamoor-table">
                    <thead>
                        <tr><th>ردیف</th><th>نام مأمور پخش</th><th>شماره موبایل</th><th>سرپرست پخش</th><th>واحد تجاری</th><th>وضعیت</th><th>عملیات</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredItems)
                        {
                            <tr @key="item.MamoorPakhshSN">
                                <td class="mamoor-row-number">@((FilteredItems.IndexOf(item) + 1).ToString("00"))</td>
                                <td><strong class="mamoor-person-name">@Display(item.MamoorPakhshDS)</strong><small class="mamoor-subline">@(string.IsNullOrWhiteSpace(item.MamoorPakhshNO) ? "بدون شماره ثبت‌شده" : $"کد: {item.MamoorPakhshNO}")</small></td>
                                <td class="mamoor-ltr">@Display(item.MblPhone)</td>
                                <td>@Display(item.SarparastTitle)</td>
                                <td>@Display(item.VahedeTitle)</td>
                                <td><span class="mamoor-status @(item.MamoorPakhshStatus == 1 ? "active" : "inactive")"><i></i>@(item.MamoorPakhshStatus == 1 ? "فعال" : "غیرفعال")</span></td>
                                <td>
                                    <div class="mamoor-row-actions">
                                        <button type="button" class="mamoor-icon-button edit" title="ویرایش" aria-label="ویرایش @item.MamoorPakhshDS" @onclick="() => OpenEditAsync(item)"><svg viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z"/></svg></button>
                                        <button type="button" class="mamoor-icon-button delete" title="حذف" aria-label="حذف @item.MamoorPakhshDS" @onclick="() => AskDelete(item)"><svg viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 14h10l1-14M9 7V4h6v3"/></svg></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mamoor-table-footer"><span>نمایش @FilteredItems.Count از @items.Count مأمور پخش</span><span>اطلاعات از سامانه دریافت می‌شود</span></div>
        }
    </section>
</div>

@if (showEditor)
{
    <div class="mamoor-modal-backdrop" @onclick="CloseEditor">
        <section class="mamoor-modal" role="dialog" aria-modal="true" aria-labelledby="mamoor-modal-title" @onclick:stopPropagation="true" dir="rtl">
            <header class="mamoor-modal-header">
                <div class="mamoor-modal-title-icon">@(isEdit ? "✎" : "＋")</div>
                <div><h2 id="mamoor-modal-title">@(isEdit ? "ویرایش مأمور پخش" : "ثبت مأمور پخش جدید")</h2><p>اطلاعات موردنیاز را در فرم زیر وارد کنید.</p></div>
                <button type="button" class="mamoor-modal-close" @onclick="CloseEditor" aria-label="بستن">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(editorError)) { <div class="mamoor-inline-error mamoor-modal-error">@editorError</div> }
            <div class="mamoor-form-grid">
                <label class="mamoor-field full">نام مأمور پخش <b>*</b>
                    <input @bind="form.MamoorPakhshDS" maxlength="150" placeholder="نام و نام خانوادگی مأمور را وارد کنید" />
                </label>

                <label class="mamoor-field lookup-field">واحد تجاری <b>*</b>
                    <input value="@vahedeSearch" @oninput="OnVahedeInput" @onfocus="() => showVahedeOptions = true" @onblur="CloseVahedeOptionsAsync" autocomplete="off" placeholder="جستجو و انتخاب واحد تجاری" />
                    @if (showVahedeOptions)
                    {
                        <div class="mamoor-options">
                            @if (FilteredVahedes.Count == 0) { <div class="mamoor-option-empty">واحدی پیدا نشد.</div> }
                            @foreach (var option in FilteredVahedes)
                            {
                                <button type="button" @key="option.Id" @onmousedown:preventDefault @onclick="() => SelectVahede(option)">@option.Title</button>
                            }
                        </div>
                    }
                </label>

                <label class="mamoor-field lookup-field">سرپرست پخش
                    <input value="@sarparastSearch" @oninput="OnSarparastInput" @onfocus="() => showSarparastOptions = true" @onblur="CloseSarparastOptionsAsync" autocomplete="off" placeholder="جستجو و انتخاب سرپرست" />
                    @if (showSarparastOptions)
                    {
                        <div class="mamoor-options">
                            @if (FilteredSarparasts.Count == 0) { <div class="mamoor-option-empty">سرپرستی پیدا نشد.</div> }
                            @foreach (var option in FilteredSarparasts)
                            {
                                <button type="button" @key="option.Id" @onmousedown:preventDefault @onclick="() => SelectSarparast(option)">@option.Title</button>
                            }
                        </div>
                    }
                </label>

                <label class="mamoor-field">شماره موبایل
                    <input @bind="form.MblPhone" inputmode="tel" maxlength="20" placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷" />
                </label>
                <label class="mamoor-field">نام کاربری عملیات
                    <input @bind="form.OptimeUserName" maxlength="100" placeholder="نام کاربری" />
                </label>
                <label class="mamoor-field">شماره تماس عملیات
                    <input @bind="form.OptimePhoneNumber" inputmode="tel" maxlength="20" placeholder="شماره تماس عملیات" />
                </label>

                <div class="mamoor-field mamoor-status-field">
                    <span>وضعیت مأمور پخش</span>
                    <button type="button" class="mamoor-switch-row" role="switch" aria-checked="@(form.MamoorPakhshStatus == 1)" @onclick="ToggleStatus">
                        <span class="mamoor-switch @(form.MamoorPakhshStatus == 1 ? "on" : "")"><i></i></span>
                        <span><strong>@(form.MamoorPakhshStatus == 1 ? "فعال" : "غیرفعال")</strong><small>@(form.MamoorPakhshStatus == 1 ? "این مأمور در فهرست انتخاب‌ها قابل استفاده است." : "این مأمور غیرفعال خواهد بود.")</small></span>
                    </button>
                </div>
            </div>
            <footer class="mamoor-modal-footer">
                <button type="button" class="mamoor-button mamoor-button-light" @onclick="CloseEditor" disabled="@saving">انصراف</button>
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="SaveAsync" disabled="@saving">@(saving ? "در حال ذخیره..." : isEdit ? "ذخیره تغییرات" : "ثبت مأمور پخش")</button>
            </footer>
        </section>
    </div>
}

@if (pendingDelete is not null)
{
    <div class="mamoor-modal-backdrop" @onclick="CancelDelete">
        <section class="mamoor-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl">
            <div class="mamoor-confirm-icon">!</div>
            <h2>حذف مأمور پخش</h2>
            <p>آیا از حذف مأمور «<strong>@pendingDelete.MamoorPakhshDS</strong>» مطمئن هستید؟ این عملیات قابل بازگشت نیست.</p>
            @if (!string.IsNullOrWhiteSpace(deleteError)) { <div class="mamoor-inline-error">@deleteError</div> }
            <div class="mamoor-modal-footer">
                <button type="button" class="mamoor-button mamoor-button-light" @onclick="CancelDelete" disabled="@deleting">انصراف</button>
                <button type="button" class="mamoor-button mamoor-button-danger" @onclick="DeleteAsync" disabled="@deleting">@(deleting ? "در حال حذف..." : "بله، حذف شود")</button>
            </div>
        </section>
    </div>
}

@code {
    private const string AllEndpoint = "api/v1/MamoorPakhsh/GetAllMamoorPakhsh";
    private const string ByIdEndpoint = "api/v1/MamoorPakhsh/GetMamoorPakhshByID";
    private const string CreateEndpoint = "api/v1/MamoorPakhsh/CreateMamoorPakhsh";
    private const string UpdateEndpoint = "api/v1/MamoorPakhsh/UpdateMamoorPakhsh";
    private const string DeleteEndpoint = "api/v1/MamoorPakhsh/DeleteMamoorPakhsh";
    private const string SarparastEndpoint = "api/v1/SarparastPakhsh/GetSarparastPakhshByCombo";
    private const string VahedeEndpoint = "api/v1/VahedeTejari/GetVahedeTejariByCombo";

    private readonly List<MamoorItem> items = [];
    private readonly List<LookupItem> sarparasts = [];
    private readonly List<LookupItem> vahedes = [];
    private MamoorForm form = new();
    private MamoorItem? pendingDelete;
    private string searchText = "", vahedeSearch = "", sarparastSearch = "";
    private string? loadError, pageMessage, editorError, deleteError;
    private bool messageIsError, loading, showEditor, isEdit, saving, deleting, showVahedeOptions, showSarparastOptions;
    private decimal editingSN;

    private List<MamoorItem> FilteredItems => items.Where(x =>
        string.IsNullOrWhiteSpace(searchText) ||
        Contains(x.MamoorPakhshDS, searchText) || Contains(x.MamoorPakhshNO, searchText) ||
        Contains(x.MblPhone, searchText) || Contains(x.SarparastTitle, searchText) ||
        Contains(x.VahedeTitle, searchText)).ToList();

    private List<LookupItem> FilteredVahedes => FilterLookup(vahedes, vahedeSearch);
    private List<LookupItem> FilteredSarparasts => FilterLookup(sarparasts, sarparastSearch);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAllAsync(), LoadCombosAsync());
    }

    private async Task LoadAllAsync()
    {
        loading = true; loadError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            using var response = await client.GetAsync(AllEndpoint);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, "دریافت فهرست مأموران پخش");
            items.Clear();
            items.AddRange(ReadArray(ExtractPayload(json)).Select(ReadMamoor).Where(x => x.MamoorPakhshSN != 0));
        }
        catch (Exception ex) { loadError = DescribeError("دریافت فهرست مأموران پخش", ex); }
        finally { loading = false; }
    }

    private async Task LoadCombosAsync()
    {
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var sarparastTask = ReadLookupAsync(client, SarparastEndpoint, "دریافت سرپرستان پخش");
            var vahedeTask = ReadLookupAsync(client, VahedeEndpoint, "دریافت واحدهای تجاری");
            await Task.WhenAll(sarparastTask, vahedeTask);
            sarparasts.Clear(); sarparasts.AddRange(await sarparastTask);
            vahedes.Clear(); vahedes.AddRange(await vahedeTask);
        }
        catch (Exception ex) { editorError = DescribeError("دریافت اطلاعات کمبوباکس‌ها", ex); }
    }

    private async Task<List<LookupItem>> ReadLookupAsync(HttpClient client, string endpoint, string operation)
    {
        using var response = await client.GetAsync(endpoint);
        var json = await response.Content.ReadAsStringAsync();
        EnsureSuccess(response, json, operation);
        return ReadArray(ExtractPayload(json)).Select(x => new LookupItem {
            Id = ReadDecimal(x, "Id", "SN", "SarparastPakhshSN", "VahedeTejariSN"),
            Title = ReadString(x, "Title", "Name", "DS", "SarparastPakhshDS", "VahedeTejariDS")
        }).Where(x => x.Id != 0 && !string.IsNullOrWhiteSpace(x.Title)).ToList();
    }

    private void OpenCreate()
    {
        isEdit = false; editingSN = 0; editorError = null;
        form = new MamoorForm { MamoorPakhshStatus = 1 };
        vahedeSearch = ""; sarparastSearch = "";
        showVahedeOptions = false; showSarparastOptions = false;
        showEditor = true;
        _ = EnsureCombosLoadedAsync();
    }

    private async Task EnsureCombosLoadedAsync()
    {
        if (vahedes.Count == 0 || sarparasts.Count == 0) await LoadCombosAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditAsync(MamoorItem item)
    {
        isEdit = true; editingSN = item.MamoorPakhshSN; editorError = null;
        showEditor = true;
        form = new MamoorForm();
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var url = $"{ByIdEndpoint}?MamoorPakhshSN={Uri.EscapeDataString(editingSN.ToString(CultureInfo.InvariantCulture))}";
            using var response = await client.GetAsync(url);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, "دریافت اطلاعات مأمور پخش");
            var data = ExtractPayload(json);
            if (data.ValueKind == JsonValueKind.Array && data.GetArrayLength() > 0) data = data[0];
            form = ReadForm(data);
            vahedeSearch = FindTitle(vahedes, form.VahedeTejariSN) ?? item.VahedeTitle;
            sarparastSearch = FindTitle(sarparasts, form.SarparastPakhshSN) ?? item.SarparastTitle;
        }
        catch (Exception ex) { editorError = DescribeError("دریافت اطلاعات مأمور پخش", ex); }
    }

    private async Task SaveAsync()
    {
        editorError = null;
        form.MamoorPakhshDS = form.MamoorPakhshDS.Trim();
        if (string.IsNullOrWhiteSpace(form.MamoorPakhshDS)) { editorError = "نام مأمور پخش را وارد کنید."; return; }
        if (form.VahedeTejariSN <= 0) { editorError = "واحد تجاری را انتخاب کنید."; return; }
        if (!vahedes.Any(x => x.Id == form.VahedeTejariSN)) { editorError = "واحد تجاری انتخاب‌شده معتبر نیست؛ دوباره انتخاب کنید."; return; }
        if (form.SarparastPakhshSN.HasValue && !sarparasts.Any(x => x.Id == form.SarparastPakhshSN.Value)) { editorError = "سرپرست انتخاب‌شده معتبر نیست؛ دوباره انتخاب کنید."; return; }

        saving = true;
        try
        {
            var payload = new {
                MamoorPakhshSN = isEdit ? editingSN : 0m,
                MamoorPakhshDS = form.MamoorPakhshDS,
                MamoorPakhshNO = isEdit ? items.FirstOrDefault(x => x.MamoorPakhshSN == editingSN)?.MamoorPakhshNO : null,
                MamoorPakhshStatus = form.MamoorPakhshStatus,
                SarparastPakhshSN = form.SarparastPakhshSN,
                VahedeTejariSN = form.VahedeTejariSN,
                TafsiliSN = (decimal?)null,
                TafsiliSN1 = (decimal?)null,
                PayeSN = (decimal?)null,
                UnqStr = (string?)null,
                MblPhone = NullIfEmpty(form.MblPhone),
                OptimeUserName = NullIfEmpty(form.OptimeUserName),
                OptimePhoneNumber = NullIfEmpty(form.OptimePhoneNumber)
            };
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            using var response = await client.PostAsJsonAsync(isEdit ? UpdateEndpoint : CreateEndpoint, payload);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, isEdit ? "ویرایش مأمور پخش" : "ثبت مأمور پخش");
            showEditor = false;
            pageMessage = isEdit ? "اطلاعات مأمور پخش با موفقیت به‌روزرسانی شد." : "مأمور پخش با موفقیت ثبت شد.";
            messageIsError = false;
            await LoadAllAsync();
        }
        catch (Exception ex) { editorError = DescribeError(isEdit ? "ویرایش مأمور پخش" : "ثبت مأمور پخش", ex); }
        finally { saving = false; }
    }

    private void AskDelete(MamoorItem item) { pendingDelete = item; deleteError = null; }
    private void CancelDelete() { if (!deleting) pendingDelete = null; }

    private async Task DeleteAsync()
    {
        if (pendingDelete is null) return;
        deleting = true; deleteError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var url = $"{DeleteEndpoint}?MamoorPakhshSN={Uri.EscapeDataString(pendingDelete.MamoorPakhshSN.ToString(CultureInfo.InvariantCulture))}";
            using var response = await client.PostAsync(url, content: null);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, "حذف مأمور پخش");
            pendingDelete = null;
            pageMessage = "مأمور پخش با موفقیت حذف شد."; messageIsError = false;
            await LoadAllAsync();
        }
        catch (Exception ex) { deleteError = DescribeError("حذف مأمور پخش", ex); }
        finally { deleting = false; }
    }

    private void CloseEditor() { if (!saving) showEditor = false; }
    private void ToggleStatus() => form.MamoorPakhshStatus = form.MamoorPakhshStatus == 1 ? (byte)0 : (byte)1;

    private void OnVahedeInput(ChangeEventArgs e) { vahedeSearch = e.Value?.ToString() ?? ""; form.VahedeTejariSN = 0; showVahedeOptions = true; }
    private void OnSarparastInput(ChangeEventArgs e) { sarparastSearch = e.Value?.ToString() ?? ""; form.SarparastPakhshSN = null; showSarparastOptions = true; }
    private void SelectVahede(LookupItem item) { form.VahedeTejariSN = item.Id; vahedeSearch = item.Title; showVahedeOptions = false; }
    private void SelectSarparast(LookupItem item) { form.SarparastPakhshSN = item.Id; sarparastSearch = item.Title; showSarparastOptions = false; }
    private async Task CloseVahedeOptionsAsync() { await Task.Delay(180); showVahedeOptions = false; await InvokeAsync(StateHasChanged); }
    private async Task CloseSarparastOptionsAsync() { await Task.Delay(180); showSarparastOptions = false; await InvokeAsync(StateHasChanged); }

    private static List<LookupItem> FilterLookup(IEnumerable<LookupItem> source, string term) =>
        source.Where(x => string.IsNullOrWhiteSpace(term) || Normalize(x.Title).Contains(Normalize(term), StringComparison.OrdinalIgnoreCase)).ToList();
    private static string? FindTitle(IEnumerable<LookupItem> source, decimal? id) => id.HasValue ? source.FirstOrDefault(x => x.Id == id.Value)?.Title : null;
    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
    private static bool Contains(string? source, string term) => Normalize(source).Contains(Normalize(term), StringComparison.OrdinalIgnoreCase);
    private static string Normalize(string? value) => (value ?? "").Trim()
        .Replace('۰','0').Replace('۱','1').Replace('۲','2').Replace('۳','3').Replace('۴','4').Replace('۵','5').Replace('۶','6').Replace('۷','7').Replace('۸','8').Replace('۹','9')
        .Replace('٠','0').Replace('١','1').Replace('٢','2').Replace('٣','3').Replace('٤','4').Replace('٥','5').Replace('٦','6').Replace('٧','7').Replace('٨','8').Replace('٩','9');

    private static MamoorItem ReadMamoor(JsonElement x) => new() {
        MamoorPakhshSN = ReadDecimal(x, "MamoorPakhshSN"),
        MamoorPakhshNO = ReadString(x, "MamoorPakhshNO"),
        MamoorPakhshDS = ReadString(x, "MamoorPakhshDS"),
        MamoorPakhshStatus = (byte)Math.Clamp(ReadDecimal(x, "MamoorPakhshStatus"), 0, 255),
        SarparastPakhshSN = ReadNullableDecimal(x, "SarparastPakhshSN"),
        VahedeTejariSN = ReadNullableDecimal(x, "VahedeTejariSN"),
        SarparastTitle = ReadString(x, "SarparastPakhshDS", "SarparastTitle", "SarparastName"),
        VahedeTitle = ReadString(x, "VahedeTejariDS", "VahedeTitle", "VahedeTejariName"),
        MblPhone = ReadString(x, "MblPhone")
    };

    private static MamoorForm ReadForm(JsonElement x) => new() {
        MamoorPakhshDS = ReadString(x, "MamoorPakhshDS"),
        MamoorPakhshStatus = (byte)Math.Clamp(ReadDecimal(x, "MamoorPakhshStatus"), 0, 1),
        SarparastPakhshSN = ReadNullableDecimal(x, "SarparastPakhshSN"),
        VahedeTejariSN = ReadDecimal(x, "VahedeTejariSN"),
        MblPhone = ReadString(x, "MblPhone"),
        OptimeUserName = ReadString(x, "OptimeUserName"),
        OptimePhoneNumber = ReadString(x, "OptimePhoneNumber")
    };

    private static JsonElement ExtractPayload(string json)
    {
        using var doc = JsonDocument.Parse(json);
        return FindCollection(doc.RootElement.Clone(), 0);
    }
    private static JsonElement FindCollection(JsonElement value, int depth)
    {
        if (value.ValueKind == JsonValueKind.Array) return value;
        if (depth > 7 || value.ValueKind != JsonValueKind.Object) return value;
        foreach (var key in new[] { "data", "result", "items", "list", "records", "results", "mamoorPakhshList" })
            if (TryGetProperty(value, key, out var nested)) { var found = FindCollection(nested, depth + 1); if (found.ValueKind == JsonValueKind.Array || found.ValueKind == JsonValueKind.Object) return found; }
        foreach (var property in value.EnumerateObject())
        { var found = FindCollection(property.Value, depth + 1); if (found.ValueKind == JsonValueKind.Array) return found; }
        return value;
    }
    private static IEnumerable<JsonElement> ReadArray(JsonElement value) => value.ValueKind == JsonValueKind.Array ? value.EnumerateArray().Select(x => x.Clone()).ToList() : value.ValueKind == JsonValueKind.Object ? new[] { value.Clone() } : [];
    private static decimal ReadDecimal(JsonElement x, params string[] keys)
    {
        foreach (var key in keys) if (TryGetProperty(x, key, out var v))
        { if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var n)) return n; if (v.ValueKind == JsonValueKind.String && decimal.TryParse(Normalize(v.GetString()), NumberStyles.Any, CultureInfo.InvariantCulture, out n)) return n; }
        return 0;
    }
    private static decimal? ReadNullableDecimal(JsonElement x, params string[] keys)
    {
        foreach (var key in keys) if (TryGetProperty(x, key, out var v))
        { if (v.ValueKind == JsonValueKind.Null) return null; if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var n)) return n; if (v.ValueKind == JsonValueKind.String && decimal.TryParse(Normalize(v.GetString()), NumberStyles.Any, CultureInfo.InvariantCulture, out n)) return n; }
        return null;
    }
    private static string ReadString(JsonElement x, params string[] keys)
    {
        foreach (var key in keys) if (TryGetProperty(x, key, out var v))
        { if (v.ValueKind == JsonValueKind.String) return v.GetString() ?? ""; if (v.ValueKind == JsonValueKind.Number) return v.ToString(); }
        return "";
    }
    private static bool TryGetProperty(JsonElement x, string key, out JsonElement value)
    {
        if (x.ValueKind == JsonValueKind.Object)
            foreach (var p in x.EnumerateObject()) if (string.Equals(p.Name, key, StringComparison.OrdinalIgnoreCase)) { value = p.Value; return true; }
        value = default; return false;
    }
    private static void EnsureSuccess(HttpResponseMessage response, string json, string operation)
    {
        if (!response.IsSuccessStatusCode) throw new InvalidOperationException(ReadError(json, response));
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;
        if (TryGetProperty(root, "statusCode", out var status) && status.ValueKind == JsonValueKind.Number && status.GetInt32() >= 400) throw new InvalidOperationException(ReadError(json, response));
        if (TryGetProperty(root, "success", out var success) && success.ValueKind == JsonValueKind.False) throw new InvalidOperationException(ReadError(json, response));
        if (TryGetProperty(root, "isSuccess", out var isSuccess) && isSuccess.ValueKind == JsonValueKind.False) throw new InvalidOperationException(ReadError(json, response));
        if (TryGetProperty(root, "errMsg", out var err) && err.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(err.GetString())) throw new InvalidOperationException(err.GetString()!);
    }
    private static string ReadError(string json, HttpResponseMessage response)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var key in new[] { "message", "errMsg", "errorMessage", "detail", "title", "error" })
                if (TryGetProperty(doc.RootElement, key, out var value) && value.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(value.GetString())) return value.GetString()!;
        }
        catch { }
        return string.IsNullOrWhiteSpace(json) ? $"خطای HTTP {(int)response.StatusCode} ({response.ReasonPhrase})" : json;
    }
    private static string DescribeError(string operation, Exception ex) => ex is InvalidOperationException && !string.IsNullOrWhiteSpace(ex.Message)
        ? ex.Message : ex is UnauthorizedAccessException ? "نشست کاربری معتبر نیست؛ دوباره وارد سامانه شوید."
        : ex is HttpRequestException ? $"ارتباط با سرور هنگام {operation} برقرار نشد."
        : ex is OperationCanceledException ? $"زمان انتظار برای {operation} به پایان رسید."
        : string.IsNullOrWhiteSpace(ex.Message) ? $"در {operation} خطایی رخ داد." : ex.Message;

