@page "/tozie/mamoor-pakhsh"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>مدیریت مأموران پخش | مینو زاگرس</PageTitle>

<div class="mamoor-page" dir="rtl">
    <header class="mamoor-heading">
        <div>
            <div class="mamoor-eyebrow">توزیع و پخش</div>
            <h1>مدیریت مأموران پخش</h1>
            <p>اطلاعات مأموران پخش را مشاهده، جستجو و مدیریت کنید.</p>
        </div>
        <div class="mamoor-heading-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM20 8v6m-3-3h6"/></svg>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(pageMessage))
    {
        <div class="mamoor-alert @(messageIsError ? "error" : "success")" role="status">
            <span>@pageMessage</span>
            <button type="button" @onclick="() => pageMessage = null" aria-label="بستن پیام"><svg class="mamoor-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
        </div>
    }

    <section class="mamoor-panel">
        <div class="mamoor-toolbar">
            <div class="mamoor-search-wrap">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
                <input class="mamoor-search" placeholder="جستجو بر اساس نام یا سرپرست..." @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="mamoor-toolbar-actions">
                <span class="mamoor-count">@FilteredItems.Count مأمور</span>
                <button type="button" class="mamoor-button mamoor-button-light" @onclick="LoadAllAsync" disabled="@loading">
                    <svg class="mamoor-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M5.6 9A7 7 0 0 1 18 6l2 6M4 12l2 6a7 7 0 0 0 12.4-3"/></svg> @(loading ? "در حال دریافت..." : "به‌روزرسانی")
                </button>
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="OpenCreate">
                    <svg class="mamoor-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> مأمور جدید
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="mamoor-inline-error">@loadError</div>
        }

        @if (loading)
        {
            <div class="mamoor-empty"><span class="mamoor-spinner"></span><strong>در حال دریافت فهرست مأموران پخش...</strong></div>
        }
        else if (items.Count == 0)
        {
            <div class="mamoor-empty">
                <div class="mamoor-empty-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></div>
                <strong>هنوز مأمور پخشی ثبت نشده است</strong>
                <span>برای شروع، اولین مأمور پخش را اضافه کنید.</span>
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="OpenCreate"><svg class="mamoor-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> ثبت مأمور پخش</button>
            </div>
        }
        else if (FilteredItems.Count == 0)
        {
            <div class="mamoor-empty"><strong>نتیجه‌ای پیدا نشد</strong><span>عبارت جستجو را تغییر دهید.</span></div>
        }
        else
        {
            <div class="mamoor-table-wrap">
                <table class="mamoor-table">
                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th><button type="button" class="mamoor-sort-button" @onclick="() => ToggleMamoorSort(nameof(MamoorItem.MamoorPakhshDS))">نام مأمور پخش <span>@MamoorSortIndicator(nameof(MamoorItem.MamoorPakhshDS))</span></button></th>
                            <th><button type="button" class="mamoor-sort-button" @onclick="() => ToggleMamoorSort(nameof(MamoorItem.SarparastTitle))">سرپرست پخش <span>@MamoorSortIndicator(nameof(MamoorItem.SarparastTitle))</span></button></th>
                            <th><button type="button" class="mamoor-sort-button" @onclick="() => ToggleMamoorSort(nameof(MamoorItem.MamoorPakhshStatus))">وضعیت <span>@MamoorSortIndicator(nameof(MamoorItem.MamoorPakhshStatus))</span></button></th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredItems)
                        {
                            <tr @key="item.MamoorPakhshSN">
                                <td class="mamoor-row-number">@((FilteredItems.IndexOf(item) + 1).ToString("00"))</td>
                                <td><strong class="mamoor-person-name">@Display(item.MamoorPakhshDS)</strong><small class="mamoor-subline">@(string.IsNullOrWhiteSpace(item.MamoorPakhshNO) ? "بدون شماره ثبت‌شده" : $"کد: {item.MamoorPakhshNO}")</small></td>
                                <td>@Display(item.SarparastTitle)</td>
                                <td><span class="mamoor-status @(item.MamoorPakhshStatus == 1 ? "active" : "inactive")"><i></i>@(item.MamoorPakhshStatus == 1 ? "فعال" : "غیرفعال")</span></td>
                                <td>
                                    <div class="mamoor-row-actions">
                                        <button type="button" class="mamoor-icon-button edit" title="ویرایش" aria-label="ویرایش @item.MamoorPakhshDS" @onclick="() => OpenEditAsync(item)"><svg viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z"/></svg></button>
                                        <button type="button" class="mamoor-icon-button delete" title="حذف" aria-label="حذف @item.MamoorPakhshDS" @onclick="() => AskDelete(item)"><svg viewBox="0 0 24 24"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 14h10l1-14M9 7V4h6v3"/></svg></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mamoor-table-footer"><span>نمایش @FilteredItems.Count از @items.Count مأمور پخش</span><span>اطلاعات از سامانه دریافت می‌شود</span></div>
        }
    </section>
</div>

@if (showEditor)
{
    <div class="mamoor-modal-backdrop" @onclick="CloseEditor">
        <section class="mamoor-modal" role="dialog" aria-modal="true" aria-labelledby="mamoor-modal-title" @onclick:stopPropagation="true" dir="rtl">
            <header class="mamoor-modal-header">
                <div class="mamoor-modal-title-icon"><svg viewBox="0 0 24 24" aria-hidden="true">@if (isEdit) { <path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z"/> } else { <path d="M12 5v14M5 12h14"/> }</svg></div>
                <div class="mamoor-modal-heading-copy"><span class="mamoor-modal-eyebrow">اطلاعات پرسنلی و سازمانی</span><h2 id="mamoor-modal-title">@(isEdit ? "ویرایش مأمور پخش" : "ثبت مأمور پخش جدید")</h2><p>مشخصات مأمور را با دقت تکمیل کنید تا در فرآیند توزیع قابل استفاده باشد.</p></div>
            </header>
            @if (!string.IsNullOrWhiteSpace(editorError)) { <div class="mamoor-inline-error mamoor-modal-error">@editorError</div> }
            <div class="mamoor-form-grid">
                <label class="mamoor-field full">نام مأمور پخش <b>*</b>
                    <input @bind="form.MamoorPakhshDS" @bind:event="oninput" maxlength="150" placeholder="نام و نام خانوادگی مأمور را وارد کنید" />
                </label>

                <label class="mamoor-field lookup-field">سرپرست پخش
                    <input value="@sarparastSearch" @oninput="OnSarparastInput" @onfocus="() => showSarparastOptions = true" @onblur="CloseSarparastOptionsAsync" autocomplete="off" placeholder="جستجو و انتخاب سرپرست" />
                    @if (showSarparastOptions)
                    {
                        <div class="mamoor-options">
                            @if (FilteredSarparasts.Count == 0) { <div class="mamoor-option-empty"><svg class="mamoor-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-8h.01"/></svg>اطلاعاتی در دسترس نیست</div> }
                            @foreach (var option in FilteredSarparasts)
                            {
                                <button type="button" @key="option.Id" @onmousedown:preventDefault @onclick="() => SelectSarparast(option)">@option.Title</button>
                            }
                        </div>
                    }
                </label>


                <div class="mamoor-field mamoor-status-field">
                    <span>وضعیت مأمور پخش</span>
                    <button type="button" class="mamoor-switch-row" role="switch" aria-checked="@(form.MamoorPakhshStatus == 1)" @onclick="ToggleStatus">
                        <span class="mamoor-switch @(form.MamoorPakhshStatus == 1 ? "on" : "")"><i></i></span>
                        <span><strong>@(form.MamoorPakhshStatus == 1 ? "فعال" : "غیرفعال")</strong><small>@(form.MamoorPakhshStatus == 1 ? "این مأمور در فهرست انتخاب‌ها قابل استفاده است." : "این مأمور غیرفعال خواهد بود.")</small></span>
                    </button>
                </div>
            </div>
            <footer class="mamoor-modal-footer">
                <button type="button" class="mamoor-button mamoor-button-light" @onclick="CloseEditor" disabled="@saving">انصراف</button>
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="SaveAsync" disabled="@saving">@(saving ? "در حال ذخیره..." : isEdit ? "ذخیره تغییرات" : "ثبت مأمور پخش")</button>
            </footer>
        </section>
    </div>
}

@if (showSuccessModal)
{
    <div class="mamoor-modal-backdrop success-backdrop">
        <section class="mamoor-confirm-modal success-modal" role="dialog" aria-modal="true" aria-labelledby="mamoor-success-title" dir="rtl">
            <div class="mamoor-success-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg></div>
            <h2 id="mamoor-success-title">عملیات با موفقیت انجام شد</h2>
            <p>@successMessage</p>
            <div class="mamoor-modal-footer">
                <button type="button" class="mamoor-button mamoor-button-primary" @onclick="ConfirmSuccessAndReload">تأیید</button>
            </div>
        </section>
    </div>
}

@if (pendingDelete is not null)
{
    <div class="mamoor-modal-backdrop" @onclick="CancelDelete">
        <section class="mamoor-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" dir="rtl">
            <div class="mamoor-confirm-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 22 20H2L12 3Z"/><path d="M12 9v5m0 3h.01"/></svg></div>
            <h2>حذف مأمور پخش</h2>
            <p>آیا از حذف مأمور «<strong>@pendingDelete.MamoorPakhshDS</strong>» مطمئن هستید؟ این عملیات قابل بازگشت نیست.</p>
            @if (!string.IsNullOrWhiteSpace(deleteError)) { <div class="mamoor-inline-error">@deleteError</div> }
            <div class="mamoor-modal-footer">
                <button type="button" class="mamoor-button mamoor-button-light" @onclick="CancelDelete" disabled="@deleting">انصراف</button>
                <button type="button" class="mamoor-button mamoor-button-danger" @onclick="DeleteAsync" disabled="@deleting">@(deleting ? "در حال حذف..." : "بله، حذف شود")</button>
            </div>
        </section>
    </div>
}

<style>
    .success-backdrop { z-index: 1200; }
    .success-modal { text-align: center; }
    .success-modal h2 { margin: 12px 0 8px; }
    .success-modal p { line-height: 1.9; margin: 0 0 18px; }
    .success-modal .mamoor-modal-footer { justify-content: center; }
    .mamoor-success-icon {
        display: grid; place-items: center; width: 58px; height: 58px; margin: 0 auto;
        border-radius: 50%; background: #e7f7ed; color: #16834a; font-size: 30px; font-weight: 700;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "create")]
    public bool CreateFromQuery { get; set; }

    private const string AllEndpoint = "api/v1/MamoorPakhsh/GetAllMamoorPakhsh";
    private const string ByIdEndpoint = "api/v1/MamoorPakhsh/GetMamoorPakhshByID";
    private const string CreateEndpoint = "api/v1/MamoorPakhsh/CreateMamoorPakhsh";
    private const string UpdateEndpoint = "api/v1/MamoorPakhsh/UpdateMamoorPakhsh";
    private const string DeleteEndpoint = "api/v1/MamoorPakhsh/DeleteMamoorPakhsh";
    private const string SarparastEndpoint = "api/v1/SarparastPakhsh/GetSarparastPakhshByCombo";
    private const decimal FixedVahedeTejariSN = 230034.935m;

    private readonly List<MamoorItem> items = [];
    private readonly List<LookupItem> sarparasts = [];
    private MamoorForm form = new();
    private MamoorItem? pendingDelete;
    private string searchText = "", sarparastSearch = "";
    private string? loadError, pageMessage, editorError, deleteError;
    private string? sarparastLookupMessage;
    private bool messageIsError, loading, showEditor, isEdit, saving, deleting, showSarparastOptions, showSuccessModal;
    private string successMessage = "";
    private decimal editingSN;

    private string mamoorSortColumn = nameof(MamoorItem.MamoorPakhshDS);
    private bool mamoorSortAscending = true;

    private List<MamoorItem> FilteredItems
    {
        get
        {
            var filtered = items.Where(x =>
                string.IsNullOrWhiteSpace(searchText) ||
                Contains(x.MamoorPakhshDS, searchText) || Contains(x.MamoorPakhshNO, searchText) ||
                Contains(x.SarparastTitle, searchText));

            return mamoorSortColumn switch
            {
                nameof(MamoorItem.SarparastTitle) => (mamoorSortAscending ? filtered.OrderBy(x => x.SarparastTitle) : filtered.OrderByDescending(x => x.SarparastTitle)).ToList(),
                nameof(MamoorItem.MamoorPakhshStatus) => (mamoorSortAscending ? filtered.OrderBy(x => x.MamoorPakhshStatus) : filtered.OrderByDescending(x => x.MamoorPakhshStatus)).ToList(),
                _ => (mamoorSortAscending ? filtered.OrderBy(x => x.MamoorPakhshDS) : filtered.OrderByDescending(x => x.MamoorPakhshDS)).ToList()
            };
        }
    }

    private void ToggleMamoorSort(string column)
    {
        if (mamoorSortColumn == column) mamoorSortAscending = !mamoorSortAscending;
        else { mamoorSortColumn = column; mamoorSortAscending = true; }
    }

    private string MamoorSortIndicator(string column) => mamoorSortColumn != column ? "↕" : mamoorSortAscending ? "↑" : "↓";

    private List<LookupItem> FilteredSarparasts => FilterLookup(sarparasts, sarparastSearch);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAllAsync(), LoadCombosAsync());
        if (CreateFromQuery) OpenCreate();
    }

    private async Task LoadAllAsync()
    {
        loading = true; loadError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            using var response = await client.GetAsync(AllEndpoint);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, "دریافت فهرست مأموران پخش");
            items.Clear();
            items.AddRange(ReadArray(ExtractPayload(json)).Select(ReadMamoor).Where(x => x.MamoorPakhshSN != 0));
        }
        catch (Exception ex) { loadError = DescribeError("دریافت فهرست مأموران پخش", ex); }
        finally { loading = false; }
    }

    private async Task LoadCombosAsync()
    {
        sarparastLookupMessage = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            sarparasts.Clear();
            sarparasts.AddRange(await ReadLookupAsync(client, SarparastEndpoint, "سرپرست"));
        }
        catch
        {
            sarparasts.Clear();
        }

        if (sarparasts.Count == 0) sarparastLookupMessage = "اطلاعات سرپرست پخش در دسترس نیست.";
    }

    private async Task<List<LookupItem>> ReadLookupAsync(HttpClient client, string endpoint, string lookupName)
    {
        try
        {
            using var response = await client.GetAsync(endpoint);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, $"دریافت {lookupName}");
            return ReadArray(ExtractPayload(json)).Select(x => new LookupItem {
                Id = ReadDecimal(x, "Id", "SN", "SarparastPakhshSN", "VahedeTejariSN", "SarparastSN", "VahedeSN"),
                Title = ReadString(x, "Title", "Name", "DS", "SarparastPakhshDS", "VahedeTejariDS", "SarparastDS", "VahedeDS")
            }).Where(x => x.Id != 0 && !string.IsNullOrWhiteSpace(x.Title)).ToList();
        }
        catch
        {
            // نبودن داده یا خطای سرویس کمبو نباید فرم اصلی را از کار بیندازد.
            return [];
        }
    }

    private void OpenCreate()
    {
        isEdit = false; editingSN = 0; editorError = null;
        form = new MamoorForm { MamoorPakhshStatus = 1, VahedeTejariSN = FixedVahedeTejariSN };
        sarparastSearch = "";
        showSarparastOptions = false;
        showEditor = true;
        _ = EnsureCombosLoadedAsync();
    }

    private async Task EnsureCombosLoadedAsync()
    {
        if (sarparasts.Count == 0)
        {
            try { await LoadCombosAsync(); }
            catch { /* وضعیت خالی کمبو در خود فهرست گزینه‌ها نمایش داده می‌شود. */ }
        }
        form.VahedeTejariSN = FixedVahedeTejariSN;
        await InvokeAsync(StateHasChanged);
    }

    private Task OpenEditAsync(MamoorItem item)
    {
        // اطلاعات سطر انتخاب‌شده مبنای فرم ویرایش است؛ فراخوانی GetByID که در API
        // برای بعضی رکوردهای موجود پاسخ «مأمورپخش یافت نشد» می‌داد حذف شده است.
        isEdit = true;
        editingSN = item.MamoorPakhshSN;
        editorError = null;
        form = new MamoorForm
        {
            MamoorPakhshDS = item.MamoorPakhshDS,
            MamoorPakhshStatus = item.MamoorPakhshStatus,
            SarparastPakhshSN = item.SarparastPakhshSN,
            VahedeTejariSN = FixedVahedeTejariSN,
            MblPhone = item.MblPhone,
            OptimeUserName = item.OptimeUserName,
            OptimePhoneNumber = item.OptimePhoneNumber
        };
        sarparastSearch = FindTitle(sarparasts, form.SarparastPakhshSN) ?? item.SarparastTitle;
        showSarparastOptions = false;
        showEditor = true;
        _ = EnsureCombosLoadedAsync();
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        editorError = null;
        form.MamoorPakhshDS = form.MamoorPakhshDS.Trim();
        if (string.IsNullOrWhiteSpace(form.MamoorPakhshDS)) { editorError = "نام مأمور پخش را وارد کنید."; return; }
        // شناسه واحد تجاری مستقل از داده‌های قبلی و کمبوهای API همیشه ثابت است.
        form.VahedeTejariSN = FixedVahedeTejariSN;
        if (form.SarparastPakhshSN.HasValue && sarparasts.Count > 0 && !sarparasts.Any(x => x.Id == form.SarparastPakhshSN.Value)) { editorError = "سرپرست انتخاب‌شده معتبر نیست؛ دوباره انتخاب کنید."; return; }

        saving = true;
        // وضعیت ارسال را پیش از شروع عملیات شبکه به رابط کاربری اعلام می‌کنیم.
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            object payload;

            if (isEdit)
            {
                // ویرایش: اطلاعات موردنیاز endpoint ویرایش مثل قبل ارسال می‌شود.
                payload = new
                {
                    MamoorPakhshSN = editingSN,
                    MamoorPakhshDS = form.MamoorPakhshDS,
                    MamoorPakhshNO = items.FirstOrDefault(x => x.MamoorPakhshSN == editingSN)?.MamoorPakhshNO,
                    MamoorPakhshStatus = form.MamoorPakhshStatus,
                    SarparastPakhshSN = form.SarparastPakhshSN,
                    VahedeTejariSN = FixedVahedeTejariSN,
                    TafsiliSN = (decimal?)null,
                    TafsiliSN1 = (decimal?)null,
                    PayeSN = (decimal?)null,
                    UnqStr = (string?)null,
                    MblPhone = NullIfEmpty(form.MblPhone),
                    OptimeUserName = NullIfEmpty(form.OptimeUserName),
                    OptimePhoneNumber = NullIfEmpty(form.OptimePhoneNumber)
                };
            }
            else
            {
                // ایجاد: فیلدهای سیستمی را سرویس بک‌اند تکمیل می‌کند.
                payload = new
                {
                    MamoorPakhshDS = form.MamoorPakhshDS,
                    MamoorPakhshStatus = form.MamoorPakhshStatus,
                    SarparastPakhshSN = form.SarparastPakhshSN
                };
            }
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            using var response = await client.PostAsJsonAsync(isEdit ? UpdateEndpoint : CreateEndpoint, payload);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, isEdit ? "ویرایش مأمور پخش" : "ثبت مأمور پخش");
            showEditor = false;
            successMessage = isEdit
                ? $"مأمور پخش «{form.MamoorPakhshDS}» با موفقیت ویرایش شد."
                : "مأمور پخش جدید با موفقیت افزوده شد.";
            showSuccessModal = true;
        }
        catch (Exception ex) { editorError = DescribeError(isEdit ? "ویرایش مأمور پخش" : "ثبت مأمور پخش", ex); }
        finally { saving = false; }
    }

    private async Task ConfirmSuccessAndReload()
    {
        showSuccessModal = false;
        successMessage = "";
        searchText = "";
        await LoadAllAsync();
    }

    private void AskDelete(MamoorItem item) { pendingDelete = item; deleteError = null; }
    private void CancelDelete() { if (!deleting) pendingDelete = null; }

    private async Task DeleteAsync()
    {
        if (pendingDelete is null) return;
        deleting = true; deleteError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var url = $"{DeleteEndpoint}?MamoorPakhshSN={Uri.EscapeDataString(pendingDelete.MamoorPakhshSN.ToString(CultureInfo.InvariantCulture))}";
            using var response = await client.PostAsync(url, content: null);
            var json = await response.Content.ReadAsStringAsync();
            EnsureSuccess(response, json, "حذف مأمور پخش");
            var deletedMamoorName = pendingDelete.MamoorPakhshDS;
            pendingDelete = null;
            successMessage = $"مأمور پخش «{deletedMamoorName}» با موفقیت حذف شد.";
            showSuccessModal = true;
        }
        catch (Exception ex) { deleteError = DescribeError("حذف مأمور پخش", ex); }
        finally { deleting = false; }
    }

