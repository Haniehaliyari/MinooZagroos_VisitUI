    private static string? FindTitle(IEnumerable<LookupItem> source, decimal? id) => id.HasValue ? source.FirstOrDefault(x => x.Id == id.Value)?.Title : null;
    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
