    private static JsonElement ExtractPayload(string json)
    {
        using var doc = JsonDocument.Parse(json);
        return FindCollection(doc.RootElement.Clone(), 0);
    }
    private static JsonElement FindCollection(JsonElement value, int depth)
    {
        if (value.ValueKind == JsonValueKind.Array) return value;
        if (depth > 7 || value.ValueKind != JsonValueKind.Object) return value;
        foreach (var key in new[] { "data", "result", "items", "list", "records", "results", "mamoorPakhshList" })
            if (TryGetProperty(value, key, out var nested)) { var found = FindCollection(nested, depth + 1); if (found.ValueKind == JsonValueKind.Array || found.ValueKind == JsonValueKind.Object) return found; }
        foreach (var property in value.EnumerateObject())
        { var found = FindCollection(property.Value, depth + 1); if (found.ValueKind == JsonValueKind.Array) return found; }
        return value;
    }
    private static IEnumerable<JsonElement> ReadArray(JsonElement value) => value.ValueKind == JsonValueKind.Array ? value.EnumerateArray().Select(x => x.Clone()).ToList() : value.ValueKind == JsonValueKind.Object ? new[] { value.Clone() } : [];
    private static decimal ReadDecimal(JsonElement x, params string[] keys)
    {
        foreach (var key in keys) if (TryGetProperty(x, key, out var v))
        { if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var n)) return n; if (v.ValueKind == JsonValueKind.String && decimal.TryParse(Normalize(v.GetString()), NumberStyles.Any, CultureInfo.InvariantCulture, out n)) return n; }
        return 0;
    }
    private static decimal? ReadNullableDecimal(JsonElement x, params string[] keys)
    {
        foreach (var key in keys) if (TryGetProperty(x, key, out var v))
        { if (v.ValueKind == JsonValueKind.Null) return null; if (v.ValueKind == JsonValueKind.Number && v.TryGetDecimal(out var n)) return n; if (v.ValueKind == JsonValueKind.String && decimal.TryParse(Normalize(v.GetString()), NumberStyles.Any, CultureInfo.InvariantCulture, out n)) return n; }
        return null;
    }
    private static string ReadString(JsonElement x, params string[] keys)
    {
        foreach (var key in keys) if (TryGetProperty(x, key, out var v))
        { if (v.ValueKind == JsonValueKind.String) return v.GetString() ?? ""; if (v.ValueKind == JsonValueKind.Number) return v.ToString(); }
        return "";
    }
    private static bool TryGetProperty(JsonElement x, string key, out JsonElement value)
    {
        if (x.ValueKind == JsonValueKind.Object)
            foreach (var p in x.EnumerateObject()) if (string.Equals(p.Name, key, StringComparison.OrdinalIgnoreCase)) { value = p.Value; return true; }
        value = default; return false;
    }
    private static void EnsureSuccess(HttpResponseMessage response, string json, string operation)
    {
        if (!response.IsSuccessStatusCode) throw new InvalidOperationException(ReadError(json, response));
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;
        if (TryGetProperty(root, "statusCode", out var status) && status.ValueKind == JsonValueKind.Number && status.GetInt32() >= 400) throw new InvalidOperationException(ReadError(json, response));
        if (TryGetProperty(root, "success", out var success) && success.ValueKind == JsonValueKind.False) throw new InvalidOperationException(ReadError(json, response));
        if (TryGetProperty(root, "isSuccess", out var isSuccess) && isSuccess.ValueKind == JsonValueKind.False) throw new InvalidOperationException(ReadError(json, response));
        if (TryGetProperty(root, "errMsg", out var err) && err.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(err.GetString())) throw new InvalidOperationException(err.GetString()!);
    }
    private static string ReadError(string json, HttpResponseMessage response)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            // پاسخ پیش‌فرض اعتبارسنجی ASP.NET معمولاً خطاها را داخل آبجکت errors برمی‌گرداند.
            if (TryGetProperty(root, "errors", out var errors) && errors.ValueKind == JsonValueKind.Object)
            {
                var details = new List<string>();
                foreach (var property in errors.EnumerateObject())
                {
                    var messages = property.Value.ValueKind == JsonValueKind.Array
                        ? property.Value.EnumerateArray()
                            .Where(x => x.ValueKind == JsonValueKind.String)
                            .Select(x => x.GetString())
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .ToList()
                        : property.Value.ValueKind == JsonValueKind.String
                            ? new List<string> { property.Value.GetString()! }
                            : new List<string>();

                    foreach (var message in messages)
                        details.Add($"{property.Name}: {message}");
                }

                if (details.Count > 0)
                    return "اطلاعات ارسالی معتبر نیست:\n" + string.Join("\n", details);
            }

            foreach (var key in new[] { "message", "errMsg", "errorMessage", "detail", "title", "error" })
                if (TryGetProperty(root, key, out var value) && value.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(value.GetString()))
                    return value.GetString()!;
        }
        catch { }

        return string.IsNullOrWhiteSpace(json)
            ? $"خطای HTTP {(int)response.StatusCode} ({response.ReasonPhrase})"
            : json;
    }
    private static string DescribeError(string operation, Exception ex) => ex is InvalidOperationException && !string.IsNullOrWhiteSpace(ex.Message)
        ? ex.Message : ex is UnauthorizedAccessException ? "نشست کاربری معتبر نیست؛ دوباره وارد سامانه شوید."
        : ex is HttpRequestException ? $"ارتباط با سرور هنگام {operation} برقرار نشد."
        : ex is OperationCanceledException ? $"زمان انتظار برای {operation} به پایان رسید."
        : string.IsNullOrWhiteSpace(ex.Message) ? $"در {operation} خطایی رخ داد." : ex.Message;

