@page "/tozie/havale/create"
@attribute [Authorize]
@layout MainLayout
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout
@using MyProject.Services.Api
@inject BackendApiClient ApiClient

<PageTitle>ایجاد حواله پخش | مینو زاگرس</PageTitle>
<div class="havale-page" dir="rtl">
    <div class="havale-page-heading">
        <div><div class="havale-eyebrow">توزیع و پخش</div><h1>ایجاد حواله پخش</h1><p>فاکتورهای تخصیص‌نیافته را انتخاب و اطلاعات ارسال را تکمیل کنید.</p></div>
        <div class="havale-heading-icon" aria-hidden="true">↗</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(successMessage)) { <div class="havale-alert havale-alert-success">@successMessage</div> }

    <section class="havale-panel">
        <div class="havale-section-heading">
            <div><span class="havale-step">۱</span><div><h2>انتخاب فاکتورها</h2><p>امکان انتخاب هم‌زمان چند فاکتور وجود دارد.</p></div></div>
            <button type="button" class="havale-button havale-button-light" @onclick="RefreshFactorsAsync" disabled="@loadingFactors">@(loadingFactors ? "در حال دریافت..." : "به‌روزرسانی فهرست")</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(factorError)) { <div class="havale-alert havale-alert-error"><strong>خطای دریافت فاکتورها:</strong> @factorError</div> }
        <div class="havale-toolbar">
            <input class="havale-search" placeholder="جستجو بر اساس شماره یا شرح فاکتور..." @bind="searchText" @bind:event="oninput" @bind:after="ApplyFactorSearch" />
            <div class="havale-selection-count">@SelectedCount فاکتور انتخاب شده</div>
        </div>
        <div class="havale-date-filter">
            <label>از تاریخ صدور
                <input type="text" inputmode="numeric" autocomplete="off" maxlength="10" placeholder="مثال : ۱۴۰۵/۰۸/۰۱" @bind="factorDateFromText" />
            </label>
            <label>تا تاریخ صدور
                <input type="text" inputmode="numeric" autocomplete="off" maxlength="10" placeholder="مثال : ۱۴۰۵/۰۸/۳۰" @bind="factorDateToText" />
            </label>
            <div class="havale-date-filter-actions">
                <button type="button" class="havale-button havale-button-primary" @onclick="ApplyFactorDateFilterAsync">اعمال فیلتر</button>
                <button type="button" class="havale-button havale-button-light" @onclick="ClearFactorDateFilterAsync">پاک کردن تاریخ</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(factorDateFilterError)) { <div class="havale-alert havale-alert-error">@factorDateFilterError</div> }
        @if (loadingFactors) { <div class="havale-empty">در حال دریافت فهرست فاکتورهای قابل حواله...</div> }
        else if (factors.Count == 0 && string.IsNullOrWhiteSpace(factorError)) { <div class="havale-empty">@(HasAppliedFactorDateFilter ? "در بازه تاریخی انتخاب‌شده هیچ فاکتوری وجود ندارد." : "در حال حاضر فاکتور تخصیص‌نیافته‌ای برای نمایش وجود ندارد.")</div> }
        else if (FilteredFactors.Count == 0 && factors.Count > 0) { <div class="havale-empty">فاکتوری با عبارت جستجو شده پیدا نشد.</div> }
        else if (factors.Count > 0)
        {
            <div class="havale-pagination-summary">
                <span>نمایش @PageStart تا @PageEnd از @FilteredFactors.Count فاکتور</span>
                <span>صفحه @currentFactorPage از @TotalFactorPages</span>
            </div>
            <div class="havale-table-wrap"><table class="havale-table">
                <thead><tr><th><input type="checkbox" checked="@AllCurrentPageSelected" @onchange="ToggleCurrentPageFactors" aria-label="انتخاب همه فاکتورهای این صفحه" /></th><th>شماره فاکتور</th><th>شرح فاکتور</th><th>تاریخ صدور</th><th>مبلغ کل</th></tr></thead>
                <tbody>@foreach (var factor in CurrentPageFactors) { <tr>
                    <td><input type="checkbox" checked="@selectedFactorSNs.Contains(factor.FactorSN)" @onchange="args => ToggleFactor(factor.FactorSN, args)" /></td>
                    <td class="havale-number">@factor.FactorNo</td><td>@(string.IsNullOrWhiteSpace(factor.FactorDs) ? "—" : factor.FactorDs)</td>
                    <td>@(string.IsNullOrWhiteSpace(factor.SodoorDate) ? "—" : factor.SodoorDate)</td><td class="havale-number">@(factor.MablaghKol?.ToString("N0") ?? "-")</td>
                </tr> }</tbody>
            </table></div>
            <nav class="havale-pagination" aria-label="صفحه‌بندی فاکتورها" dir="rtl">
                <button type="button" class="havale-page-button havale-page-arrow" @onclick="NextFactorPage" disabled="@(currentFactorPage >= TotalFactorPages)" aria-label="صفحه بعد">‹</button>
                @foreach (var pageNumber in VisibleFactorPages)
                {
                    <button @key="pageNumber" type="button" class="havale-page-button @(currentFactorPage == pageNumber ? "active" : "")" @onclick="() => GoToFactorPage(pageNumber)" aria-current="@(currentFactorPage == pageNumber ? "page" : null)">@pageNumber</button>
                }
                @if (ShowLastPageShortcut)
                {
                    <span class="havale-page-ellipsis" aria-hidden="true">…</span>
                    <button type="button" class="havale-page-button" @onclick="() => GoToFactorPage(TotalFactorPages)">@TotalFactorPages</button>
                }
                <button type="button" class="havale-page-button havale-page-arrow" @onclick="PreviousFactorPage" disabled="@(currentFactorPage <= 1)" aria-label="صفحه قبل">›</button>
            </nav>
        }
    </section>

    <section class="havale-panel">
        <div class="havale-section-heading">
            <div><span class="havale-step">۲</span><div><h2>اطلاعات حواله</h2><p>راننده، مأمور پخش و تاریخ‌های حواله را مشخص کنید.</p></div></div>
            <button type="button" class="havale-button havale-button-light" @onclick="LoadLookupsAsync" disabled="@loadingLookups">@(loadingLookups ? "در حال دریافت..." : "بارگذاری مجدد افراد")</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(driverError)) { <div class="havale-alert havale-alert-error"><strong>خطای دریافت راننده‌ها:</strong> @driverError</div> }
        @if (!string.IsNullOrWhiteSpace(agentError)) { <div class="havale-alert havale-alert-error"><strong>خطای دریافت مأموران پخش:</strong> @agentError</div> }
        <div class="havale-form-grid">
            <label>راننده
                <select @bind="selectedDriverSN" disabled="@loadingLookups"><option value="">@(loadingLookups ? "در حال دریافت راننده‌ها..." : "انتخاب راننده")</option>
                    @foreach (var item in drivers) { <option value="@item.Id.ToString(CultureInfo.InvariantCulture)">@(string.IsNullOrWhiteSpace(item.Code) ? item.Title : $"{item.Title} - {item.Code}")</option> }
                </select><small>@(drivers.Count == 0 && !loadingLookups ? "فهرست راننده‌ای دریافت نشده است." : $"{drivers.Count} راننده")</small>
            </label>
            <label>مأمور پخش
                <select @bind="selectedAgentSN" disabled="@loadingLookups"><option value="">@(loadingLookups ? "در حال دریافت مأموران..." : "انتخاب مأمور پخش")</option>
                    @foreach (var item in agents) { <option value="@item.Id.ToString(CultureInfo.InvariantCulture)">@item.Title</option> }
                </select><small>@(agents.Count == 0 && !loadingLookups ? "فهرست مأمور پخشی دریافت نشده است." : $"{agents.Count} مأمور پخش")</small>
            </label>
            <label>تاریخ حواله
                <input type="text" inputmode="numeric" autocomplete="off" placeholder="۱۴۰۵/۰۸/۲۵" maxlength="10" @bind="havaleDateText" />
                <small>فرمت شمسی: سال/ماه/روز</small>
            </label>
            <label>تاریخ ارسال
                <input type="text" inputmode="numeric" autocomplete="off" placeholder="۱۴۰۵/۰۸/۲۵" maxlength="10" @bind="sendDateText" />
                <small>فرمت شمسی: سال/ماه/روز</small>
            </label>
        </div>
        <div class="havale-date-note">تاریخ‌ها در زمان ارسال به فرمت شمسی مورد انتظار سرویس تبدیل می‌شوند.</div>
    </section>

    @if (!string.IsNullOrWhiteSpace(submitError)) { <div class="havale-alert havale-alert-error">@submitError</div> }
    <div class="havale-submit-row">
        <div class="havale-submit-summary"><strong>@SelectedCount</strong><span>فاکتور برای ثبت حواله انتخاب شده است</span></div>
        <button type="button" class="havale-button havale-button-primary" @onclick="CreateHavaleAsync" disabled="@(submitting || SelectedCount == 0 || string.IsNullOrWhiteSpace(selectedDriverSN) || string.IsNullOrWhiteSpace(selectedAgentSN))">@(submitting ? "در حال ثبت..." : "ثبت حواله")</button>
    </div>
</div>

@code {
    private const int FactorPageSize = 5;
    private int currentFactorPage = 1;
    private const byte DefaultServiceNo = 1;
    private const byte DefaultHavaleStatus = 1;
    private const string FactorsEndpoint = "api/v1/Factor/GetFactorByDate";
    private const string DriversEndpoint = "api/v1/Ranandeh/GetRanandehByCombo";
    private const string AgentsEndpoint = "api/v1/MamoorPakhsh/GetMamoorPakhshByCombo";
    private const string CreateEndpoint = "api/v1/Havale/CreateHavaleMamoorPakhsh";

    private readonly List<foFactorByDateDTO> factors = [];
    private List<foFactorByDateDTO> filteredFactors = [];
    private readonly List<LookupItem> drivers = [];
    private readonly List<LookupItem> agents = [];
    private readonly HashSet<decimal> selectedFactorSNs = [];
    private string searchText = "";
    private string factorDateFromText = "";
    private string factorDateToText = "";
    private string? factorDateFilterError;
    private string? selectedDriverSN, selectedAgentSN, factorError, driverError, agentError, submitError, successMessage;
    private string havaleDateText = TodayPersianDate();
    private string sendDateText = TodayPersianDate();
    private bool loadingFactors, loadingLookups, submitting;
    private string? appliedFactorDateFrom, appliedFactorDateTo;

    private bool HasAppliedFactorDateFilter => !string.IsNullOrWhiteSpace(appliedFactorDateFrom) || !string.IsNullOrWhiteSpace(appliedFactorDateTo);
    private int SelectedCount => selectedFactorSNs.Count;
    private List<foFactorByDateDTO> FilteredFactors => filteredFactors;
    private int TotalFactorPages => Math.Max(1, (int)Math.Ceiling(FilteredFactors.Count / (double)FactorPageSize));
    private IEnumerable<int> VisibleFactorPages => TotalFactorPages <= 4
        ? Enumerable.Range(1, TotalFactorPages)
        : currentFactorPage <= 2
            ? Enumerable.Range(1, 3)
            : currentFactorPage >= TotalFactorPages - 1
                ? Enumerable.Range(Math.Max(1, TotalFactorPages - 2), 3)
                : Enumerable.Range(currentFactorPage - 1, 3);
    private bool ShowLastPageShortcut => TotalFactorPages > 4 && currentFactorPage < TotalFactorPages - 1;
    private int PageStart => FilteredFactors.Count == 0 ? 0 : (currentFactorPage - 1) * FactorPageSize + 1;
    private int PageEnd => Math.Min(currentFactorPage * FactorPageSize, FilteredFactors.Count);
    private List<foFactorByDateDTO> CurrentPageFactors => FilteredFactors.Skip((currentFactorPage - 1) * FactorPageSize).Take(FactorPageSize).ToList();
    private bool AllCurrentPageSelected => CurrentPageFactors.Count > 0 && CurrentPageFactors.All(x => selectedFactorSNs.Contains(x.FactorSN));

    protected override async Task OnInitializedAsync() => await Task.WhenAll(LoadFactorsAsync(), LoadLookupsAsync());

    private async Task LoadFactorsAsync()
    {
        loadingFactors = true; factorError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var requestUrl = BuildFactorsRequestUrl(appliedFactorDateFrom, appliedFactorDateTo);
            using var response = await client.GetAsync(requestUrl);
            var json = await response.Content.ReadAsStringAsync();
            EnsureApiSuccess(response, json, "دریافت فاکتورها");
            var rawItems = ReadArray(ExtractPayload(json)).ToList();
            var items = rawItems.Select(ReadFactor).Where(x => x.FactorSN != 0).ToList();
            factors.Clear(); factors.AddRange(items);
            ApplyFactorSearch();
            currentFactorPage = 1;
            selectedFactorSNs.RemoveWhere(id => factors.All(x => x.FactorSN != id));
        }
        catch (Exception ex) { factors.Clear(); filteredFactors.Clear(); currentFactorPage = 1; factorError = DescribeRequestError("دریافت فاکتورها", ex); }
        finally { loadingFactors = false; }
    }

    private async Task LoadLookupsAsync()
    {
        loadingLookups = true; driverError = null; agentError = null;
        try
        {
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            var driverTask = ReadLookupRequestAsync(client, DriversEndpoint, true);
            var agentTask = ReadLookupRequestAsync(client, AgentsEndpoint, false);
            await Task.WhenAll(driverTask, agentTask);
            drivers.Clear(); drivers.AddRange(await driverTask);
            agents.Clear(); agents.AddRange(await agentTask);
            if (drivers.Count == 0 && driverError is null) driverError = "پاسخ موفق بود اما راننده‌ای در داده برگشتی پیدا نشد.";
            if (agents.Count == 0 && agentError is null) agentError = "پاسخ موفق بود اما مأمور پخشی در داده برگشتی پیدا نشد.";
        }
        catch (HttpRequestException)
        {
            driverError = "خطای ارتباط با سرور هنگام دریافت فهرست افراد؛ لطفاً اتصال خود را بررسی و دوباره تلاش کنید.";
            agentError = "خطای ارتباط با سرور هنگام دریافت فهرست افراد؛ لطفاً اتصال خود را بررسی و دوباره تلاش کنید.";
        }
        catch (OperationCanceledException)
        {
            driverError = "زمان انتظار برای دریافت فهرست راننده‌ها به پایان رسید. لطفاً دوباره تلاش کنید.";
            agentError = "زمان انتظار برای دریافت فهرست مأموران پخش به پایان رسید. لطفاً دوباره تلاش کنید.";
        }
        catch (UnauthorizedAccessException)
        {
            driverError = "نشست کاربری شما معتبر نیست. لطفاً دوباره وارد سامانه شوید.";
            agentError = "نشست کاربری شما معتبر نیست. لطفاً دوباره وارد سامانه شوید.";
        }
        catch (Exception)
        {
            driverError = "در دریافت فهرست راننده‌ها مشکلی رخ داد. لطفاً دوباره تلاش کنید.";
            agentError = "در دریافت فهرست مأموران پخش مشکلی رخ داد. لطفاً دوباره تلاش کنید.";
        }
        finally { loadingLookups = false; }
    }

    private async Task<List<LookupItem>> ReadLookupRequestAsync(HttpClient client, string endpoint, bool isDriver)
    {
        try
        {
            using var response = await client.GetAsync(endpoint);
            var json = await response.Content.ReadAsStringAsync();
            EnsureApiSuccess(response, json, isDriver ? "دریافت راننده‌ها" : "دریافت مأموران پخش");
            return ReadArray(ExtractPayload(json)).Select(ReadLookup).Where(x => x.Id != 0 && !string.IsNullOrWhiteSpace(x.Title)).ToList();
        }
        catch (Exception ex)
        {
            if (isDriver) driverError = DescribeRequestError(isDriver ? "دریافت راننده‌ها" : "دریافت مأموران پخش", ex);
            else agentError = DescribeRequestError(isDriver ? "دریافت راننده‌ها" : "دریافت مأموران پخش", ex);
            return [];
        }
    }

    private void ToggleFactor(decimal id, ChangeEventArgs args)
    {
        if (args.Value is bool isChecked && isChecked) selectedFactorSNs.Add(id);
        else selectedFactorSNs.Remove(id);
    }
    private void ToggleCurrentPageFactors(ChangeEventArgs args)
    {
        var check = args.Value is bool value && value;
        foreach (var factor in CurrentPageFactors)
        {
            if (check) selectedFactorSNs.Add(factor.FactorSN);
            else selectedFactorSNs.Remove(factor.FactorSN);
        }
    }

    // جستجوی شماره و شرح فاکتور در داده‌های دریافت‌شده محلی انجام می‌شود.
    // فیلتر تاریخ فقط از طریق API اعمال می‌شود تا همه رکوردهای بازه از سرور دریافت شوند.
    private void ApplyFactorSearch()
    {
        var term = searchText.Trim();
        filteredFactors = factors
            .Where(x => string.IsNullOrEmpty(term) ||
                x.FactorNo.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                x.FactorDs.Contains(term, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => NormalizeFactorDate(x.SodoorDate), StringComparer.Ordinal)
            .ToList();
        currentFactorPage = 1;
    }

    private async Task ApplyFactorDateFilterAsync()
    {
        factorDateFilterError = null;
        string? fromDate = null;
        string? toDate = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(factorDateFromText))
                fromDate = ParsePersianDate(factorDateFromText);
            if (!string.IsNullOrWhiteSpace(factorDateToText))
                toDate = ParsePersianDate(factorDateToText);
            if (fromDate is not null && toDate is not null && string.CompareOrdinal(fromDate, toDate) > 0)
                throw new FormatException("تاریخ شروع بازه نمی‌تواند بعد از تاریخ پایان باشد.");
        }
        catch (FormatException ex)
        {
            factorDateFilterError = ex.Message;
            return;
        }

        appliedFactorDateFrom = fromDate;
        appliedFactorDateTo = toDate;
        await LoadFactorsAsync();
    }

    private async Task ClearFactorDateFilterAsync()
    {
        factorDateFromText = "";
        factorDateToText = "";
        appliedFactorDateFrom = null;
        appliedFactorDateTo = null;
        factorDateFilterError = null;
        await LoadFactorsAsync();
    }

    private async Task RefreshFactorsAsync() => await LoadFactorsAsync();

    private static string BuildFactorsRequestUrl(string? dateFrom, string? dateTo)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(dateFrom))
            query.Add($"dateFrom={Uri.EscapeDataString(dateFrom)}");
        if (!string.IsNullOrWhiteSpace(dateTo))
            query.Add($"dateTo={Uri.EscapeDataString(dateTo)}");

        return query.Count == 0 ? FactorsEndpoint : $"{FactorsEndpoint}?{string.Join("&", query)}";
    }

    private static string NormalizeFactorDate(string? input)
    {
        var value = (input ?? "").Trim()
            .Replace('۰','0').Replace('۱','1').Replace('۲','2').Replace('۳','3').Replace('۴','4')
            .Replace('۵','5').Replace('۶','6').Replace('۷','7').Replace('۸','8').Replace('۹','9')
            .Replace('٠','0').Replace('١','1').Replace('٢','2').Replace('٣','3').Replace('٤','4')
            .Replace('٥','5').Replace('٦','6').Replace('٧','7').Replace('٨','8').Replace('٩','9');
        var digits = new string(value.Where(char.IsDigit).ToArray());
        return digits.Length == 8 ? digits : "";
    }
    private void GoToFactorPage(int page) => currentFactorPage = Math.Clamp(page, 1, TotalFactorPages);
    private void PreviousFactorPage() => GoToFactorPage(currentFactorPage - 1);
    private void NextFactorPage() => GoToFactorPage(currentFactorPage + 1);

    private async Task CreateHavaleAsync()
    {
        submitError = null; successMessage = null;
        if (SelectedCount == 0) { submitError = "حداقل یک فاکتور انتخاب کنید."; return; }
        try { _ = ParsePersianDate(havaleDateText); _ = ParsePersianDate(sendDateText); }
        catch (FormatException ex) { submitError = ex.Message; return; }
        if (!decimal.TryParse(selectedDriverSN, NumberStyles.Number, CultureInfo.InvariantCulture, out var driverSN)) { submitError = "راننده را انتخاب کنید."; return; }
        if (!decimal.TryParse(selectedAgentSN, NumberStyles.Number, CultureInfo.InvariantCulture, out var agentSN)) { submitError = "مأمور پخش را انتخاب کنید."; return; }
        submitting = true;
        try
        {
            var payload = new CreateHavaleRequest {
                FactorSNs = selectedFactorSNs.ToList(), RanandehSN = driverSN, MamoorPakhshSN = agentSN,
                HavaleMamoorPakhshDate = ParsePersianDate(havaleDateText), HavaleMamoorPakhshDateErsal = ParsePersianDate(sendDateText),
                ServiceNo = DefaultServiceNo, HavaleMamoorPakhshStatus = DefaultHavaleStatus
            };
            using var client = await ApiClient.CreateAuthorizedClientAsync();
            using var response = await client.PostAsJsonAsync(CreateEndpoint, payload);
            var json = await response.Content.ReadAsStringAsync();
            EnsureApiSuccess(response, json, "ثبت حواله");
            selectedFactorSNs.Clear();
            await LoadFactorsAsync();
            successMessage = "حواله با موفقیت ثبت شد.";
        }
        catch (Exception ex) { submitError = DescribeRequestError("ثبت حواله", ex); }
        finally { submitting = false; }
    }

    private static void EnsureApiSuccess(HttpResponseMessage response, string json, string operation)
    {
        if (!response.IsSuccessStatusCode) throw new InvalidOperationException($"{operation}: HTTP {(int)response.StatusCode} ({response.ReasonPhrase}). {ReadError(json)}");
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;
        if (TryGetProperty(root, "statusCode", out var status) && status.ValueKind == JsonValueKind.Number && status.GetInt32() >= 400)
            throw new InvalidOperationException($"{operation}: {ReadError(json)}");
        if (TryGetProperty(root, "errMsg", out var err) && err.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(err.GetString()))
            throw new InvalidOperationException($"{operation}: {err.GetString()}");
        if (TryGetProperty(root, "success", out var success) && success.ValueKind == JsonValueKind.False)
            throw new InvalidOperationException($"{operation}: {ReadError(json)}");
    }

    private static JsonElement ExtractPayload(string json)
    {
        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement.Clone();
        return FindCollection(root, 0);
    }

    // پاسخ‌های API ممکن است آرایه را داخل Data، Result یا یک شیء واسط برگردانند.
    private static JsonElement FindCollection(JsonElement value, int depth)
    {
        if (value.ValueKind == JsonValueKind.Array) return value;
        if (depth > 6 || value.ValueKind != JsonValueKind.Object) return value;
        foreach (var key in new[] { "data", "result", "items", "list", "records", "results", "factors", "factorList", "factorItems" })
            if (TryGetProperty(value, key, out var nested))
            {
                var found = FindCollection(nested, depth + 1);
                if (found.ValueKind == JsonValueKind.Array) return found;
            }
        foreach (var property in value.EnumerateObject())
        {
            var found = FindCollection(property.Value, depth + 1);
            if (found.ValueKind == JsonValueKind.Array) return found;
        }
        return value;
    }
    private static IEnumerable<JsonElement> ReadArray(JsonElement value)
    {
        if (value.ValueKind == JsonValueKind.Array) return value.EnumerateArray().Select(x => x.Clone()).ToList();
        if (value.ValueKind == JsonValueKind.Object) return new[] { value.Clone() };
        return [];
    }
    private static foFactorByDateDTO ReadFactor(JsonElement item) => new()
    {
        FactorSN = ReadDecimal(item, "FactorSN", "FactorSn", "factor_sn", "Factor_S_N", "Id", "SN"),
        FactorNo = ReadString(item, "FactorNo", "No", "FactorNumber"),
        FactorDs = ReadString(item, "FactorDs", "FactorDesc", "Description", "Title", "Name"),
        SodoorDate = ReadString(item, "SodoorDate", "FactorDate", "Date", "Tarikh"),
        MablaghKol = ReadNullableDecimal(item, "MablaghKol", "Mablagh", "TotalAmount", "Amount"),
        VahedeTejariSN = ReadNullableDecimal(item, "VahedeTejariSN")
    };
    private static LookupItem ReadLookup(JsonElement item) => new()
    {
        Id = ReadDecimal(item, "Id", "SN", "RanandehSN", "MamoorPakhshSN", "PersonSN", "Code"),
        Title = ReadString(item, "Title", "Name", "FullName", "PersonName", "RanandehName", "MamoorPakhshName", "Description", "Ds"),
        Code = ReadString(item, "Code")
    };
    private static decimal? ReadNullableDecimal(JsonElement item, params string[] names)
    {
        foreach (var name in names) if (TryGetProperty(item, name, out var value))
        {
            if (value.ValueKind == JsonValueKind.Number && value.TryGetDecimal(out var number)) return number;
            if (value.ValueKind == JsonValueKind.String && decimal.TryParse(value.GetString(), NumberStyles.Any, CultureInfo.InvariantCulture, out number)) return number;
            if (value.ValueKind == JsonValueKind.Null) return null;
        }
        return null;
    }

    private static decimal ReadDecimal(JsonElement item, params string[] names)
    {
        foreach (var name in names) if (TryGetProperty(item, name, out var value))
        {
            if (value.ValueKind == JsonValueKind.Number && value.TryGetDecimal(out var number)) return number;
            if (value.ValueKind == JsonValueKind.String && decimal.TryParse(value.GetString(), NumberStyles.Any, CultureInfo.InvariantCulture, out number)) return number;
        }
        return 0;
    }
    private static string ReadString(JsonElement item, params string[] names)
    {
        foreach (var name in names) if (TryGetProperty(item, name, out var value))
        {
            if (value.ValueKind == JsonValueKind.String) return value.GetString() ?? "";
            if (value.ValueKind == JsonValueKind.Number) return value.ToString();
        }
        return "";
    }
    private static bool TryGetProperty(JsonElement element, string name, out JsonElement value)
    {
        if (element.ValueKind == JsonValueKind.Object)
            foreach (var property in element.EnumerateObject())
                if (string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase)) { value = property.Value; return true; }
        value = default; return false;
    }
    private static string ReadError(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var key in new[] { "errMsg", "message", "Message", "title", "detail" })
                if (TryGetProperty(doc.RootElement, key, out var value) && value.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(value.GetString())) return value.GetString()!;
            if (TryGetProperty(doc.RootElement, "data", out var data) && data.ValueKind == JsonValueKind.String) return data.GetString()!;
        }
        catch { }
        return "پاسخ سرویس جزئیات خطا را ارسال نکرد.";
    }
    private static string DescribeRequestError(string operation, Exception ex)
    {
        if (ex is HttpRequestException)
            return $"خطای ارتباط با سرور هنگام {operation}؛ لطفاً اتصال خود به سرور را بررسی کنید و دوباره تلاش کنید.";

        if (ex is OperationCanceledException)
            return $"زمان انتظار برای {operation} به پایان رسید. لطفاً دوباره تلاش کنید.";

        if (ex is UnauthorizedAccessException)
            return "نشست کاربری شما معتبر نیست. لطفاً دوباره وارد سامانه شوید.";

        return $"در {operation} مشکلی رخ داد. لطفاً چند لحظه دیگر دوباره تلاش کنید.";
    }
    private static string TodayPersianDate()
    {
        var calendar = new PersianCalendar();
        var today = DateTime.Today;
        return $"{calendar.GetYear(today):0000}/{calendar.GetMonth(today):00}/{calendar.GetDayOfMonth(today):00}";
    }

    private static string ParsePersianDate(string? input)
    {
        var value = (input ?? "").Trim()
            .Replace('۰','0').Replace('۱','1').Replace('۲','2').Replace('۳','3').Replace('۴','4')
            .Replace('۵','5').Replace('۶','6').Replace('۷','7').Replace('۸','8').Replace('۹','9')
            .Replace('٠','0').Replace('١','1').Replace('٢','2').Replace('٣','3').Replace('٤','4')
            .Replace('٥','5').Replace('٦','6').Replace('٧','7').Replace('٨','8').Replace('٩','9');
        var parts = value.Split(new[] { '/', '-', '.', '\\' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length != 3 || !int.TryParse(parts[0], out var year) || !int.TryParse(parts[1], out var month) || !int.TryParse(parts[2], out var day))
            throw new FormatException("تاریخ را به شکل شمسی سال/ماه/روز وارد کنید؛ مثال: ۱۴۰۵/۰۸/۲۵.");
        try
        {
            var calendar = new PersianCalendar();
            _ = calendar.ToDateTime(year, month, day, 0, 0, 0, 0);
            return $"{year:0000}{month:00}{day:00}";
        }
        catch (ArgumentOutOfRangeException)
        {
            throw new FormatException("تاریخ شمسی واردشده معتبر نیست.");
        }
    }

