@page "/login"
@layout LoginLayout
@using Microsoft.JSInterop
@using Web.Components.Layout
@using Web.Models.Auth
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>ورود به سامانه | مینو زاگرس</PageTitle>

<main class="login-page" dir="rtl">
    <div class="depth-scene" aria-hidden="true">
        <div class="scene-photo"></div>
        <div class="scene-glow glow-a"></div>
        <div class="scene-glow glow-b"></div>
        <div class="scene-ring ring-a"></div>
        <div class="scene-ring ring-b"></div>
        <div class="scene-grid"></div>
        <div class="product-float product-float-water">
            <img src="https://minoozagros.com/wp-content/uploads/2023/08/P-14.png" alt="" />
        </div>
        <div class="product-float product-float-bisheh">
            <img src="https://minoozagros.com/wp-content/uploads/2023/08/P-15.png" alt="" />
        </div>
        <div class="product-float product-float-cola">
            <img src="https://minoozagros.com/wp-content/uploads/2023/08/P-8.png" alt="" />
        </div>
        <div class="product-float product-float-malt">
            <img src="https://minoozagros.com/wp-content/uploads/2023/08/P-3.png" alt="" />
        </div>
        <span class="scene-spark spark-a"></span>
        <span class="scene-spark spark-b"></span>
        <span class="scene-spark spark-c"></span>
    </div>

    <section class="login-card" aria-labelledby="login-title">
        <header class="card-brand">
            <span class="brand-symbol" aria-hidden="true">
                <svg viewBox="0 0 48 48"><path d="M24 4C18.5 14.2 10 23.1 10 31.2a14 14 0 0 0 28 0C38 23.1 29.5 14.2 24 4Z"/><path d="M15.5 31.5c4.8 3.4 12.2 3.4 17 0M19 25.5c3.1-2.5 6.9-2.5 10 0"/></svg>
            </span>
            <span class="brand-words">
                <strong>مینو زاگرس</strong>
                <small>طراوت زاگرس، جریان زندگی</small>
            </span>
        </header>

        <div class="card-divider"><span></span><small>سامانه سازمانی</small><span></span></div>

        <div class="login-intro">
            <span class="welcome-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48"><path d="M24 5C18.5 15 11 22.7 11 31a13 13 0 0 0 26 0C37 22.7 29.5 15 24 5Z"/><path d="M17 31c3.8 2.7 10.2 2.7 14 0"/></svg>
            </span>
            <span class="form-overline">خوش آمدید به خانواده مینو زاگرس</span>
            <h1 id="login-title">ورود به حساب کاربری</h1>
            <p class="form-description">برای ادامه فعالیت در سامانه، اطلاعات حساب خود را وارد کنید.</p>
        </div>

        <form class="login-form" @onsubmit="HandleLogin" @onsubmit:preventDefault>
            <div class="field-group">
                <label for="username">نام کاربری</label>
                <div class="input-shell">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.6-3.5 3-5.3 7-5.3s6.4 1.8 7 5.3"/></svg>
                    </span>
                    <input id="username" type="text" @bind="loginModel.Username" @bind:event="oninput"
                           placeholder="نام کاربری خود را وارد کنید" autocomplete="username" required disabled="@isLoading" />
                </div>
            </div>

            <div class="field-group">
                <label for="password">رمز عبور</label>
                <div class="input-shell">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2"/></svg>
                    </span>
                    <input id="password" type="@(showPassword ? "text" : "password")"
                           @bind="loginModel.Password" @bind:event="oninput"
                           placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" required disabled="@isLoading" />
                    <button class="password-toggle" type="button" @onclick="TogglePassword"
                            aria-label="@(showPassword ? "مخفی کردن رمز عبور" : "نمایش رمز عبور")" disabled="@isLoading">
                        @if (showPassword)
                        {
                            <svg viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5.2 0 8.5 5.2 8.5 7s-1.2 3.1-3.1 4.7M6.2 6.3C3.8 7.8 2.5 10.5 2.5 12c0 1.8 3.3 7 9.5 7 1 0 2-.2 2.8-.5"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"><path d="M2.5 12s3.3-7 9.5-7 9.5 7 9.5 7-3.3 7-9.5 7-9.5-7-9.5-7Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                        }
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="login-error" role="alert"><span class="error-symbol">!</span><span>@errorMessage</span></div>
            }

            <button class="submit-button" type="submit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="loading-spinner" aria-hidden="true"></span><span>در حال ورود به سامانه...</span>
                }
                else
                {
                    <span>ورود امن به سامانه</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
                }
            </button>
        </form>

        <div class="security-note">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 4.7-2.8 8-7 10-4.2-2-7-5.3-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
            <span>اطلاعات شما با اتصال امن سازمانی محافظت می‌شود.</span>
        </div>
        <footer class="card-footer"><span>© @DateTime.Now.Year مینو زاگرس</span><span>سامانه مدیریت فروش و ویزیت</span></footer>
    </section>

    <div class="scene-brandline" aria-hidden="true"><span>MINOO ZAGROS</span><i></i><span>KHORRAMABAD · IRAN</span></div>
</main>

@code {
    private LoginRequestDTO loginModel = new();
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;

    private void TogglePassword() => showPassword = !showPassword;

    private async Task HandleLogin()
    {
        if (isLoading)
            return;

        try
        {
            isLoading = true;
            errorMessage = null;
            await JSRuntime.InvokeAsync<bool>("authCookie.login", loginModel.Username, loginModel.Password);
            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (JSException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "در حال حاضر امکان ورود وجود ندارد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
