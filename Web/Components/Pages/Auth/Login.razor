@page "/login"
@layout LoginLayout
@using Microsoft.JSInterop
@using Web.Components.Layout
@using Web.Models.Auth
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>ورود به سامانه | مینو زاگرس</PageTitle>

<main class="mino-login @(isDarkTheme ? "theme-dark" : "theme-light")" dir="rtl">
    <div class="login-backdrop" aria-hidden="true">
        <div class="backdrop-shade"></div>
    </div>

    <header class="login-header">
        <a class="brand-lockup" href="https://minoozagros.com/" aria-label="وب‌سایت مینو زاگرس">
            <img src="https://minoozagros.com/wp-content/uploads/2026/01/logo-minoozagros.png" alt="لوگوی مینو زاگرس" />
            <span class="brand-divider"></span>
            <span class="brand-slogan"><strong>طراوت، سلامت، زندگی بهتر</strong><small>از دل زاگرس، برای تمام ایران</small></span>
        </a>
        <div class="header-actions">
            <button class="theme-toggle" type="button" @onclick="ToggleTheme" aria-label="@(isDarkTheme ? "فعال‌سازی حالت روشن" : "فعال‌سازی حالت تاریک")" title="@(isDarkTheme ? "حالت روشن" : "حالت تاریک")">
                @if (isDarkTheme)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"/></svg>
                }
            </button>
        </div>
    </header>

    <section class="login-layout" aria-label="ورود به سامانه">
        <div class="brand-showcase">
            <div class="showcase-copy">
                <span class="showcase-kicker">MINOO ZAGROS <i></i> ENTERPRISE PORTAL</span>
                <h2>یکپارچگی در کار،<br /><em>اعتماد در هر گام</em></h2>
                <p>درگاه یکپارچه مدیریت عملیات و ارتباطات سازمانی شرکت صنایع غذایی و آشامیدنی مینو زاگرس.</p>
            </div>
            <div class="enterprise-visual" aria-hidden="true">
                <div class="visual-orbit orbit-one"></div>
                <div class="visual-orbit orbit-two"></div>
                <div class="visual-core"><span class="core-mark">M</span><span class="core-caption">MINOO ZAGROS</span></div>
                <span class="visual-node node-one"></span><span class="visual-node node-two"></span><span class="visual-node node-three"></span>
                <span class="visual-line line-one"></span><span class="visual-line line-two"></span>
                <div class="visual-coordinate">33°29′ N&nbsp;&nbsp; 48°21′ E</div>
            </div>
            <div class="showcase-trust">
                <span><b>01</b> دسترسی متمرکز</span><i></i>
                <span><b>02</b> گردش کار یکپارچه</span><i></i>
                <span><b>03</b> امنیت سازمانی</span>
            </div>
        </div>

        <div class="login-card">
            <div class="card-brand-emblem">
                <img src="https://minoozagros.com/wp-content/uploads/2026/01/logo-minoozagros.png" alt="نشان مینو زاگرس" />
            </div>
            <div class="card-heading">
                <p class="eyebrow">خوش آمدید</p>
                <h1>ورود به سامانه</h1>
                <p class="intro-copy">به دنیای مینو زاگرس خوش آمدید</p>
            </div>

            <form class="login-form" @onsubmit="HandleLogin" @onsubmit:preventDefault>
                <div class="field-block">
                    <label for="username">نام کاربری</label>
                    <div class="field-control">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.6-3.5 3-5.3 7-5.3s6.4 1.8 7 5.3"/></svg>
                        <input id="username" type="text" @bind="loginModel.Username" @bind:event="oninput"
                               placeholder="نام کاربری خود را وارد کنید" autocomplete="username" required disabled="@isLoading" />
                    </div>
                </div>
                <div class="field-block">
                    <label for="password">رمز عبور</label>
                    <div class="field-control">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        <input id="password" type="@(showPassword ? "text" : "password")"
                               @bind="loginModel.Password" @bind:event="oninput"
                               placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" required disabled="@isLoading" />
                        <button class="reveal-button" type="button" @onclick="TogglePassword"
                                aria-label="@(showPassword ? "مخفی کردن رمز عبور" : "نمایش رمز عبور")" disabled="@isLoading">
                            @if (showPassword)
                            {
                                <svg viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.8 5.2A10 10 0 0 1 12 5c5.5 0 9 5.2 9 7a8.5 8.5 0 0 1-3.2 4.5M6.2 6.2C3.9 7.8 3 10.3 3 12c0 1.7 3.5 7 9 7 1 0 1.9-.2 2.8-.5"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24"><path d="M2.5 12s3.3-7 9.5-7 9.5 7 9.5 7-3.3 7-9.5 7-9.5-7-9.5-7Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                            }
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="form-error" role="alert"><span class="error-mark">!</span><span>@errorMessage</span></div>
                }
                <button class="login-submit" type="submit" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="submit-spinner" aria-hidden="true"></span><span>در حال بررسی اطلاعات...</span>
                    }
                    else
                    {
                        <span>ورود به سامانه</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                    }
                </button>
            </form>
            <div class="card-footnote"><span class="secure-icon">✓</span><span>دسترسی فقط برای کاربران مجاز سازمان امکان‌پذیر است.</span></div>
        </div>
    </section>

    <footer class="page-footer">
        <span>© @DateTime.Now.Year شرکت مینو زاگرس · تمامی حقوق محفوظ است.</span>
        <span class="footer-location">خرم‌آباد، لرستان</span>
    </footer>
</main>
@code {
    private LoginRequestDTO loginModel = new();
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;
    private bool isDarkTheme = true;
    private bool themeInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || themeInitialized)
            return;

        try
        {
            isDarkTheme = await JSRuntime.InvokeAsync<bool>("authCookie.getTheme");
        }
        catch (JSException)
        {
            isDarkTheme = true;
        }

        themeInitialized = true;
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        isDarkTheme = !isDarkTheme;
        await JSRuntime.InvokeVoidAsync("authCookie.setTheme", isDarkTheme ? "dark" : "light");
    }

    private void TogglePassword() => showPassword = !showPassword;

    private async Task HandleLogin()
    {
        if (isLoading)
            return;

        try
        {
            isLoading = true;
            errorMessage = null;

            var succeeded = await JSRuntime.InvokeAsync<bool>(
                "authCookie.login",
                loginModel.Username,
                loginModel.Password);

            if (!succeeded)
            {
                errorMessage = "ورود انجام نشد. لطفاً اطلاعات خود را بررسی کنید.";
                return;
            }

            Navigation.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (JSException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "در حال حاضر امکان ورود وجود ندارد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
