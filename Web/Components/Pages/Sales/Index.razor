@page "/foroosh"
@attribute [Authorize]
@layout MainLayout
@using Microsoft.AspNetCore.Authorization
@using Web.Components.Layout

<PageTitle>مینو زاگرس | سیستم فروش</PageTitle>
<div class="distribution-home" dir="rtl">
    <header class="distribution-heading">
        <span class="distribution-heading-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 5h18l-2 14H5zM3 5l2-2h14l2 2M9 9v6m6-6v6"/></svg>
        </span>
        <h1>سیستم فروش</h1>
    </header>
    <section class="distribution-grid" aria-label="امکانات سیستم فروش">
        <section class="distribution-card dispatch-card visitor-dispatch-card" aria-label="مدیریت ویزیتورها">
            <div class="dispatch-card-heading">
                <span class="distribution-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="18" cy="15" r="8"/><path d="M3 42c1-10 6-15 15-15s14 5 15 15M34 13h11M39.5 7.5v11"/></svg></span>
                <h2>ویزیتور</h2>
            </div>
            <div class="dispatch-card-divider"></div>
            <a class="dispatch-all-link" href="/foroosh/visitor">
                <span class="dispatch-all-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h13v16H7zM4 7v14h13M10 9h7M10 13h7M10 17h5"/></svg></span>
                <span>لیست ویزیتورها</span>
                <svg class="dispatch-link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        </section>
    </section>
</div>
